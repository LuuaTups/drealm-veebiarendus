---
// Interactive mock visual for each service (homepage tiles + service page heroes).
import Building from '../mock/Building.astro';
import Icon from '../mock/Icon.astro';

import type { Demo } from '../../data/v2/demos';

interface Props {
  id: string;
  lang?: 'et' | 'en';
  /** industry demo business for the website mock (solution pages); defaults to the restaurant */
  demo?: Demo;
}
const { id, lang = 'et', demo } = Astro.props;
const EN: Record<string, string> = {
  "Arvuti": "Desktop",
  "Mobiil": "Mobile",
  "Stiil": "Style",
  "Disaini vaated": "Design views",
  "Menüü": "Menu",
  "Broneeri": "Book",
  "Restoran · Kalamaja": "Restaurant · Kalamaja",
  "Põhjamaine köök, aeglaselt tehtud.": "Nordic food, made slowly.",
  "Broneeri laud": "Book a table",
  "Kuupäev": "Date",
  "R, 17. okt": "Fri, 17 Oct",
  "Kell": "Time",
  "Inimesi": "Guests",
  "Kinnita": "Confirm",
  "Esmane": "Primary",
  "Teisene": "Secondary",
  "Korruseplaan": "Floor plan",
  "hambaarst kesklinn": "dentist city centre",
  "Kesklinna Hambakliinik · Broneeri aeg": "City Dental Clinic · Book now",
  "Avatud täna 8–20": "Open today 8–20",
  "Hambaravi Tallinnas": "Dental care in Tallinn",
  "Hambaarstid kesklinnas": "Dentists in the centre",
  "Sponsitud": "Sponsored",
  "Osta nüüd": "Shop now",
  "Kuu kokkuvõte · näidis": "Monthly summary · example",
  "Reklaam A": "Ad A",
  "Reklaam B": "Ad B",
  "Reklaam C": "Ad C",
  "päringut · C peatatud, raha A-le": "enquiries · C paused, budget to A",
  "Sügisel −20%": "Autumn −20%",
  "Uus kollektsioon": "New collection",
  "Avatud uksed": "Open house",
  "Merevaade.": "Sea views.",
  "Valmib 2027.": "Ready in 2027.",
  "Broneeri nüüd.": "Book now.",
  "Stseen 1": "Scene 1",
  "Stseen 2": "Scene 2",
  "Stseen 3": "Scene 3",
  "Päring saabub": "Enquiry arrives",
  "„Soovime pakkumist fassaadile…“": "“We’d like a quote for a facade…”",
  "AI liigitab": "AI classifies",
  "Fassaad · ~420 m² · kõrge prioriteet": "Facade · ~420 m² · high priority",
  "Pakkumine": "Quote",
  "Mustand valmis": "Draft ready",
  "Kirje lisatud": "Record added",
  "Teavitus": "Alert",
  "Sinu telefoni": "To your phone",
  "AI igapäevatöös": "AI in daily work",
  "ChatGPT ja Claude: põhitõed": "ChatGPT and Claude: the basics",
  "Kirjad ja pakkumised 5 minutiga": "Emails and quotes in 5 minutes",
  "Tabelid ja raportid": "Spreadsheets and reports",
  "Oma töövoogude automatiseerimine": "Automating your own workflows",
  "Turvalisus ja andmed": "Security and data",
  "Koosta Kalaranna pakkumine eelmise malli põhjal.": "Draft the Kalaranna quote from last template.",
  "Hinnakiri_2026.xlsx": "Pricelist_2026.xlsx",
  "Pakkumine_Merivälja.pdf": "Quote_Merivalja.pdf",
  "Küsi midagi oma ettevõtte kohta…": "Ask anything about your company…",
  "Valmis. Kasutasin 2026. aasta hinnakirja ja eelmist pakkumist. Kas saadan Martinile üle vaatamiseks?": "Done. I used the 2026 price list and the previous quote. Shall I send it to Martin for review?",
  "Vaba": "Available",
  "Broneeritud": "Reserved",
  "Müüdud": "Sold"
};
const L = (s: string) => (lang === 'en' ? (EN[s] ?? s) : s);


const units = [
  { id: 'A1', rooms: 2, m2: '54,2', status: 'Vaba' },
  { id: 'A2', rooms: 3, m2: '78,6', status: 'Broneeritud' },
  { id: 'A3', rooms: 1, m2: '36,8', status: 'Vaba' },
  { id: 'A4', rooms: 4, m2: '96,1', status: 'Müüdud' },
];
const badge = (s: string) => (s === 'Vaba' ? 'free' : s === 'Müüdud' ? 'sold' : 'held');
const d: Demo = demo ?? {
  host: 'atelier-nord.ee',
  name: 'Atelier Nord',
  nav: [L('Menüü'), L('Broneeri')],
  tag: L('Restoran · Kalamaja'),
  title: L('Põhjamaine köök, aeglaselt tehtud.'),
  cta: L('Broneeri laud'),
  form: [[L('Kuupäev'), L('R, 17. okt')], [L('Kell'), '19:30'], [L('Inimesi'), '4']],
};
---

<div class="vis" aria-hidden="true" data-nosnippet>
  {
    id === 'veebilehed' && (
      <Fragment>
                <div class="seg" role="tablist" aria-label={L('Disaini vaated')}>
                  <button tabindex="-1" role="tab" aria-selected="true" data-view="desktop">{L('Arvuti')}</button>
                  <button tabindex="-1" role="tab" aria-selected="false" data-view="mobile">{L('Mobiil')}</button>
                  <button tabindex="-1" role="tab" aria-selected="false" data-view="system">{L('Stiil')}</button>
                </div>
                <div class="view is-active" data-view="desktop">
                  <div class="browser">
                    <div class="browser-bar"><i></i><i></i><i></i><span>{d.host}</span></div>
                    <div class="nord">
                      <div class="nord-nav"><b>{d.name}</b><span>{d.nav[0]}</span><span>{d.nav[1]}</span></div>
                      <div class="nord-hero">
                        <div><small>{d.tag}</small><p class="mh">{d.title}</p><span class="mini-btn">{d.cta}</span></div>
                        {demo ? <div class="demo-pic" aria-hidden="true"><i /><i /></div> : <div class="plate"><i></i><i></i><i></i></div>}
                      </div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="mobile">
                  <div class="phones">
                    <div class="phone sm">
                      <div class="nord-m"><b>{d.name}</b>{demo ? <div class="demo-pic sm" aria-hidden="true"><i /><i /></div> : <div class="plate sm"><i></i><i></i><i></i></div>}<p class="mh">{d.title}</p><span class="mini-btn">{d.cta}</span></div>
                    </div>
                    <div class="phone sm">
                      <div class="nord-m"><b>{d.cta}</b>{d.form.map(([k, v]) => <div class="field"><small>{k}</small>{v}</div>)}<span class="mini-btn full">{L('Kinnita')}</span></div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="system">
                  <div class="system">
                    <p class="sys-aa">Aa</p>
                    <div class="sys-sw"><span style="background:#1b0200"></span><span style="background:#4c0f05"></span><span style="background:#a21e02"></span><span style="background:#ce8c71"></span><span style="background:#e4ded3"></span></div>
                    <div class="sys-btns"><span class="mini-btn">{L('Esmane')}</span><span class="mini-btn ghost">{L('Teisene')}</span></div>
                  </div>
                </div>
      </Fragment>
    )
  }
  {
    id === 'platvormid' && (
      <Fragment>
                <div class="re">
                  <svg class="plan" viewBox="0 0 320 200" role="img" aria-label={L('Korruseplaan')}>
                    <rect x="6" y="6" width="308" height="188" rx="8" class="plan-outline" />
                    <g class="units">
                      <rect data-unit="A1" x="12" y="12" width="98" height="92" rx="6" />
                      <rect data-unit="A2" x="116" y="12" width="118" height="92" rx="6" />
                      <rect data-unit="A3" x="240" y="12" width="68" height="92" rx="6" />
                      <rect data-unit="A4" x="12" y="110" width="176" height="78" rx="6" />
                    </g>
                    <rect x="194" y="110" width="114" height="78" rx="6" class="core" />
                    <g class="labels"><text x="61" y="62">A1</text><text x="175" y="62">A2</text><text x="274" y="62">A3</text><text x="100" y="153">A4</text></g>
                  </svg>
                  <table class="units-table">
                    <tbody>
                      {
                        units.map((u) => (
                          <tr data-unit={u.id}>
                            <td>{u.id}</td>
                            <td>{u.rooms} {lang === 'en' ? 'rooms' : 'tuba'}</td>
                            <td>{u.m2} m²</td>
                            <td>
                              <span class:list={['badge', badge(u.status)]}>{L(u.status)}</span>
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
      </Fragment>
    )
  }
  {
    id === 'seo' && (
      <Fragment>
                <div class="serp">
                  <div class="serp-q"><Icon name="search" size={14} />{L('hambaarst kesklinn')}</div>
                  <div class="serp-r top">
                    <small>kesklinnahambakliinik.ee</small><b>{L('Kesklinna Hambakliinik · Broneeri aeg')}</b>
                    <span class="stars"><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /> {L('Avatud täna 8–20')}</span>
                  </div>
                  <div class="serp-r"><small>naidis.ee</small><b>{L('Hambaravi Tallinnas')}</b></div>
                  <div class="serp-r"><small>naidis2.ee</small><b>{L('Hambaarstid kesklinnas')}</b></div>
                  <svg class="spark-chart" viewBox="0 0 200 60" aria-hidden="true"><defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a21e02" stop-opacity=".28" /><stop offset="1" stop-color="#a21e02" stop-opacity="0" /></linearGradient></defs><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4 V60 H0Z" fill="url(#sg)" /><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4" class="line" /></svg>
                </div>
      </Fragment>
    )
  }
  {
    id === 'meta' && (
      <Fragment>
                <div class="meta">
                  <div class="phone xs">
                    <div class="ig">
                      <div class="ig-head"><i></i><div><b>savi.stuudio</b><small>{L('Sponsitud')}</small></div></div>
                      <div class="ig-media"><span class="vase"></span><span class="vase two"></span></div>
                      <div class="ig-cta">{L('Osta nüüd')} <Icon name="arrow" size={12} /></div>
                    </div>
                  </div>
                  <div class="report">
                    <small>{L('Kuu kokkuvõte · näidis')}</small>
                    <div class="rep-row"><span>{L('Reklaam A')}</span><i style="--w:84%"></i><b>21</b></div>
                    <div class="rep-row"><span>{L('Reklaam B')}</span><i style="--w:56%"></i><b>14</b></div>
                    <div class="rep-row off"><span>{L('Reklaam C')}</span><i style="--w:12%"></i><b>3</b></div>
                    <p>{L('päringut · C peatatud, raha A-le')}</p>
                  </div>
                </div>
      </Fragment>
    )
  }
  {
    id === 'reklaampildid' && (
      <Fragment>
                <div class="creatives">
                  <div class="cr sq"><small>1:1</small><b>{L('Sügisel −20%')}</b><em>savi.stuudio</em></div>
                  <div class="cr pt"><small>4:5</small><b>{L('Uus kollektsioon')}</b><em>Atelier Nord</em></div>
                  <div class="cr st"><small>9:16</small><b>{L('Avatud uksed')}</b><em>Kalaranna</em></div>
                </div>
      </Fragment>
    )
  }
  {
    id === 'video' && (
      <Fragment>
                <div class="video">
                  <div class="frame">
                    <div class="footage"><Building class="v-art" /></div>
                    <span class="rec"><i></i>AI · 0:15</span>
                    <p class="cap"><span>{L('Merevaade.')}</span><span>{L('Valmib 2027.')}</span><span>{L('Broneeri nüüd.')}</span></p>
                    <div class="scrub"><i></i></div>
                  </div>
                  <ul class="scenes"><li class="on">{L('Stseen 1')}</li><li>{L('Stseen 2')}</li><li>{L('Stseen 3')}</li><li>Logo</li></ul>
                </div>
      </Fragment>
    )
  }
  {
    id === 'automatiseerimine' && (
      <Fragment>
                <div class="flow" data-flow>
                  <div class="flow-step" data-step="0"><span class="ico"><Icon name="mail" size={18} /></span><div><strong>{L('Päring saabub')}</strong><small>{L('„Soovime pakkumist fassaadile…“')}</small></div></div>
                  <div class="flow-line"><i></i></div>
                  <div class="flow-step" data-step="1"><span class="ico"><Icon name="flow" size={18} /></span><div><strong>{L('AI liigitab')}</strong><small>{L('Fassaad · ~420 m² · kõrge prioriteet')}</small></div></div>
                  <div class="flow-line"><i></i></div>
                  <div class="flow-split">
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="doc" size={18} /></span><div><strong>{L('Pakkumine')}</strong><small>{L('Mustand valmis')}</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="stack" size={18} /></span><div><strong>CRM</strong><small>{L('Kirje lisatud')}</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="bell" size={18} /></span><div><strong>{L('Teavitus')}</strong><small>{L('Sinu telefoni')}</small></div></div>
                  </div>
                </div>
      </Fragment>
    )
  }
  {
    id === 'koolitused' && (
      <Fragment>
                <div class="course">
                  <div class="course-top"><b>{L('AI igapäevatöös')}</b><span>3 / 5</span></div>
                  <div class="bar"><i></i></div>
                  <ul>
                    <li class="done">{L('ChatGPT ja Claude: põhitõed')}</li>
                    <li class="done">{L('Kirjad ja pakkumised 5 minutiga')}</li>
                    <li class="done">{L('Tabelid ja raportid')}</li>
                    <li class="now">{L('Oma töövoogude automatiseerimine')}</li>
                    <li>{L('Turvalisus ja andmed')}</li>
                  </ul>
                </div>
      </Fragment>
    )
  }
  {
    id === 'ettevotte-ai' && (
      <Fragment>
                <div class="chat">
                  <div class="msg me">{L('Koosta Kalaranna pakkumine eelmise malli põhjal.')}</div>
                  <div class="msg ai">
                    <span class="ai-av">AI</span>
                    <div>
                      {L('Valmis. Kasutasin 2026. aasta hinnakirja ja eelmist pakkumist. Kas saadan Martinile üle vaatamiseks?')}
                      <div class="src"><span><Icon name="doc" size={12} />{L('Hinnakiri_2026.xlsx')}</span><span><Icon name="doc" size={12} />{L('Pakkumine_Merivälja.pdf')}</span></div>
                    </div>
                  </div>
                  <div class="chat-in"><span>{L('Küsi midagi oma ettevõtte kohta…')}</span><i><Icon name="up" size={16} /></i></div>
                </div>
      </Fragment>
    )
  }
</div>
