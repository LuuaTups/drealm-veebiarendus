---
import Logo from './Logo.astro';
import { GROUPS, SITE, UI, r } from '../data/site';
import { GROUP_ORDER, servicesByGroup, serviceUrl } from '../data/services';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
---

<footer class="footer section--dark">
  <div class="container">
    <div class="top">
      <div class="intro">
        <a href={r('home', lang)} aria-label="drealm"><Logo /></a>
        <p>{t.footerTagline}</p>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      {
        GROUP_ORDER.map((g) => (
          <div class="col">
            <p class="col-title">{GROUPS[g][lang].title}</p>
            <ul>
              {servicesByGroup(g).map((s) => (
                <li>
                  <a href={serviceUrl(s, lang)}>{s[lang].navLabel}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="bottom">
      <p>© {year} drealm · {SITE.city}, Eesti. {t.rights}</p>
      <nav aria-label="Footer">
        <a href={r('work', lang)}>{t.nav.work}</a>
        <a href={r('pricing', lang)}>{t.nav.pricing}</a>
        <a href={r('blog', lang)}>{t.nav.blog}</a>
        <a href={r('about', lang)}>{t.nav.about}</a>
        <a href={r('contact', lang)}>{t.nav.contact}</a>
        <a href={r('privacy', lang)}>{t.privacy}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(64px, 8vw, 110px) 0 32px;
  }
  .top {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 2.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--dark-soft);
  }
  .intro a {
    text-decoration: none;
  }
  .intro p {
    color: var(--on-dark-muted);
    margin: 1.2rem 0;
    max-width: 22rem;
  }
  .intro .mail {
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-decoration: underline;
    text-decoration-color: var(--clay);
  }
  .col-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a {
    display: block;
    padding: 0.3em 0;
    font-size: 0.93rem;
    text-decoration: none;
    color: var(--on-dark);
    opacity: 0.85;
  }
  li a:hover {
    opacity: 1;
    color: #fff;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.8rem;
    font-size: 0.85rem;
    color: var(--on-dark-muted);
  }
  .bottom p {
    margin: 0;
  }
  .bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .bottom a {
    text-decoration: none;
  }
  .bottom a:hover {
    color: var(--on-dark);
  }
  @media (max-width: 960px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .intro {
      grid-column: 1 / -1;
    }
  }
</style>
