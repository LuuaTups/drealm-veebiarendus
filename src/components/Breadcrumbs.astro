---
import { SITE } from '../data/site';

interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.name,
    item: new URL(it.href, SITE.url).href,
  })),
};
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {
      items.map((it, i) =>
        i < items.length - 1 ? (
          <li>
            <a href={it.href}>{it.name}</a>
          </li>
        ) : (
          <li aria-current="page">{it.name}</li>
        ),
      )
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
</style>
