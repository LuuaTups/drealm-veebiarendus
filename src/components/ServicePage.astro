---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Process from './Process.astro';
import Faq from './Faq.astro';
import ServiceGrid from './ServiceGrid.astro';
import CtaSection from './CtaSection.astro';
import { SITE, UI, r } from '../data/site';
import { getService, serviceUrl } from '../data/services';
import type { Lang, Service } from '../data/types';

interface Props {
  service: Service;
  lang: Lang;
}
const { service, lang } = Astro.props;
const c = service[lang];
const t = UI[lang];
const url = new URL(serviceUrl(service, lang), SITE.url).href;
const related = service.related.map(getService).filter((s): s is Service => Boolean(s));
const paragraphs = c.body.split(/\n\n+/);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: c.navLabel,
    serviceType: c.navLabel,
    description: c.metaDescription,
    url,
    provider: { '@id': `${SITE.url}/#org` },
    areaServed: { '@type': 'Country', name: 'Estonia' },
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  alternates={{ et: serviceUrl(service, 'et'), en: serviceUrl(service, 'en') }}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: t.breadcrumbHome, href: r('home', lang) },
          { name: t.nav.services, href: r('services', lang) },
          { name: c.navLabel, href: serviceUrl(service, lang) },
        ]}
      />
      <div class="hero-grid">
        <div>
          <p class="eyebrow">{c.eyebrow}</p>
          <h1>{c.h1}</h1>
        </div>
        <div class="hero-side">
          <p class="lead">{c.lead}</p>
          <dl class="facts">
            <div>
              <dt>{t.priceFrom}</dt>
              <dd>{c.priceFrom}</dd>
            </div>
            <div>
              <dt>{t.timeline}</dt>
              <dd>{c.timeline}</dd>
            </div>
          </dl>
          <div class="btn-row">
            <a class="btn btn--primary" href="#paring">{t.cta} <span class="arrow">→</span></a>
            <a class="btn btn--ghost" href={r('work', lang)}>{t.seeWork}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <h2 class="reveal">{c.problemsTitle}</h2>
      <ul class="problems reveal">
        {c.problems.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2>{c.deliverablesTitle}</h2>
      </div>
      <ul class="deliverables">
        {
          c.deliverables.map((d, i) => (
            <li class="reveal" style={`transition-delay:${(i % 3) * 70}ms`}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <h2 class="reveal">{c.bodyTitle}</h2>
      <div class="prose reveal">
        {paragraphs.map((p) => <p>{p}</p>)}
        <p class="price-note"><strong>{c.priceFrom}.</strong> {c.priceNote}</p>
      </div>
    </div>
  </section>

  <Process lang={lang} />

  <Faq title={t.faq} items={c.faqs} />

  {
    related.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <div class="section-head reveal">
            <h2>{t.related}</h2>
          </div>
          <ServiceGrid lang={lang} items={related} />
        </div>
      </section>
    )
  }

  <CtaSection lang={lang} preselect={service.id} />
</Base>

<style>
  .hero {
    padding: clamp(32px, 5vw, 56px) 0 clamp(64px, 9vw, 120px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: end;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 5.4vw, 4.6rem);
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 2rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts div {
    padding: 1rem 0;
  }
  .facts div + div {
    padding-left: 1.2rem;
    border-left: 1px solid var(--line);
  }
  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .split {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .problems {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .problems li {
    position: relative;
    padding: 1.1rem 0 1.1rem 2.2rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.08rem;
  }
  .problems li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.65rem;
    width: 14px;
    height: 1.5px;
    background: var(--clay);
  }
  .deliverables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 2rem;
  }
  .deliverables li {
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
  }
  .idx {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--clay);
    margin-bottom: 1rem;
  }
  .deliverables h3 {
    margin-bottom: 0.6rem;
  }
  .deliverables p {
    color: var(--muted);
    margin: 0;
  }
  .price-note {
    margin-top: 2rem;
    padding: 1.2rem 1.4rem;
    background: var(--surface);
    border-radius: var(--radius);
    font-size: 1rem;
  }
  @media (max-width: 900px) {
    .hero-grid,
    .split {
      grid-template-columns: 1fr;
    }
    .deliverables {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .deliverables {
      grid-template-columns: 1fr;
    }
  }
</style>
