---
import ContactForm from './ContactForm.astro';
import { SITE, UI } from '../data/site';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
  preselect?: string;
  title?: string;
  text?: string;
}
const { lang, preselect, title, text } = Astro.props;
const t = UI[lang];
---

<section class="section section--dark cta" id="paring">
  <div class="container grid">
    <div class="copy reveal">
      <p class="eyebrow">{t.nav.contact}</p>
      <h2 set:html={title ?? t.ctaBlock.title} />
      <p class="text">{text ?? t.ctaBlock.text}</p>
      <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
    <div class="form-wrap reveal">
      <ContactForm lang={lang} preselect={preselect} />
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .copy {
    position: sticky;
    top: 120px;
  }
  .text {
    color: var(--on-dark-muted);
    margin: 1.4rem 0 2rem;
    max-width: 26rem;
    font-size: 1.1rem;
  }
  .mail {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    text-decoration-color: var(--clay);
  }
  .form-wrap {
    background: var(--dark-soft);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 44px);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .copy {
      position: static;
    }
  }
</style>
