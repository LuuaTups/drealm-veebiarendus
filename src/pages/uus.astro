---
// Uue avalehe kavand (ainult ET). Pole sitemapis ega indekseeritud, kuni disain on kinnitatud.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/instrument-sans/index.css';
import Logo from '../components/Logo.astro';
import Building from '../components/mock/Building.astro';
import Icon from '../components/mock/Icon.astro';

const menu = [
  {
    group: 'Veeb',
    items: [
      { id: 'veebilehed', icon: 'web', name: 'Veebilehed', text: 'Premium-disain, mis laeb hetkega' },
      { id: 'platvormid', icon: 'plan', name: 'Platvormid', text: 'Korterivalikud, broneeringud, portaalid' },
    ],
  },
  {
    group: 'Turundus',
    items: [
      { id: 'seo', icon: 'rank', name: 'SEO', text: 'Leitav siis, kui sind otsitakse' },
      { id: 'meta', icon: 'target', name: 'Meta reklaamid', text: 'Facebook ja Instagram' },
      { id: 'reklaampildid', icon: 'frame', name: 'Reklaampildid', text: 'Kõik formaadid, üks bränd' },
      { id: 'video', icon: 'play', name: 'AI videoreklaamid', text: 'Klipid päevade, mitte nädalatega' },
    ],
  },
  {
    group: 'AI',
    items: [
      { id: 'automatiseerimine', icon: 'flow', name: 'AI automatiseerimine', text: 'Töö, mis liigub ise' },
      { id: 'koolitused', icon: 'learn', name: 'AI koolitused', text: 'Meeskond kasutab AI-d homme' },
      { id: 'ettevotte-ai', icon: 'chat', name: 'Sinu ettevõtte AI', text: 'Assistent, mis tunneb su äri' },
    ],
  },
] as const;
const services = menu.flatMap((g) => g.items.map((i) => i.name));

const units = [
  { id: 'A1', rooms: 2, m2: '54,2', status: 'Vaba' },
  { id: 'A2', rooms: 3, m2: '78,6', status: 'Broneeritud' },
  { id: 'A3', rooms: 1, m2: '36,8', status: 'Vaba' },
  { id: 'A4', rooms: 4, m2: '96,1', status: 'Müüdud' },
];
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>drealm — veebistuudio (kavand)</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- NAV -->
    <header class="nav" data-nav>
      <div class="nav-top">
        <div class="wrap nav-top-in">
          <span>Veebistuudio · Tallinn</span>
          <span class="avail"><i></i>Võtame vastu uusi projekte</span>
          <a href="mailto:info@drealm.ee">info@drealm.ee</a>
          <span class="lang"><b>ET</b><a href="/en">EN</a></span>
        </div>
      </div>
      <div class="nav-main">
        <div class="wrap nav-main-in">
          <a href="/uus" class="brand" aria-label="drealm avaleht"><Logo /></a>
          <nav class="nav-links" aria-label="Peamenüü">
            <div class="has-mega" data-mega>
              <button class="nav-link" aria-expanded="false" aria-controls="mega" data-mega-btn>
                Teenused <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" /></svg>
              </button>
              <div class="mega" id="mega">
                <div class="wrap mega-in">
                  {
                    menu.map((g) => (
                      <div class="mega-col">
                        <p class="mega-h">{g.group}</p>
                        {g.items.map((it) => (
                          <a class="mega-item" href={`#${it.id}`}>
                            <Icon name={it.icon} size={22} />
                            <span>
                              <b>{it.name}</b>
                              <small>{it.text}</small>
                            </span>
                          </a>
                        ))}
                      </div>
                    ))
                  }
                  <a class="mega-card" href="#kontakt">
                    <small>Esimene samm</small>
                    <b>Tasuta 20-minutiline kõne</b>
                    <span>Räägime eesmärgist, mitte tehnikast. Pakkumine fikseeritud hinnaga 2 päevaga.</span>
                    <em>Broneeri aeg <Icon name="arrow" size={16} /></em>
                  </a>
                </div>
              </div>
            </div>
            <a class="nav-link" href="#protsess">Protsess</a>
            <a class="nav-link" href="#kontakt">Kontakt</a>
          </nav>
          <a class="nav-cta" href="#kontakt"><span>Alusta projekti</span><Icon name="arrow" size={18} /></a>
          <button class="nav-toggle" aria-label="Ava menüü" aria-expanded="false" data-nav-toggle><span></span><span></span></button>
        </div>
      </div>
      <div class="nav-sheet">
        <div class="wrap">
          {
            menu.map((g) => (
              <div class="sheet-group">
                <p class="mega-h">{g.group}</p>
                {g.items.map((it) => (
                  <a href={`#${it.id}`}>
                    <Icon name={it.icon} size={20} />
                    {it.name}
                  </a>
                ))}
              </div>
            ))
          }
          <a href="#kontakt" class="btn btn-dark sheet-cta"><span>Alusta projekti</span><Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="kicker">Veebistuudio · Tallinn</p>
            <h1>Kodulehed, mis näevad välja sama head kui sinu teenus.</h1>
            <p class="hero-lead">Veeb, turundus ja AI ühest kohast. Disainime, ehitame ja paneme tööle.</p>
            <div class="hero-cta">
              <a class="btn btn-dark" href="#kontakt"><span>Broneeri tasuta 20-min kõne</span><Icon name="arrow" size={18} /></a>
              <a class="btn btn-line" href="#teenused"><span>Vaata, mida teeme</span></a>
            </div>
            <ul class="assure">
              <li><Icon name="check" size={16} />Fikseeritud hind</li>
              <li><Icon name="check" size={16} />Disain enne arendust</li>
              <li><Icon name="check" size={16} />Vastus 24 h jooksul</li>
            </ul>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="browser hero-browser">
              <div class="browser-bar"><i></i><i></i><i></i><span>kalaranna-kodud.ee</span></div>
              <div class="kk">
                <div class="kk-nav"><b>Kalaranna Kodud</b><span>Korterid</span><span>Asukoht</span><span class="kk-pill">Broneeri</span></div>
                <div class="kk-hero">
                  <Building class="kk-art" />
                  <div class="kk-text">
                    <small>Uusarendus · Kalamaja</small>
                    <h4>Elu mere ääres.</h4>
                    <span class="kk-btn">Vaata vabu kortereid</span>
                  </div>
                </div>
                <div class="kk-row"><div><b>48</b>korterit</div><div><b>1–4</b>tuba</div><div><b>2027</b>valmib</div></div>
              </div>
            </div>
            <div class="phone hero-phone">
              <div class="ig">
                <div class="ig-head"><i></i><div><b>kalaranna.kodud</b><small>Sponsitud</small></div></div>
                <div class="ig-media"><Building class="ig-art" /><span class="ig-tag">Avatud uksed L 12–16</span></div>
                <div class="ig-cta">Lisateave <Icon name="arrow" size={12} /></div>
                <p><b>kalaranna.kodud</b> Viimased 3-toalised merevaatega.</p>
              </div>
            </div>
            <div class="toast toast-lead">
              <span class="dot"></span>
              <div><strong>Uus päring</strong><span>3-toaline, merevaade · 2 min tagasi</span></div>
            </div>
            <div class="toast toast-ai">
              <Icon name="spark" size={18} class="spark" />
              <div><strong>AI vastas kliendile</strong><span>14 sekundiga, sinu toonis</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- TICKER -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-row">
          <div class="ticker-track">
            {
              [0, 1].map(() =>
                services.map((sv, n) => (
                  <span class="tk">
                    <sup>{String(n + 1).padStart(2, '0')}</sup>
                    {sv}
                    <Icon name="spark" size={18} class="tk-mark" />
                  </span>
                ))
              )
            }
          </div>
        </div>
        <div class="ticker-row reverse">
          <div class="ticker-track">
            {
              [0, 1].map(() =>
                ['Disain', 'Arendus', 'Turundus', 'Automatiseerimine', 'Koolitus', 'Tugi'].map((w) => (
                  <span class="tk ghost">
                    {w}
                    <span class="tk-sep" />
                  </span>
                ))
              )
            }
          </div>
        </div>
      </div>

      <!-- SERVICES BENTO -->
      <section class="bento-sec" id="teenused">
        <div class="wrap">
          <div class="sec-head">
            <h2>Kõik, mida su äri veebis vajab.</h2>
            <p>Üks tiim. Üks kontakt. Ei mingit agentuuride ahelat.</p>
          </div>

          <div class="bento">
            <!-- 1 Veebilehed -->
            <article class="tile t-web" id="veebilehed">
              <header><span class="tag">Veeb</span><Icon name="web" size={26} class="tile-ic" /><h3>Veebilehed</h3><p>Premium-disain, mis laeb hetkega.</p></header>
              <div class="vis">
                <div class="tabs" role="tablist" aria-label="Disaini vaated">
                  <button role="tab" aria-selected="true" data-view="desktop">Arvuti</button>
                  <button role="tab" aria-selected="false" data-view="mobile">Mobiil</button>
                  <button role="tab" aria-selected="false" data-view="system">Stiil</button>
                </div>
                <div class="view is-active" data-view="desktop">
                  <div class="browser">
                    <div class="browser-bar"><i></i><i></i><i></i><span>atelier-nord.ee</span></div>
                    <div class="nord">
                      <div class="nord-nav"><b>Atelier Nord</b><span>Menüü</span><span>Broneeri</span></div>
                      <div class="nord-hero">
                        <div><small>Restoran · Kalamaja</small><h4>Põhjamaine köök, aeglaselt tehtud.</h4><span class="pill-dark">Broneeri laud</span></div>
                        <div class="plate"><i></i><i></i><i></i></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="mobile">
                  <div class="phones">
                    <div class="phone sm">
                      <div class="nord-m"><b>Atelier Nord</b><div class="plate sm"><i></i><i></i><i></i></div><h4>Põhjamaine köök, aeglaselt tehtud.</h4><span class="pill-dark">Broneeri laud</span></div>
                    </div>
                    <div class="phone sm">
                      <div class="nord-m"><b>Broneeri</b><div class="field"><small>Kuupäev</small>R, 17. okt</div><div class="field"><small>Kell</small>19:30</div><div class="field"><small>Inimesi</small>4</div><span class="pill-dark full">Kinnita</span></div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="system">
                  <div class="system">
                    <p class="sys-aa">Aa</p>
                    <div class="sys-sw"><span style="background:#1c1a16"></span><span style="background:#3f4a32"></span><span style="background:#a85f35"></span><span style="background:#e7dccb"></span></div>
                    <div class="sys-btns"><span class="pill-dark">Esmane</span><span class="pill-line">Teisene</span></div>
                  </div>
                </div>
              </div>
            </article>

            <!-- 2 Platvormid -->
            <article class="tile t-plat dark" id="platvormid">
              <header><span class="tag">Veeb</span><Icon name="plan" size={26} class="tile-ic" /><h3>Platvormid</h3><p>Korterivalikud, broneeringud, kliendiportaalid.</p></header>
              <div class="vis">
                <div class="re">
                  <svg class="plan" viewBox="0 0 320 200" role="img" aria-label="Korruseplaan">
                    <rect x="6" y="6" width="308" height="188" rx="2" class="plan-outline" />
                    <g class="units">
                      <rect data-unit="A1" x="10" y="10" width="100" height="96" />
                      <rect data-unit="A2" x="114" y="10" width="120" height="96" />
                      <rect data-unit="A3" x="238" y="10" width="72" height="96" />
                      <rect data-unit="A4" x="10" y="110" width="180" height="80" />
                    </g>
                    <rect x="194" y="110" width="116" height="80" class="core" />
                    <g class="labels"><text x="60" y="62">A1</text><text x="174" y="62">A2</text><text x="274" y="62">A3</text><text x="100" y="154">A4</text></g>
                  </svg>
                  <table class="units-table">
                    <tbody>
                      {
                        units.map((u) => (
                          <tr data-unit={u.id}>
                            <td>{u.id}</td>
                            <td>{u.rooms} tuba</td>
                            <td>{u.m2} m²</td>
                            <td>
                              <span class:list={['badge', u.status === 'Vaba' ? 'free' : u.status === 'Müüdud' ? 'sold' : 'held']}>{u.status}</span>
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            </article>

            <!-- 3 SEO -->
            <article class="tile t-seo" id="seo">
              <header><span class="tag">Turundus</span><Icon name="rank" size={26} class="tile-ic" /><h3>SEO</h3><p>Sind leitakse siis, kui sind otsitakse.</p></header>
              <div class="vis">
                <div class="serp">
                  <div class="serp-q"><Icon name="search" size={14} />hambaarst kesklinn</div>
                  <div class="serp-r top"><small>kesklinnahambakliinik.ee</small><b>Kesklinna Hambakliinik · Broneeri aeg</b><span class="stars"><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /> Avatud täna 8–20</span></div>
                  <div class="serp-r"><small>naidis.ee</small><b>Hambaravi Tallinnas</b></div>
                  <div class="serp-r"><small>naidis2.ee</small><b>Hambaarstid kesklinnas</b></div>
                  <svg class="spark-chart" viewBox="0 0 200 60" aria-hidden="true"><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4 V60 H0Z" class="fill" /><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4" /></svg>
                </div>
              </div>
            </article>

            <!-- 4 Meta reklaamid -->
            <article class="tile t-meta" id="meta">
              <header><span class="tag">Turundus</span><Icon name="target" size={26} class="tile-ic" /><h3>Meta reklaamid</h3><p>Facebook ja Instagram, mis toovad päringuid.</p></header>
              <div class="vis">
                <div class="meta">
                  <div class="phone xs">
                    <div class="ig">
                      <div class="ig-head"><i class="c2"></i><div><b>savi.stuudio</b><small>Sponsitud</small></div></div>
                      <div class="ig-media ceramic"><span class="vase"></span><span class="vase two"></span></div>
                      <div class="ig-cta">Osta nüüd <Icon name="arrow" size={12} /></div>
                    </div>
                  </div>
                  <div class="target">
                    <small>Sihtrühm</small>
                    <span>Tallinn + 30 km</span><span>30–55</span><span>Sisekujundus</span><span>Kingitused</span>
                    <small>Paigutus</small>
                    <span>Feed</span><span>Stories</span><span>Reels</span>
                  </div>
                </div>
              </div>
            </article>

            <!-- 5 Reklaampildid -->
            <article class="tile t-ads" id="reklaampildid">
              <header><span class="tag">Turundus</span><Icon name="frame" size={26} class="tile-ic" /><h3>Reklaampildid</h3><p>Kõik formaadid, ühe brändi järgi.</p></header>
              <div class="vis">
                <div class="creatives">
                  <div class="cr sq"><small>1:1</small><b>Sügisel −20%</b><em>savi.stuudio</em></div>
                  <div class="cr pt"><small>4:5</small><b>Uus kollektsioon</b><em>Atelier Nord</em></div>
                  <div class="cr st"><small>9:16</small><b>Avatud uksed</b><em>Kalaranna</em></div>
                </div>
              </div>
            </article>

            <!-- 6 AI videoreklaamid -->
            <article class="tile t-video dark" id="video">
              <header><span class="tag">AI</span><Icon name="play" size={26} class="tile-ic" /><h3>AI videoreklaamid</h3><p>Klipid päevade, mitte nädalatega.</p></header>
              <div class="vis">
                <div class="video">
                  <div class="frame">
                    <div class="footage"><Building class="v-art" /></div>
                    <span class="rec"><i></i>AI · 0:15</span>
                    <p class="cap"><span>Merevaade.</span><span>Valmib 2027.</span><span>Broneeri nüüd.</span></p>
                    <div class="scrub"><i></i></div>
                  </div>
                  <ul class="scenes"><li class="on">Stseen 1</li><li>Stseen 2</li><li>Stseen 3</li><li>Logo</li></ul>
                </div>
              </div>
            </article>

            <!-- 7 AI automatiseerimine -->
            <article class="tile t-auto" id="automatiseerimine">
              <header><span class="tag">AI</span><Icon name="flow" size={26} class="tile-ic" /><h3>AI automatiseerimine</h3><p>Päringud, pakkumised ja arved liiguvad ise.</p></header>
              <div class="vis">
                <div class="flow" data-flow>
                  <div class="flow-step" data-step="0"><span class="ico"><Icon name="mail" size={18} /></span><div><strong>Päring saabub</strong><small>„Soovime pakkumist fassaadile…“</small></div></div>
                  <div class="flow-line"></div>
                  <div class="flow-step" data-step="1"><span class="ico"><Icon name="spark" size={18} /></span><div><strong>AI liigitab</strong><small>Fassaad · ~420 m² · kõrge prioriteet</small></div></div>
                  <div class="flow-line"></div>
                  <div class="flow-split">
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="doc" size={18} /></span><div><strong>Pakkumine</strong><small>Mustand valmis</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="stack" size={18} /></span><div><strong>CRM</strong><small>Kirje lisatud</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="bell" size={18} /></span><div><strong>Teavitus</strong><small>Sinu telefoni</small></div></div>
                  </div>
                </div>
              </div>
            </article>

            <!-- 8 AI koolitused -->
            <article class="tile t-course" id="koolitused">
              <header><span class="tag">AI</span><Icon name="learn" size={26} class="tile-ic" /><h3>AI koolitused</h3><p>Su meeskond kasutab AI-d homme, mitte kunagi.</p></header>
              <div class="vis">
                <div class="course">
                  <div class="course-top"><b>AI igapäevatöös</b><span>3 / 5</span></div>
                  <div class="bar"><i></i></div>
                  <ul>
                    <li class="done">ChatGPT ja Claude: põhitõed</li>
                    <li class="done">Kirjad ja pakkumised 5 minutiga</li>
                    <li class="done">Tabelid ja raportid</li>
                    <li class="now">Oma töövoogude automatiseerimine</li>
                    <li>Turvalisus ja andmed</li>
                  </ul>
                </div>
              </div>
            </article>

            <!-- 9 Sinu ettevõtte AI -->
            <article class="tile t-pai dark" id="ettevotte-ai">
              <header><span class="tag">AI</span><Icon name="chat" size={26} class="tile-ic" /><h3>Sinu ettevõtte AI</h3><p>Assistent, mis tunneb sinu hinnakirja, kliente ja dokumente.</p></header>
              <div class="vis">
                <div class="chat">
                  <div class="msg me">Koosta Kalaranna pakkumine eelmise malli põhjal.</div>
                  <div class="msg ai">
                    Valmis. Kasutasin 2026. aasta hinnakirja ja eelmist pakkumist. Kas saadan Martinile üle vaatamiseks?
                    <div class="src"><span>Hinnakiri_2026.xlsx</span><span>Pakkumine_Merivälja.pdf</span></div>
                  </div>
                  <div class="chat-in"><span>Küsi midagi oma ettevõtte kohta…</span><i><Icon name="up" size={16} /></i></div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- PROCESS -->
      <section class="process" id="protsess">
        <div class="wrap">
          <h2>Neli sammu. Ei mingeid üllatusi.</h2>
          <ol class="steps">
            <li><span>01</span><b>Kõne</b><p>20 min, tasuta</p></li>
            <li><span>02</span><b>Pakkumine</b><p>Fikseeritud hind</p></li>
            <li><span>03</span><b>Disain</b><p>Näed enne ehitust</p></li>
            <li><span>04</span><b>Avamine</b><p>2–6 nädalaga</p></li>
          </ol>
        </div>
      </section>

      <!-- CTA + FORM -->
      <section class="cta" id="kontakt">
        <div class="wrap cta-grid">
          <div>
            <h2>Räägime sinu projektist.</h2>
            <p>Paar lauset on piisav. Vastame ühe tööpäeva jooksul.</p>
            <div class="pick" role="group" aria-label="Mis sind huvitab?">
              {
                services.map((s) => (
                  <label>
                    <input type="checkbox" name="pick" value={s} />
                    <span>{s}</span>
                  </label>
                ))
              }
            </div>
          </div>
          <form class="form" method="post" action="/api/contact.php" data-form>
            <input type="hidden" name="lang" value="et" />
            <input type="hidden" name="page" value="/uus" />
            <input type="hidden" name="service" value="" data-service />
            <input type="hidden" name="ts" value="" data-ts />
            <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
            <label>Nimi<input name="name" required autocomplete="name" maxlength="120" /></label>
            <label>E-post<input type="email" name="email" required autocomplete="email" maxlength="160" /></label>
            <label>Millest räägime?<textarea name="message" rows="4" required maxlength="5000"></textarea></label>
            <button class="btn btn-light" type="submit"><span>Saada päring</span><Icon name="arrow" size={18} /></button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <Logo />
        <span>Veebistuudio · Tallinn</span>
        <a href="mailto:info@drealm.ee">info@drealm.ee</a>
      </div>
    </footer>

    <script>
      // Nav: compact on scroll, mega menu, mobile sheet
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const onScroll = () => nav.classList.toggle('scrolled', scrollY > 24);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const mega = nav.querySelector<HTMLElement>('[data-mega]')!;
      const megaBtn = mega.querySelector<HTMLButtonElement>('[data-mega-btn]')!;
      let closeTimer: number | undefined;
      const setMega = (open: boolean) => {
        mega.classList.toggle('open', open);
        megaBtn.setAttribute('aria-expanded', String(open));
      };
      megaBtn.addEventListener('click', () => setMega(!mega.classList.contains('open')));
      if (matchMedia('(hover: hover)').matches) {
        mega.addEventListener('mouseenter', () => (clearTimeout(closeTimer), setMega(true)));
        mega.addEventListener('mouseleave', () => (closeTimer = window.setTimeout(() => setMega(false), 180)));
      }
      mega.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMega(false)));
      addEventListener('keydown', (e) => e.key === 'Escape' && (setMega(false), nav.classList.remove('open')));

      const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      });
      nav.querySelectorAll('.nav-sheet a').forEach((a) =>
        a.addEventListener('click', () => {
          nav.classList.remove('open');
          document.body.style.overflow = '';
        })
      );

      // Design view tabs
      document.querySelectorAll<HTMLButtonElement>('.tabs [data-view]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const root = tab.closest('.vis')!;
          root.querySelectorAll('.tabs [data-view]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          root.querySelectorAll<HTMLElement>('.view').forEach((v) => v.classList.toggle('is-active', v.dataset.view === tab.dataset.view));
        });
      });

      // Floor plan <-> table highlight
      const re = document.querySelector('.re');
      re?.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
        const on = (v: boolean) => re.querySelectorAll(`[data-unit="${el.dataset.unit}"]`).forEach((x) => x.classList.toggle('hl', v));
        el.addEventListener('mouseenter', () => on(true));
        el.addEventListener('mouseleave', () => on(false));
      });

      // AI flow + video scenes step through in sequence
      const flow = document.querySelector('[data-flow]');
      const scenes = document.querySelectorAll('.scenes li');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let step = 0;
        setInterval(() => {
          flow?.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => s.classList.toggle('lit', Number(s.dataset.step) <= step));
          scenes.forEach((s, i) => s.classList.toggle('on', i === step));
          step = (step + 1) % 4;
        }, 1100);
      } else {
        flow?.querySelectorAll('[data-step]').forEach((s) => s.classList.add('lit'));
      }

      // Contact form
      document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
        form.querySelector<HTMLInputElement>('[data-ts]')!.value = String(Date.now());
        const status = form.querySelector('.form-status')!;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const picked = [...document.querySelectorAll<HTMLInputElement>('input[name="pick"]:checked')].map((c) => c.value);
          form.querySelector<HTMLInputElement>('[data-service]')!.value = picked.join(', ') || 'Avalehe päring';
          const btn = form.querySelector('button')!;
          btn.disabled = true;
          try {
            const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
            if (!res.ok) throw new Error();
            form.reset();
            status.textContent = 'Aitäh! Vastame ühe tööpäeva jooksul.';
          } catch {
            status.textContent = 'Saatmine ebaõnnestus. Kirjuta palun info@drealm.ee';
          } finally {
            btn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>

