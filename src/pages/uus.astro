    letter-spacing: -0.045em;
  }
  .pains-sub {
    margin: 1.4rem 0 2rem;
    color: var(--on-dark-2);
    max-width: 24rem;
  }
  .pain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .pain-list a {
    display: grid;
    grid-template-columns: 2.4rem 1fr auto;
    gap: 0.6rem 1.2rem;
    align-items: center;
    padding: 1.15rem 1.3rem;
    border-radius: var(--r-m);
    border: 1px solid rgba(255, 220, 205, 0.1);
    background: rgba(255, 235, 225, 0.035);
    color: inherit;
    text-decoration: none;
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.4s var(--ease);
  }
  .pain-list a:hover {
    background: rgba(255, 235, 225, 0.08);
    border-color: rgba(255, 160, 110, 0.35);
    transform: translateX(4px);
  }
  .pain-n {
    font-size: 0.78rem;
    color: #ff9a68;
    font-variant-numeric: tabular-nums;
  }
  .pain-list q {
    quotes: '„' '“';
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: rgba(255, 240, 232, 0.88);
  }
  .pain-svc {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    font-size: 0.76rem;
    color: #ffb48e;
    background: rgba(162, 30, 2, 0.25);
    white-space: nowrap;
  }
  .pain-list a:hover .pain-svc .icon {
    transform: translateX(3px);
  }

  /* ---------- SERVICES ---------- */
  .services {
    padding: clamp(96px, 12vw, 160px) 0 clamp(80px, 10vw, 140px);
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.4rem 3rem;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .sec-head h2 {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    letter-spacing: -0.045em;
  }
  .sec-head > p {
    margin: 0;
    max-width: 24rem;
    color: var(--ink-2);
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-height: 460px;
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--r-xl);
    background: var(--card);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: box-shadow 0.5s var(--ease);
  }
  .tile:hover {
    box-shadow: 0 40px 80px -50px rgba(76, 15, 5, 0.55);
  }
  .tile.dark {
    color: var(--on-dark);
    border-color: transparent;
    background:
      radial-gradient(90% 70% at 100% 0%, rgba(162, 30, 2, 0.5), transparent 60%),
      linear-gradient(165deg, #2a0601, #1b0200 70%);
  }
  .tile-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 14px;
    align-items: center;
  }
  .tile-head .tag {
    justify-self: end;
    align-self: start;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .tile.dark .tag {
    border-color: rgba(255, 220, 205, 0.16);
    color: var(--on-dark-2);
  }
  .tile-head h3 {
    grid-column: 1 / -1;
    margin: 1.4rem 0 0.5rem;
    font-size: clamp(1.9rem, 2.6vw, 2.5rem);
    letter-spacing: -0.04em;
  }
  .tile-head p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-2);
    max-width: 34rem;
  }
  .tile.dark .tile-head p {
    color: var(--on-dark-2);
  }
  .vis {
    margin-top: auto;
  }
  .t-web {
    grid-column: span 7;
  }
  .t-plat {
    grid-column: span 5;
  }
  .t-seo,
  .t-meta,
  .t-ads,
  .t-video {
    grid-column: span 4;
  }
  .t-auto {
    grid-column: span 8;
  }
  .t-course {
    grid-column: span 5;
  }
  .t-pai {
    grid-column: span 7;
  }

  /* mock building blocks */
  .browser {
    overflow: hidden;
    border-radius: var(--r-m);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -36px rgba(76, 15, 5, 0.5);
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: #f3ede6;
    border-bottom: 1px solid var(--line);
  }
  .browser-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ddd2c6;
  }
  .browser-bar span {
    margin: 0 auto;
    padding: 2px 14px;
    border-radius: 6px;
    font-size: 0.7rem;
    color: var(--muted);
    background: #fff;
    transform: translateX(-16px);
  }
  .phone {
    overflow: hidden;
    border-radius: 26px;
    border: 6px solid #140100;
    background: #140100;
    box-shadow: 0 30px 60px -24px rgba(27, 2, 0, 0.55);
  }
  .mini-btn {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 10px;
    background: var(--r-900);
    color: #fff;
  }
  .mini-btn.ghost {
    background: transparent;
    color: var(--r-900);
    border: 1px solid var(--r-900);
  }
  .field {
    padding: 6px 8px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #eadfd5;
  }
  .field small,
  .nord-hero small {
    display: block;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* web tile */
  .seg {
    display: inline-flex;
    gap: 3px;
    padding: 4px;
    margin-bottom: 14px;
    border-radius: 12px;
    background: #efe7de;
  }
  .seg button {
    border: 0;
    background: transparent;
    padding: 0.45rem 0.95rem;
    border-radius: 9px;
    font: 500 0.85rem var(--sans);
    color: var(--muted);
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .seg button[aria-selected='true'] {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 2px 8px -2px rgba(76, 15, 5, 0.18);
  }
  .view {
    display: none;
  }
  .view.is-active {
    display: block;
    animation: fade 0.4s var(--ease);
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .nord {
    padding: 14px 18px 18px;
    background: #f8f2ea;
  }
  .nord-nav {
    display: flex;
    gap: 16px;
    margin-bottom: 14px;
    font-size: 10px;
  }
  .nord-nav b,
  .nord-m > b {
    margin-right: auto;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 14px;
  }
  .nord-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: center;
  }
  .nord-hero h4,
  .nord-m h4 {
    margin: 6px 0 10px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(18px, 2vw, 26px);
    letter-spacing: -0.02em;
  }
  .plate {
    position: relative;
    aspect-ratio: 1.3;
    border-radius: 10px;
    overflow: hidden;
    background: radial-gradient(circle at 30% 20%, #7c3a22, #3a0f06);
  }
  .plate i {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .plate i:nth-child(1) {
    width: 62%;
    aspect-ratio: 1;
    background: #f3ebe0;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.4);
  }
  .plate i:nth-child(2) {
    width: 34%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 40% 40%, #d0682f, #8e3415);
  }
  .plate i:nth-child(3) {
    width: 14%;
    aspect-ratio: 2;
    border-radius: 50% 50% 50% 0;
    background: #6a7f45;
    transform: translate(-10%, -130%) rotate(-25deg);
  }
  .phones {
    display: flex;
    gap: 6%;
    justify-content: center;
  }
  .phone.sm {
    width: 36%;
  }
  .nord-m {
    display: flex;
    flex-direction: column;
    gap: 8px;
    aspect-ratio: 9 / 17;
    padding: 12px 10px;
    font-size: 10px;
    background: #f8f2ea;
  }
  .nord-m h4 {
    font-size: 15px;
    margin: 0;
  }
  .plate.sm {
    aspect-ratio: 1.2;
  }
  .full {
    margin-top: auto;
    text-align: center;
  }
  .system {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 22px;
    align-items: center;
    padding: 22px;
    border-radius: var(--r-m);
    background: #fff;
    border: 1px solid var(--line);
  }
  .sys-aa {
    grid-row: span 2;
    margin: 0;
    font-family: var(--serif);
    font-size: 84px;
    line-height: 1;
  }
  .sys-sw {
    display: flex;
    gap: 8px;
  }
  .sys-sw span {
    flex: 1;
    height: 52px;
    border-radius: 10px;
    border: 1px solid var(--line);
  }
  .sys-btns {
    display: flex;
    gap: 8px;
  }

  /* platform tile */
  .re {
    display: grid;
    gap: 14px;
    padding: 14px;
    border-radius: var(--r-l);
    background: rgba(255, 235, 225, 0.04);
    border: 1px solid rgba(255, 220, 205, 0.1);
  }
  .plan {
    width: 100%;
  }
  .plan-outline {
    fill: none;
    stroke: rgba(255, 228, 214, 0.5);
    stroke-width: 1.5;
  }
  .units rect {
    fill: rgba(255, 235, 225, 0.06);
    stroke: rgba(255, 228, 214, 0.28);
    stroke-width: 1;
    cursor: pointer;
    transition: fill 0.25s;
  }
  .units rect.hl {
    fill: rgba(255, 120, 60, 0.55);
  }
  .core {
    fill: rgba(0, 0, 0, 0.25);
    stroke: rgba(255, 228, 214, 0.12);
  }
  .labels text {
    font: 600 12px var(--sans);
    text-anchor: middle;
    fill: #fff;
    pointer-events: none;
  }
  .units-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .units-table td {
    padding: 0.55rem 0.5rem;
    border-top: 1px solid rgba(255, 220, 205, 0.08);
    white-space: nowrap;
  }
  .units-table tr {
    cursor: pointer;
    transition: background 0.2s;
  }
  .units-table tr.hl {
    background: rgba(255, 120, 60, 0.14);
  }
  .badge {
    padding: 3px 9px;
    border-radius: 7px;
    font-size: 0.7rem;
  }
  .badge.free {
    background: rgba(127, 176, 105, 0.18);
    color: #b9e0a4;
  }
  .badge.held {
    background: rgba(255, 170, 80, 0.18);
    color: #ffc98e;
  }
  .badge.sold {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 228, 214, 0.45);
  }

  /* seo tile */
  .serp {
    overflow: hidden;
    padding: 14px;
    border-radius: var(--r-m);
    background: #fff;
    border: 1px solid var(--line);
    font-size: 0.78rem;
  }
  .serp-q {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid #eadfd5;
    box-shadow: 0 4px 12px -6px rgba(76, 15, 5, 0.2);
  }
  .serp-q .icon {
    color: var(--muted);
  }
  .serp-r {
    padding: 7px 0;
    opacity: 0.42;
  }
  .serp-r small {
    display: block;
    font-size: 0.7rem;
    color: #4d5156;
  }
  .serp-r b {
    font-weight: 500;
    color: #1a0dab;
  }
  .serp-r.top {
    opacity: 1;
    margin: 0 -6px;
    padding: 10px 12px;
    border-radius: 10px;
    background: linear-gradient(90deg, rgba(162, 30, 2, 0.08), transparent);
    box-shadow: inset 3px 0 0 var(--r-500);
  }
  .serp-r.top span {
    display: block;
    font-size: 0.72rem;
    color: #b06d1e;
  }
  .stars .icon {
    fill: currentColor;
    stroke: none;
    vertical-align: -1px;
  }
  .spark-chart {
    width: 100%;
    height: 56px;
    margin-top: 8px;
  }
  .spark-chart .line {
    fill: none;
    stroke: var(--r-500);
    stroke-width: 2;
  }

  /* meta tile */
  .meta {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 14px;
    align-items: end;
  }
  .phone.xs {
    border-width: 5px;
    border-radius: 20px;
  }
  .ig {
    font-size: 10px;
    color: #111;
    background: #fff;
  }
  .ig-head {
    display: flex;
    gap: 7px;
    align-items: center;
    padding: 8px;
  }
  .ig-head i {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: linear-gradient(135deg, #d0682f, #6e1a08);
  }
  .ig-head b {
    display: block;
    font-size: 10px;
  }
  .ig-head small {
    font-size: 9px;
    color: #777;
  }
  .ig-media {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 10%;
    aspect-ratio: 4 / 5;
    padding-bottom: 18%;
    background: linear-gradient(180deg, #ecdccb, #cfb197);
  }
  .vase {
    width: 26%;
    aspect-ratio: 0.7;
    border-radius: 40% 40% 30% 30% / 55% 55% 25% 25%;
    background: radial-gradient(circle at 35% 30%, #d0784a, #8e3415);
    box-shadow: 0 10px 14px -6px rgba(0, 0, 0, 0.35);
  }
  .vase.two {
    width: 20%;
    aspect-ratio: 0.55;
    background: radial-gradient(circle at 35% 30%, #f4ede4, #b8ab98);
  }
  .ig-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px;
    font-weight: 600;
    background: #f2f2f2;
  }
  .report {
    padding: 14px;
    border-radius: var(--r-m);
    background: #fff;
    border: 1px solid var(--line);
    font-size: 0.78rem;
  }
  .report small {
    display: block;
    margin-bottom: 10px;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rep-row {
    display: grid;
    grid-template-columns: 4.6rem 1fr 1.6rem;
    gap: 8px;
    align-items: center;
    padding: 5px 0;
  }
  .rep-row i {
    height: 8px;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--r-400) var(--w), #f1e8de var(--w));
  }
  .rep-row b {
    text-align: right;
    font-weight: 600;
  }
  .rep-row.off {
    color: var(--muted);
  }
  .rep-row.off i {
    background: linear-gradient(90deg, #cdbfb2 var(--w), #f1e8de var(--w));
  }
  .report p {
    margin: 8px 0 0;
    font-size: 0.72rem;
    color: var(--muted);
  }

  /* ads tile */
  .creatives {
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }
  .cr {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
    border-radius: 12px;
    color: #fff;
    box-shadow: 0 18px 32px -18px rgba(27, 2, 0, 0.6);
    transition: transform 0.5s var(--ease);
  }
  .creatives:hover .cr:nth-child(1) {
    transform: rotate(-4deg) translateY(-6px);
  }
  .creatives:hover .cr:nth-child(2) {
    transform: translateY(-10px);
  }
  .creatives:hover .cr:nth-child(3) {
    transform: rotate(4deg) translateY(-6px);
  }
  .cr small {
    position: absolute;
    top: 9px;
    left: 11px;
    padding: 2px 6px;
    border-radius: 5px;
    font-size: 0.62rem;
    background: rgba(0, 0, 0, 0.25);
  }
  .cr b {
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .cr em {
    margin-top: 4px;
    font-style: normal;
    font-size: 0.66rem;
    opacity: 0.8;
  }
  .cr.sq {
    flex: 1;
    aspect-ratio: 1;
    background: radial-gradient(circle at 70% 30%, #f0a070, #c2441a 55%, #6e1a08);
  }
  .cr.pt {
    flex: 1;
    aspect-ratio: 4 / 5;
    background: linear-gradient(160deg, #4c0f05, #1b0200);
  }
  .cr.st {
    flex: 0.75;
    aspect-ratio: 9 / 16;
    background: linear-gradient(180deg, #e9c29d, #a8603d 60%, #3a1208);
  }

  /* video tile */
  .video {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: end;
  }
  .frame {
    position: relative;
    aspect-ratio: 9 / 14;
    overflow: hidden;
    border-radius: var(--r-m);
    background: #000;
    box-shadow: 0 0 0 1px rgba(255, 220, 205, 0.12);
  }
  .footage {
    position: absolute;
    inset: 0;
    animation: kenburns 9s ease-in-out infinite alternate;
  }
  .v-art {
    width: 100%;
    height: 100%;
  }
  @keyframes kenburns {
    to {
      transform: scale(1.18) translateX(-6%);
    }
  }
  .rec {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 9px;
    border-radius: 8px;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
  }
  .rec i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    background: #ff4d4d;
    vertical-align: 1px;
    animation: pulse 1.6s infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26%;
    margin: 0;
    text-align: center;
    font: 600 1rem var(--sans);
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .cap span {
    position: absolute;
    left: 0;
    right: 0;
    opacity: 0;
    animation: cap 6s infinite;
  }
  .cap span:nth-child(2) {
    animation-delay: 2s;
  }
  .cap span:nth-child(3) {
    animation-delay: 4s;
  }
  @keyframes cap {
    0%,
    30% {
      opacity: 1;
    }
    34%,
    100% {
      opacity: 0;
    }
  }
  .scrub {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 3px;
    border-radius: 3px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.25);
  }
  .scrub i {
    display: block;
    height: 100%;
    background: #fff;
    transform-origin: left;
    animation: scrub 6s linear infinite;
  }
  @keyframes scrub {
    from {
      transform: scaleX(0);
    }
  }
  .scenes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 0.72rem;
    color: var(--on-dark-2);
  }
  .scenes li {
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 220, 205, 0.12);
    transition:
      color 0.3s,
      border-color 0.3s,
      background 0.3s;
  }
  .scenes li.on {
    color: #fff;
    border-color: rgba(255, 150, 100, 0.6);
    background: rgba(255, 120, 60, 0.12);
  }

  /* automation tile */
  .flow {
    padding: clamp(16px, 2.4vw, 26px);
    border-radius: var(--r-l);
    color: var(--on-dark);
    background:
      radial-gradient(70% 80% at 100% 0%, rgba(162, 30, 2, 0.45), transparent 60%),
      linear-gradient(165deg, #2a0601, #1b0200);
  }
  .flow-step {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 0.95rem;
    border-radius: var(--r-m);
    border: 1px solid rgba(255, 220, 205, 0.08);
    background: rgba(255, 235, 225, 0.04);
    opacity: 0.4;
    transition:
      opacity 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .flow-step.lit {
