    width: 0.9em;
    height: 1px;
    background: rgba(241, 235, 225, 0.25);
    margin-left: 0.4em;
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- BENTO ---------- */
  .bento-sec {
    padding: clamp(80px, 10vw, 140px) 0;
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .sec-head h2 {
    font-size: clamp(2.2rem, 4.4vw, 3.8rem);
    max-width: 14em;
  }
  .sec-head p {
    margin: 0;
    color: var(--muted);
    max-width: 22rem;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 14px;
  }
  .tile {
    --mk: rgba(23, 21, 17, 0.55);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--mk), var(--mk)), linear-gradient(var(--mk), var(--mk)), linear-gradient(var(--mk), var(--mk)),
      linear-gradient(var(--mk), var(--mk)), linear-gradient(var(--mk), var(--mk)), linear-gradient(var(--mk), var(--mk)),
      linear-gradient(var(--mk), var(--mk)), linear-gradient(var(--mk), var(--mk));
    background-size:
      14px 1px, 1px 14px, 14px 1px, 1px 14px,
      14px 1px, 1px 14px, 14px 1px, 1px 14px;
    background-position:
      0 0, 0 0, 100% 0, 100% 0,
      0 100%, 0 100%, 100% 100%, 100% 100%;
    background-repeat: no-repeat;
    border: 1px solid rgba(23, 21, 17, 0.06);
    position: relative;
    border-radius: 0;
    padding: clamp(20px, 2.4vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    overflow: hidden;
    min-height: 420px;
  }
  .tile.dark {
    --mk: rgba(241, 235, 225, 0.55);
    background-color: var(--dark);
    color: var(--on-dark);
    border-color: transparent;
  }
  .tile header h3 {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    margin: 0.5rem 0 0.35rem;
  }
  .tile header p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
  .tile.dark header p {
    color: var(--on-dark-2);
  }
  .tile-ic {
    position: absolute;
    top: clamp(20px, 2.4vw, 30px);
    right: clamp(20px, 2.4vw, 30px);
    color: var(--clay);
  }
  .tile.dark .tile-ic {
    color: var(--clay-l);
  }
  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .tile.dark .tag {
    color: var(--clay-l);
  }
  .vis {
    margin-top: auto;
  }
  .t-web {
    grid-column: span 7;
  }
  .t-plat {
    grid-column: span 5;
  }
  .t-seo,
  .t-meta,
  .t-ads,
  .t-video {
    grid-column: span 4;
  }
  .t-auto {
    grid-column: span 8;
  }
  .t-course {
    grid-column: span 5;
  }
  .t-pai {
    grid-column: span 7;
  }

  /* web tile */
  .tabs {
    display: flex;
    gap: 1.4rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .tabs button {
    border: 0;
    background: transparent;
    font: 500 0.85rem var(--sans);
    color: var(--muted);
    padding: 0.5rem 0;
    margin-bottom: -1px;
    border-bottom: 1px solid transparent;
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .view {
    display: none;
  }
  .view.is-active {
    display: block;
    animation: fade 0.35s ease;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .nord {
    background: #f3eee6;
    padding: 14px 18px 18px;
  }
  .nord-nav {
    display: flex;
    gap: 16px;
    font-size: 10px;
    margin-bottom: 14px;
  }
  .nord-nav b,
  .nord-m > b {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 14px;
    margin-right: auto;
  }
  .nord-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: center;
  }
  .nord-hero small,
  .field small {
    display: block;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a7f71;
  }
  .nord-hero h4 {
    font-size: clamp(18px, 2vw, 26px);
    margin: 6px 0 10px;
  }
  .pill-dark,
  .pill-line {
    display: inline-block;
    font-size: 10px;
    padding: 6px 12px;
    border-radius: 0;
    background: #2a3022;
    color: #f3eee6;
  }
  .pill-line {
    background: transparent;
    color: #2a3022;
    border: 1px solid #2a3022;
  }
  .plate {
    position: relative;
    aspect-ratio: 1.3;
    border-radius: 0;
    background: radial-gradient(circle at 30% 20%, #7c5a40, #4a3324);
    overflow: hidden;
  }
  .plate i {
    position: absolute;
    border-radius: 50%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .plate i:nth-child(1) {
    width: 62%;
    aspect-ratio: 1;
    background: #efe7da;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
  }
  .plate i:nth-child(2) {
    width: 34%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 40% 40%, #c7763f, #8e4b25);
  }
  .plate i:nth-child(3) {
    width: 14%;
    aspect-ratio: 2;
    background: #5d7a45;
    border-radius: 0;
    transform: translate(-10%, -130%) rotate(-25deg);
  }
  .phones {
    display: flex;
    gap: 6%;
    justify-content: center;
  }
  .phone.sm {
    width: 36%;
  }
  .nord-m {
    background: #f3eee6;
    aspect-ratio: 9 / 17;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 10px;
  }
  .nord-m h4 {
    font-size: 15px;
  }
  .plate.sm {
    aspect-ratio: 1.2;
  }
  .field {
    background: #fff;
    border: 1px solid #e2d9cb;
    border-radius: 0;
    padding: 6px 8px;
  }
  .full {
    text-align: center;
    margin-top: auto;
  }
  .system {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px 20px;
    align-items: center;
    background: #fff;
    border-radius: 0;
    padding: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }
  .sys-aa {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 144;
    font-size: 84px;
    line-height: 1;
    margin: 0;
    grid-row: span 2;
  }
  .sys-sw {
    display: flex;
    gap: 8px;
  }
  .sys-sw span {
    flex: 1;
    height: 52px;
    border-radius: 0;
  }
  .sys-btns {
    display: flex;
    gap: 8px;
  }

  /* platform tile */
  .re {
    display: grid;
    gap: 14px;
  }
  .plan {
    width: 100%;
  }
  .plan-outline {
    fill: none;
    stroke: #efe6da;
    stroke-width: 2;
  }
  .units rect {
    fill: #2c2a24;
    stroke: #8f8578;
    stroke-width: 1;
    transition: fill 0.2s;
    cursor: pointer;
  }
  .units rect.hl {
    fill: var(--clay);
  }
  .core {
    fill: #1e1c18;
    stroke: #5a544b;
  }
  .labels text {
    font: 600 12px var(--sans);
    text-anchor: middle;
    fill: #efe6da;
    pointer-events: none;
  }
  .units-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .units-table td {
    padding: 0.5rem 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    white-space: nowrap;
  }
  .units-table tr {
    cursor: pointer;
  }
  .units-table tr.hl {
    background: rgba(168, 95, 53, 0.22);
  }
  .badge {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 0;
  }
  .badge.free {
    background: #2f4129;
    color: #b9d6a9;
  }
  .badge.held {
    background: #4a3820;
    color: #f0c98e;
  }
  .badge.sold {
    background: #2e2b26;
    color: #8f8578;
  }

  /* seo tile */
  .serp {
    background: #fff;
    border-radius: 0;
    padding: 14px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 0.78rem;
    overflow: hidden;
  }
  .serp-q {
    display: flex;
    gap: 8px;
    align-items: center;
    border: 1px solid #e3ddd4;
    border-radius: 0;
    padding: 7px 12px;
    margin-bottom: 12px;
  }
  .serp-q .icon {
    color: var(--muted);
  }
  .serp-r {
    padding: 7px 0;
    opacity: 0.45;
  }
  .serp-r small {
    display: block;
    color: #4d5156;
    font-size: 0.7rem;
  }
  .serp-r b {
    color: #1a0dab;
    font-weight: 500;
  }
  .serp-r.top {
    opacity: 1;
    background: #f7f3ec;
    margin: 0 -14px;
    padding: 9px 14px;
    border-left: 3px solid var(--clay);
  }
  .stars .icon {
    fill: currentColor;
    stroke: none;
    vertical-align: -1px;
  }
  .serp-r.top span {
    display: block;
    color: #b06d1e;
    font-size: 0.72rem;
  }
  .spark-chart {
    width: 100%;
    height: 56px;
    margin-top: 8px;
  }
  .spark-chart path {
    fill: none;
    stroke: var(--olive);
    stroke-width: 2;
  }
  .spark-chart .fill {
    fill: rgba(63, 74, 50, 0.1);
    stroke: none;
  }

  /* meta tile */
  .meta {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: 14px;
    align-items: end;
  }
  .phone.xs {
    border-width: 5px;
    border-radius: 20px;
  }
  .ig-media.ceramic {
    background: linear-gradient(180deg, #e6d6c3, #cdb398);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 10%;
    padding-bottom: 18%;
  }
  .vase {
    width: 26%;
    aspect-ratio: 0.7;
    background: radial-gradient(circle at 35% 30%, #c98a5f, #8e4b25);
    border-radius: 0;
    box-shadow: 0 10px 14px -6px rgba(0, 0, 0, 0.35);
  }
  .vase.two {
    width: 20%;
    aspect-ratio: 0.55;
    background: radial-gradient(circle at 35% 30%, #f1ebe1, #b8ab98);
  }
  .target {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: flex-end;
  }
  .target small {
    flex-basis: 100%;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
  }
  .target span {
    font-size: 0.74rem;
    background: #efe7da;
    padding: 4px 9px;
    border-radius: 0;
  }

  /* ads tile */
  .creatives {
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }
  .cr {
    position: relative;
    border-radius: 0;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    box-shadow: 0 16px 30px -18px rgba(30, 22, 12, 0.6);
    transition: transform 0.3s;
  }
  .creatives:hover .cr:nth-child(1) {
    transform: rotate(-3deg) translateY(-4px);
  }
  .creatives:hover .cr:nth-child(3) {
    transform: rotate(3deg) translateY(-4px);
  }
  .cr small {
    position: absolute;
    top: 8px;
    left: 10px;
    font-size: 0.65rem;
    opacity: 0.75;
  }
  .cr b {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.05;
  }
  .cr em {
    font-style: normal;
    font-size: 0.66rem;
    opacity: 0.8;
    margin-top: 4px;
  }
  .cr.sq {
    flex: 1;
    aspect-ratio: 1;
    background: radial-gradient(circle at 70% 30%, #e0a27a, #a85f35 60%, #6e3a1f);
  }
  .cr.pt {
    flex: 1;
    aspect-ratio: 4 / 5;
    background: linear-gradient(160deg, #56634a, #2c3424);
  }
  .cr.st {
    flex: 0.75;
    aspect-ratio: 9 / 16;
    background: linear-gradient(180deg, #e9c29d, #8f6a52 70%, #3a3129);
  }

  /* video tile */
  .video {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: end;
  }
  .frame {
    position: relative;
    aspect-ratio: 9 / 14;
    border-radius: 0;
    overflow: hidden;
    background: #000;
  }
  .footage {
    position: absolute;
    inset: 0;
    animation: kenburns 9s ease-in-out infinite alternate;
  }
  .v-art {
    width: 100%;
    height: 100%;
  }
  @keyframes kenburns {
    to {
      transform: scale(1.18) translateX(-6%);
    }
  }
  .rec i {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #e5484d;
    margin-right: 6px;
    vertical-align: 1px;
    animation: pulse 1.6s infinite;
  }
  .rec {
    letter-spacing: 0.06em;
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 0.68rem;
    background: rgba(0, 0, 0, 0.5);
    padding: 3px 8px;
    border-radius: 0;
    color: #fff;
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26%;
    margin: 0;
    text-align: center;
    font: 600 1rem var(--sans);
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .cap span {
    position: absolute;
    left: 0;
    right: 0;
    opacity: 0;
    animation: cap 6s infinite;
  }
  .cap span:nth-child(2) {
    animation-delay: 2s;
  }
  .cap span:nth-child(3) {
    animation-delay: 4s;
  }
  @keyframes cap {
    0%,
    30% {
      opacity: 1;
    }
    34%,
    100% {
      opacity: 0;
    }
  }
  .scrub {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 3px;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.25);
    overflow: hidden;
  }
  .scrub i {
    display: block;
    height: 100%;
    background: #fff;
    animation: scrub 6s linear infinite;
    transform-origin: left;
  }
  @keyframes scrub {
    from {
      transform: scaleX(0);
    }
  }
  .scenes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 0.72rem;
    color: var(--on-dark-2);
  }
  .scenes li {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0;
    padding: 6px 10px;
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .scenes li.on {
    color: var(--on-dark);
    border-color: var(--clay-l);
  }

  /* automation tile */
  .flow {
    background: var(--dark);
    border-radius: 0;
    padding: clamp(16px, 2.4vw, 26px);
    color: var(--on-dark);
  }
  .flow-step {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    background: var(--dark-2);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 0;
    padding: 0.75rem 0.9rem;
    opacity: 0.4;
    transition:
      opacity 0.4s,
      border-color 0.4s;
  }
  .flow-step.lit {
    opacity: 1;
    border-color: rgba(211, 154, 115, 0.5);
  }
  .flow-step strong {
    display: block;
    font-weight: 500;
    font-size: 0.92rem;
  }
  .flow-step small {
    color: var(--on-dark-2);
    font-size: 0.78rem;
  }
  .ico {
    width: 32px;
    height: 32px;
    border-radius: 0;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.06);
    color: var(--clay-l);
    flex: none;
  }
  .flow-line {
    width: 1px;
    height: 16px;
    margin-left: 31px;
    background: rgba(255, 255, 255, 0.18);
  }
  .flow-split {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  /* course tile */
  .course {
    background: #fff;
    border-radius: 0;
    padding: 16px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 0.86rem;
  }
  .course-top {
    display: flex;
    justify-content: space-between;
  }
  .course-top span {
    color: var(--muted);
  }
  .bar {
    height: 6px;
    background: #eee6da;
    border-radius: 0;
    margin: 10px 0 12px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    width: 60%;
    height: 100%;
    background: var(--olive);
    border-radius: 0;
  }
  .course ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .course li {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 7px 0;
    color: var(--muted);
  }
  .course li::before {
    content: '';
    width: 16px;
    height: 16px;
    border: 1.5px solid #cfc4b4;
    flex: none;
  }
  .course li.done {
    color: var(--ink);
  }
  .course li.done::before {
    background:
      linear-gradient(45deg, transparent 45%, #fff 45%, #fff 55%, transparent 55%) no-repeat 3px 6px / 6px 6px,
      linear-gradient(-45deg, transparent 45%, #fff 45%, #fff 55%, transparent 55%) no-repeat 6px 3px / 9px 9px,
      var(--olive);
    border-color: var(--olive);
  }
  .course li.now {
    color: var(--ink);
    font-weight: 500;
  }
  .course li.now::before {
    border-color: var(--clay);
    box-shadow: inset 0 0 0 4px #fff;
    background: var(--clay);
  }

  /* personal AI tile */
  .chat {
    display: grid;
    gap: 10px;
  }
  .msg {
    max-width: 82%;
    padding: 0.75rem 1rem;
    border-radius: 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .msg.me {
    justify-self: end;
    background: var(--on-dark);
    color: var(--ink);
    border-bottom-right-radius: 4px;
  }
  .msg.ai {
    background: var(--dark-2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-left-radius: 4px;
  }
  .src {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .src span {
    font-size: 0.72rem;
    color: var(--clay-l);
    border: 1px solid rgba(211, 154, 115, 0.35);
    padding: 2px 8px;
    border-radius: 0;
  }
  .chat-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0;
    padding: 0.55rem 0.6rem 0.55rem 1rem;
    font-size: 0.85rem;
    color: var(--on-dark-2);
    margin-top: 4px;
  }
  .chat-in i {
    font-style: normal;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--on-dark);
    color: var(--ink);
  }

  /* ---------- PROCESS ---------- */
  .process {
    padding: 0 0 clamp(80px, 10vw, 140px);
  }
  .process h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    margin-bottom: 2rem;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--ink);
  }
  .steps li {
    padding: 1.4rem 1.4rem 0 0;
  }
  .steps span {
    font-size: 0.8rem;
    color: var(--clay);
  }
  .steps b {
    display: block;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.7rem;
    margin: 0.3rem 0 0.2rem;
  }
  .steps p {
    margin: 0;
    color: var(--muted);
  }

  /* ---------- CTA ---------- */
  .cta {
    background: var(--olive);
    color: var(--on-dark);
    padding: clamp(80px, 10vw, 140px) 0;
  }
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
