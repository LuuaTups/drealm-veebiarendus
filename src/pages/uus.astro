---
// Uue avalehe kavand (ainult ET). Pole sitemapis ega indekseeritud, kuni disain on kinnitatud.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/instrument-sans/index.css';
import { Image } from 'astro:assets';
import Logo from '../components/Logo.astro';
import Building from '../components/mock/Building.astro';
import Icon from '../components/mock/Icon.astro';
import AuditForm from '../components/AuditForm.astro';
import whyPhoto from '../assets/photos/pagariari.jpg';

const pains = [
  { id: 'veebilehed', q: 'Meie koduleht on 2015. aastast ja ma ei julge linki kellelegi saata.', svc: 'Veebilehed' },
  { id: 'seo', q: 'Google’is leiavad kliendid konkurendi, mitte meid.', svc: 'SEO' },
  { id: 'meta', q: 'Reklaamile läheb raha, aga keegi ei oska öelda, mis see tagasi tõi.', svc: 'Meta reklaamid' },
  { id: 'reklaampildid', q: 'Instagrami postitused jäävad tegemata, sest pole aega ega pilte.', svc: 'Reklaampildid' },
  { id: 'video', q: 'Videoreklaam oleks hea, aga võttepäev maksab rohkem kui reklaam ise.', svc: 'AI videoreklaamid' },
  { id: 'platvormid', q: 'Ostjad helistavad, et küsida, millised korterid on veel vabad.', svc: 'Platvormid' },
  { id: 'automatiseerimine', q: 'Pool päeva läheb e-kirjadele, pakkumistele ja arvetele.', svc: 'AI automatiseerimine' },
  { id: 'koolitused', q: 'Kõik räägivad AI-st, aga meie tiimis ei kasuta seda keegi.', svc: 'AI koolitused' },
  { id: 'ettevotte-ai', q: 'Samadele küsimustele vastan iga päev uuesti.', svc: 'Sinu ettevõtte AI' },
];

const pillars = [
  { icon: 'web', name: 'Veeb', items: ['Veebilehed', 'Platvormid'], text: 'Koduleht või tööriist, mis näeb hea välja ja teeb tööd.' },
  { icon: 'target', name: 'Turundus', items: ['SEO', 'Meta reklaamid', 'Reklaampildid', 'AI videoreklaamid'], text: 'Kliendid leiavad sind Google’ist ja sotsiaalmeediast.' },
  { icon: 'spark', name: 'AI', items: ['Automatiseerimine', 'Koolitused', 'Sinu ettevõtte AI'], text: 'Rutiin liigub ise, tiim keskendub päris tööle.' },
] as const;

const statement =
  'Teeme ettevõtetele kodulehti, mis näevad välja nii, nagu nende teenus väärib. Toome neile kliente Google’ist ja sotsiaalmeediast. Ja paneme AI tegema tööd, mis praegu võtab tunde.';

const units = [
  { id: 'A1', rooms: 2, m2: '54,2', status: 'Vaba' },
  { id: 'A2', rooms: 3, m2: '78,6', status: 'Broneeritud' },
  { id: 'A3', rooms: 1, m2: '36,8', status: 'Vaba' },
  { id: 'A4', rooms: 4, m2: '96,1', status: 'Müüdud' },
];
const badge = (s: string) => (s === 'Vaba' ? 'free' : s === 'Müüdud' ? 'sold' : 'held');
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1b0200" />
    <title>drealm — digistuudio Tallinnas (kavand)</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- NAV -->
    <header class="nav" data-nav>
      <div class="nav-in">
        <a href="/uus" class="brand" aria-label="drealm avaleht"><Logo /></a>
        <nav class="nav-pill" aria-label="Peamenüü">
          <a href="#teenused">Teenused</a>
          <a href="#miks">Miks drealm</a>
          <a href="#kontakt">Tasuta ülevaade</a>
          <a href="mailto:info@drealm.ee">Kontakt</a>
        </nav>
        <div class="nav-right">
          <span class="lang" aria-label="Keel"><b>ET</b><a href="/en">EN</a></span>
          <a class="nav-cta" href="#kontakt">Alusta projekti <span class="box"><Icon name="arrow" size={14} /></span></a>
          <button class="nav-toggle" aria-label="Ava menüü" aria-expanded="false" data-nav-toggle><span></span><span></span></button>
        </div>
      </div>
      <nav class="nav-sheet" aria-label="Mobiilimenüü">
        <a href="#teenused">Teenused</a>
        <a href="#miks">Miks drealm</a>
        <a href="#kontakt">Tasuta ülevaade</a>
        <a href="mailto:info@drealm.ee">Kontakt</a>
        <a href="/en">English</a>
      </nav>
    </header>

    <main>
      <!-- HERO -->
      <section class="stage">
        <div class="stage-card">
          <canvas class="stage-gl" data-gl aria-hidden="true"></canvas>
          <div class="stage-shade" aria-hidden="true"></div>
          <div class="stage-content">
            <p class="stage-kicker">drealm · digistuudio Tallinnas</p>
            <span class="stage-mark" aria-hidden="true"><Icon name="spark" size={58} /></span>
            <h1>Kodulehed, mis näevad välja sama head kui sinu teenus.</h1>
            <p class="stage-lead">Veebilehed, turundus ja AI ühest kohast. Disainime, ehitame ja paneme tööle.</p>
            <a class="cta-glow" href="#kontakt"><span class="box"><Icon name="arrow" size={16} /></span>Broneeri tasuta kõne</a>
          </div>
          <ul class="stage-tags" aria-label="Teenused">
            {pains.map((p) => <li><a href={`#${p.id}`}>{p.svc}</a></li>)}
          </ul>
        </div>
      </section>

      <!-- STATEMENT -->
      <section class="intro" aria-labelledby="intro-h">
        <div class="wrap">
          <p class="chip"><Icon name="spark" size={14} />Mida teeme</p>
          <h2 id="intro-h" class="reveal-text" data-reveal>
            {statement.split(' ').map((w) => <span>{w} </span>)}
          </h2>
          <div class="pillars">
            {
              pillars.map((p, i) => (
                <a class="pillar" href={i === 0 ? '#veebilehed' : i === 1 ? '#seo' : '#automatiseerimine'} data-glow>
                  <span class="ibox"><Icon name={p.icon} size={22} /></span>
                  <span class="pillar-n">0{i + 1}</span>
                  <h3>{p.name}</h3>
                  <p>{p.text}</p>
                  <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
                  <span class="pillar-go">Vaata <Icon name="arrow" size={16} /></span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PAINS -->
      <section class="pains" aria-labelledby="pains-h">
        <div class="dark-card">
          <div class="pains-grid">
            <div class="pains-head">
              <p class="chip on-dark"><Icon name="chat" size={14} />Kliendid ütlevad meile</p>
              <h2 id="pains-h" class="grad-dark">Kõlab tuttavalt?</h2>
              <p class="pains-sub">Iga lause taga on probleem, mille oleme juba lahendanud. Vali see, mis kõige rohkem kripeldab.</p>
              <a class="btn-glass" href="#kontakt"><span>Räägime sellest</span><Icon name="arrow" size={16} /></a>
            </div>
            <ul class="pain-list">
              {
                pains.map((p, i) => (
                  <li>
                    <a href={`#${p.id}`}>
                      <span class="pain-n">{String(i + 1).padStart(2, '0')}</span>
                      <q>{p.q}</q>
                      <span class="pain-svc">
                        {p.svc}
                        <Icon name="arrow" size={16} />
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- SERVICES -->
      <section class="services" id="teenused">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <p class="chip"><Icon name="stack" size={14} />Teenused</p>
              <h2 class="grad">Üheksa teenust. Üks tiim.</h2>
            </div>
            <p>Võta üks või lase meil kogu veebipool enda kanda võtta. Iga teenuse juures näed, kuidas see päriselt välja näeb.</p>
          </div>

          <div class="bento">
            <!-- 1 Veebilehed -->
            <article class="tile t-web" id="veebilehed" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="web" size={22} /></span>
                <span class="tag">Veeb</span>
                <h3>Veebilehed</h3>
                <p>Koduleht, mida julged kõigile saata. Disain sinu brändi järgi, kiire telefonis ja Google’i jaoks korras. Sisu muudad ise.</p>
              </header>
              <div class="vis">
                <div class="seg" role="tablist" aria-label="Disaini vaated">
                  <button role="tab" aria-selected="true" data-view="desktop">Arvuti</button>
                  <button role="tab" aria-selected="false" data-view="mobile">Mobiil</button>
                  <button role="tab" aria-selected="false" data-view="system">Stiil</button>
                </div>
                <div class="view is-active" data-view="desktop">
                  <div class="browser">
                    <div class="browser-bar"><i></i><i></i><i></i><span>atelier-nord.ee</span></div>
                    <div class="nord">
                      <div class="nord-nav"><b>Atelier Nord</b><span>Menüü</span><span>Broneeri</span></div>
                      <div class="nord-hero">
                        <div><small>Restoran · Kalamaja</small><h4>Põhjamaine köök, aeglaselt tehtud.</h4><span class="mini-btn">Broneeri laud</span></div>
                        <div class="plate"><i></i><i></i><i></i></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="mobile">
                  <div class="phones">
                    <div class="phone sm">
                      <div class="nord-m"><b>Atelier Nord</b><div class="plate sm"><i></i><i></i><i></i></div><h4>Põhjamaine köök, aeglaselt tehtud.</h4><span class="mini-btn">Broneeri laud</span></div>
                    </div>
                    <div class="phone sm">
                      <div class="nord-m"><b>Broneeri</b><div class="field"><small>Kuupäev</small>R, 17. okt</div><div class="field"><small>Kell</small>19:30</div><div class="field"><small>Inimesi</small>4</div><span class="mini-btn full">Kinnita</span></div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="system">
                  <div class="system">
                    <p class="sys-aa">Aa</p>
                    <div class="sys-sw"><span style="background:#1b0200"></span><span style="background:#4c0f05"></span><span style="background:#a21e02"></span><span style="background:#ce8c71"></span><span style="background:#e4ded3"></span></div>
                    <div class="sys-btns"><span class="mini-btn">Esmane</span><span class="mini-btn ghost">Teisene</span></div>
                  </div>
                </div>
              </div>
            </article>

            <!-- 2 Platvormid -->
            <article class="tile t-plat dark" id="platvormid" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="plan" size={22} /></span>
                <span class="tag">Veeb</span>
                <h3>Platvormid</h3>
                <p>Kui tavalisest kodulehest jääb väheks: korterivalik arendusele, broneerimine või kliendiportaal.</p>
              </header>
              <div class="vis">
                <div class="re">
                  <svg class="plan" viewBox="0 0 320 200" role="img" aria-label="Korruseplaan">
                    <rect x="6" y="6" width="308" height="188" rx="8" class="plan-outline" />
                    <g class="units">
                      <rect data-unit="A1" x="12" y="12" width="98" height="92" rx="6" />
                      <rect data-unit="A2" x="116" y="12" width="118" height="92" rx="6" />
                      <rect data-unit="A3" x="240" y="12" width="68" height="92" rx="6" />
                      <rect data-unit="A4" x="12" y="110" width="176" height="78" rx="6" />
                    </g>
                    <rect x="194" y="110" width="114" height="78" rx="6" class="core" />
                    <g class="labels"><text x="61" y="62">A1</text><text x="175" y="62">A2</text><text x="274" y="62">A3</text><text x="100" y="153">A4</text></g>
                  </svg>
                  <table class="units-table">
                    <tbody>
                      {
                        units.map((u) => (
                          <tr data-unit={u.id}>
                            <td>{u.id}</td>
                            <td>{u.rooms} tuba</td>
                            <td>{u.m2} m²</td>
                            <td>
                              <span class:list={['badge', badge(u.status)]}>{u.status}</span>
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            </article>

            <!-- 3 SEO -->
            <article class="tile t-seo" id="seo" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="rank" size={22} /></span>
                <span class="tag">Turundus</span>
                <h3>SEO</h3>
                <p>Et Google’is leitaks sind, mitte konkurenti. Iga kuu näed, mis see tõi.</p>
              </header>
              <div class="vis">
                <div class="serp">
                  <div class="serp-q"><Icon name="search" size={14} />hambaarst kesklinn</div>
                  <div class="serp-r top">
                    <small>kesklinnahambakliinik.ee</small><b>Kesklinna Hambakliinik · Broneeri aeg</b>
                    <span class="stars"><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /> Avatud täna 8–20</span>
                  </div>
                  <div class="serp-r"><small>naidis.ee</small><b>Hambaravi Tallinnas</b></div>
                  <div class="serp-r"><small>naidis2.ee</small><b>Hambaarstid kesklinnas</b></div>
                  <svg class="spark-chart" viewBox="0 0 200 60" aria-hidden="true"><defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a21e02" stop-opacity=".28" /><stop offset="1" stop-color="#a21e02" stop-opacity="0" /></linearGradient></defs><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4 V60 H0Z" fill="url(#sg)" /><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4" class="line" /></svg>
                </div>
              </div>
            </article>

            <!-- 4 Meta reklaamid -->
            <article class="tile t-meta" id="meta" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="target" size={22} /></span>
                <span class="tag">Turundus</span>
                <h3>Meta reklaamid</h3>
                <p>Facebooki ja Instagrami reklaam, mis toob päringuid, mitte laike. Iga kuu ütleme ausalt, mis töötas.</p>
              </header>
              <div class="vis">
                <div class="meta">
                  <div class="phone xs">
                    <div class="ig">
                      <div class="ig-head"><i></i><div><b>savi.stuudio</b><small>Sponsitud</small></div></div>
                      <div class="ig-media"><span class="vase"></span><span class="vase two"></span></div>
                      <div class="ig-cta">Osta nüüd <Icon name="arrow" size={12} /></div>
                    </div>
                  </div>
                  <div class="report">
                    <small>Kuu kokkuvõte · näidis</small>
                    <div class="rep-row"><span>Reklaam A</span><i style="--w:84%"></i><b>21</b></div>
                    <div class="rep-row"><span>Reklaam B</span><i style="--w:56%"></i><b>14</b></div>
                    <div class="rep-row off"><span>Reklaam C</span><i style="--w:12%"></i><b>3</b></div>
                    <p>päringut · C peatatud, raha A-le</p>
                  </div>
                </div>
              </div>
            </article>

            <!-- 5 Reklaampildid -->
            <article class="tile t-ads" id="reklaampildid" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="frame" size={22} /></span>
                <span class="tag">Turundus</span>
                <h3>Reklaampildid</h3>
                <p>Postitused ja reklaamid kõigis formaatides, ühes stiilis. Sina ei pea midagi välja mõtlema.</p>
              </header>
              <div class="vis">
                <div class="creatives">
                  <div class="cr sq"><small>1:1</small><b>Sügisel −20%</b><em>savi.stuudio</em></div>
                  <div class="cr pt"><small>4:5</small><b>Uus kollektsioon</b><em>Atelier Nord</em></div>
                  <div class="cr st"><small>9:16</small><b>Avatud uksed</b><em>Kalaranna</em></div>
                </div>
              </div>
            </article>

            <!-- 6 AI videoreklaamid -->
            <article class="tile t-video dark" id="video" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="play" size={22} /></span>
                <span class="tag">AI</span>
                <h3>AI videoreklaamid</h3>
                <p>15-sekundiline videoreklaam ilma võttepäevata. Valmis päevadega.</p>
              </header>
              <div class="vis">
                <div class="video">
                  <div class="frame">
                    <div class="footage"><Building class="v-art" /></div>
                    <span class="rec"><i></i>AI · 0:15</span>
                    <p class="cap"><span>Merevaade.</span><span>Valmib 2027.</span><span>Broneeri nüüd.</span></p>
                    <div class="scrub"><i></i></div>
                  </div>
                  <ul class="scenes"><li class="on">Stseen 1</li><li>Stseen 2</li><li>Stseen 3</li><li>Logo</li></ul>
                </div>
              </div>
            </article>

            <!-- 7 AI automatiseerimine -->
            <article class="tile t-auto" id="automatiseerimine" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="flow" size={22} /></span>
                <span class="tag">AI</span>
                <h3>AI automatiseerimine</h3>
                <p>Päringud, pakkumised ja arved liiguvad ise. Sina vaatad üle ja vajutad „saada“.</p>
              </header>
              <div class="vis">
                <div class="flow" data-flow>
                  <div class="flow-step" data-step="0"><span class="ico"><Icon name="mail" size={18} /></span><div><strong>Päring saabub</strong><small>„Soovime pakkumist fassaadile…“</small></div></div>
                  <div class="flow-line"><i></i></div>
                  <div class="flow-step" data-step="1"><span class="ico"><Icon name="spark" size={18} /></span><div><strong>AI liigitab</strong><small>Fassaad · ~420 m² · kõrge prioriteet</small></div></div>
                  <div class="flow-line"><i></i></div>
                  <div class="flow-split">
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="doc" size={18} /></span><div><strong>Pakkumine</strong><small>Mustand valmis</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="stack" size={18} /></span><div><strong>CRM</strong><small>Kirje lisatud</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="bell" size={18} /></span><div><strong>Teavitus</strong><small>Sinu telefoni</small></div></div>
                  </div>
                </div>
              </div>
            </article>

            <!-- 8 AI koolitused -->
            <article class="tile t-course" id="koolitused" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="learn" size={22} /></span>
                <span class="tag">AI</span>
                <h3>AI koolitused</h3>
                <p>Töötuba teie oma ülesannetega. Järgmisel päeval kasutab tiim AI-d päriselt.</p>
              </header>
              <div class="vis">
                <div class="course">
                  <div class="course-top"><b>AI igapäevatöös</b><span>3 / 5</span></div>
                  <div class="bar"><i></i></div>
                  <ul>
                    <li class="done">ChatGPT ja Claude: põhitõed</li>
                    <li class="done">Kirjad ja pakkumised 5 minutiga</li>
                    <li class="done">Tabelid ja raportid</li>
                    <li class="now">Oma töövoogude automatiseerimine</li>
                    <li>Turvalisus ja andmed</li>
                  </ul>
                </div>
              </div>
            </article>

            <!-- 9 Sinu ettevõtte AI -->
            <article class="tile t-pai dark" id="ettevotte-ai" data-glow>
              <header class="tile-head">
                <span class="ibox"><Icon name="chat" size={22} /></span>
                <span class="tag">AI</span>
                <h3>Sinu ettevõtte AI</h3>
                <p>Assistent, kes teab su hinnakirja, lepinguid ja juhendeid. Andmed jäävad sulle.</p>
              </header>
              <div class="vis">
                <div class="chat">
                  <div class="msg me">Koosta Kalaranna pakkumine eelmise malli põhjal.</div>
                  <div class="msg ai">
                    <span class="ai-av"><Icon name="spark" size={12} /></span>
                    <div>
                      Valmis. Kasutasin 2026. aasta hinnakirja ja eelmist pakkumist. Kas saadan Martinile üle vaatamiseks?
                      <div class="src"><span><Icon name="doc" size={12} />Hinnakiri_2026.xlsx</span><span><Icon name="doc" size={12} />Pakkumine_Merivälja.pdf</span></div>
                    </div>
                  </div>
                  <div class="chat-in"><span>Küsi midagi oma ettevõtte kohta…</span><i><Icon name="up" size={16} /></i></div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- WHY -->
      <section class="why" id="miks">
        <div class="wrap">
          <div class="why-grid">
            <figure class="why-photo">
              <Image src={whyPhoto} alt="Disainer näitab pagariäri omanikule sülearvutis uut kodulehte" widths={[640, 960, 1260]} sizes="(max-width: 960px) 92vw, 52vw" />
              <figcaption><span class="dot"></span>Kohtume ka sinu juures</figcaption>
            </figure>
            <div class="why-copy">
              <p class="chip"><Icon name="check" size={14} />Miks drealm</p>
              <h2>Väike stuudio. Otsekontakt. Ei mingit agentuuride ahelat.</h2>
              <div class="why-cards">
                <div class="why-card" data-glow>
                  <span class="ibox"><Icon name="chat" size={20} /></span>
                  <div><h3>Räägid tegijaga</h3><p>Sama inimene, kes kuulab sinu muret, teeb ka disaini ja arenduse.</p></div>
                </div>
                <div class="why-card" data-glow>
                  <span class="ibox"><Icon name="doc" size={20} /></span>
                  <div><h3>Hind enne tööd</h3><p>Fikseeritud hind kirjalikult. Üllatusarveid ei tule.</p></div>
                </div>
                <div class="why-card" data-glow>
                  <span class="ibox"><Icon name="stack" size={20} /></span>
                  <div><h3>Kõik on sinu oma</h3><p>Domeen, kood ja sisu kuuluvad sulle. Lahkuda saad millal tahes.</p></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER / CTA -->
    <footer class="foot" id="kontakt">
      <div class="dark-card foot-card">
        <canvas class="stage-gl" data-gl aria-hidden="true"></canvas>
        <div class="foot-shade" aria-hidden="true"></div>
        <div class="foot-grid">
          <div>
            <p class="chip on-dark"><Icon name="spark" size={14} />Tasuta kodulehe ülevaade</p>
            <h2>Saada aadress. Ülejäänu teeme meie.</h2>
            <p class="foot-sub">5-minutiline video sinu kodulehest: mis töötab, mis mitte ja mida parandada esimesena. Ühe tööpäeva jooksul, tasuta.</p>
            <p class="foot-mail">Või kirjuta otse: <a href="mailto:info@drealm.ee">info@drealm.ee</a></p>
          </div>
          <div class="glass-form">
            <AuditForm dark page="/uus#footer" />
          </div>
        </div>
        <div class="foot-bottom">
          <Logo />
          <nav aria-label="Jaluse menüü">
            <a href="#teenused">Teenused</a>
            <a href="#miks">Miks drealm</a>
            <a href="/privaatsus">Privaatsus</a>
          </nav>
          <span>© 2026 drealm · Tallinn</span>
        </div>
      </div>
    </footer>

    <script>
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Nav: sits inside the hero, turns into a solid bar after it
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const onScroll = () => nav.classList.toggle('solid', scrollY > innerHeight * 0.55);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav.querySelectorAll('.nav-sheet a').forEach((a) => a.addEventListener('click', () => nav.classList.remove('open')));

      // 3D scenes (hero + footer)
      const canvases = document.querySelectorAll<HTMLCanvasElement>('[data-gl]');
      if (canvases.length) import('../scripts/hero-scene').then((m) => canvases.forEach((c) => m.mountHeroScene(c)));

      // Statement: words light up as the paragraph scrolls through the viewport
      const reveal = document.querySelector<HTMLElement>('[data-reveal]');
      if (reveal) {
        const words = [...reveal.querySelectorAll('span')];
        const update = () => {
          const r = reveal.getBoundingClientRect();
          const p = reduceMotion ? 1 : Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35)));
          const lit = Math.round(p * words.length);
          words.forEach((w, i) => w.classList.toggle('on', i < lit));
        };
        addEventListener('scroll', update, { passive: true });
        update();
      }

      // Cursor-following glow on cards
      document.querySelectorAll<HTMLElement>('[data-glow]').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      // Free review forms
      document.querySelectorAll<HTMLFormElement>('[data-audit]').forEach((form) => {
        form.querySelector<HTMLInputElement>('[data-ts]')!.value = String(Date.now());
        const status = form.querySelector('.audit-status')!;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const btn = form.querySelector('button')!;
          btn.disabled = true;
          try {
            const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
            if (!res.ok) throw new Error();
            form.reset();
            status.textContent = 'Aitäh! Saadame ülevaate ühe tööpäeva jooksul.';
          } catch {
            status.textContent = 'Saatmine ebaõnnestus. Kirjuta palun info@drealm.ee';
          } finally {
            btn.disabled = false;
          }
        });
      });

      // Design view tabs
      document.querySelectorAll<HTMLButtonElement>('.seg [data-view]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const root = tab.closest('.vis')!;
          root.querySelectorAll('.seg [data-view]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          root.querySelectorAll<HTMLElement>('.view').forEach((v) => v.classList.toggle('is-active', v.dataset.view === tab.dataset.view));
        });
      });

      // Floor plan <-> table highlight
      const re = document.querySelector('.re');
      re?.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
        const on = (v: boolean) => re.querySelectorAll(`[data-unit="${el.dataset.unit}"]`).forEach((x) => x.classList.toggle('hl', v));
        el.addEventListener('mouseenter', () => on(true));
        el.addEventListener('mouseleave', () => on(false));
      });

      // AI flow + video scenes step through in sequence
      const flow = document.querySelector('[data-flow]');
      const scenes = document.querySelectorAll('.scenes li');
      if (!reduceMotion) {
        let step = 0;
        setInterval(() => {
          flow?.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => s.classList.toggle('lit', Number(s.dataset.step) <= step));
          scenes.forEach((s, i) => s.classList.toggle('on', i === step));
          step = (step + 1) % 4;
        }, 1100);
      } else {
        flow?.querySelectorAll('[data-step]').forEach((s) => s.classList.add('lit'));
      }
    </script>
  </body>
</html>

