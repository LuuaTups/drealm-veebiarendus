---
// Uue avalehe kavand (ainult ET). Pole sitemapis ega indekseeritud, kuni disain on kinnitatud.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/instrument-sans/index.css';
import Logo from '../components/Logo.astro';
import Building from '../components/mock/Building.astro';
import Icon from '../components/mock/Icon.astro';
import AuditForm from '../components/AuditForm.astro';
import whyPhoto from '../assets/photos/pagariari.jpg';
import { Image } from 'astro:assets';

const pains = [
  { id: 'veebilehed', q: 'Meie koduleht on 2015. aastast ja ma ei julge linki kellelegi saata.', svc: 'Veebilehed' },
  { id: 'seo', q: 'Google’is leiavad kliendid konkurendi, mitte meid.', svc: 'SEO' },
  { id: 'meta', q: 'Reklaamile läheb raha, aga keegi ei oska öelda, mis see tagasi tõi.', svc: 'Meta reklaamid' },
  { id: 'reklaampildid', q: 'Instagrami postitused jäävad tegemata, sest pole aega ega pilte.', svc: 'Reklaampildid' },
  { id: 'video', q: 'Videoreklaam oleks hea, aga võttepäev maksab rohkem kui reklaam ise.', svc: 'AI videoreklaamid' },
  { id: 'platvormid', q: 'Ostjad helistavad, et küsida, millised korterid on veel vabad.', svc: 'Platvormid' },
  { id: 'automatiseerimine', q: 'Pool päeva läheb e-kirjadele, pakkumistele ja arvetele.', svc: 'AI automatiseerimine' },
  { id: 'koolitused', q: 'Kõik räägivad AI-st, aga meie tiimis ei kasuta seda keegi.', svc: 'AI koolitused' },
  { id: 'ettevotte-ai', q: 'Samadele küsimustele vastan iga päev uuesti.', svc: 'Sinu ettevõtte AI' },
];

const units = [
  { id: 'A1', rooms: 2, m2: '54,2', status: 'Vaba' },
  { id: 'A2', rooms: 3, m2: '78,6', status: 'Broneeritud' },
  { id: 'A3', rooms: 1, m2: '36,8', status: 'Vaba' },
  { id: 'A4', rooms: 4, m2: '96,1', status: 'Müüdud' },
];
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>drealm — veebistuudio (kavand)</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- NAV -->
    <header class="nav" data-nav>
      <div class="wrap nav-in">
        <a href="/uus" class="brand" aria-label="drealm avaleht"><Logo /></a>
        <nav class="nav-links" aria-label="Peamenüü">
          <a href="#teenused">Teenused</a>
          <a href="#miks">Miks drealm</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
        <a class="nav-mail" href="mailto:info@drealm.ee">info@drealm.ee</a>
        <a class="nav-cta" href="#ulevaade">Tasuta ülevaade</a>
        <button class="nav-toggle" aria-label="Ava menüü" aria-expanded="false" data-nav-toggle><span></span><span></span></button>
      </div>
      <nav class="nav-sheet" aria-label="Mobiilimenüü">
        <a href="#teenused">Teenused</a>
        <a href="#miks">Miks drealm</a>
        <a href="#kontakt">Kontakt</a>
        <a href="#ulevaade" class="btn btn-dark"><span>Tasuta ülevaade</span><Icon name="arrow" size={18} /></a>
      </nav>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero" id="ulevaade">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="kicker">Tasuta kodulehe ülevaade</p>
            <h1>Ütleme sulle tasuta, miks su koduleht kliente ei too.</h1>
            <p class="hero-lead">
              Saada oma kodulehe aadress. Ühe tööpäeva jooksul saad 5-minutilise video: mis lehel töötab, mis mitte ja mida
              parandada esimesena.
            </p>
            <AuditForm page="/uus#hero" />
            <ul class="assure">
              <li><Icon name="check" size={16} />Tasuta, ilma kohustuseta</li>
              <li><Icon name="check" size={16} />Teeb disainer, mitte robot</li>
              <li><Icon name="check" size={16} />Valmis 24 h jooksul</li>
            </ul>
          </div>

          <div class="review" aria-hidden="true">
            <div class="browser">
              <div class="browser-bar"><i></i><i></i><i></i><span>metsjakivi.ee</span></div>
              <div class="old">
                <div class="old-top"><b>METS &amp; KIVI EHITUS OÜ</b><span>Avaleht | Teenused | Galerii | Meist | Kontakt</span></div>
                <div class="old-banner"><span>TERE TULEMAST MEIE KODULEHELE!</span></div>
                <div class="old-cols">
                  <div><i></i><i></i><i></i></div>
                  <div><i></i><i></i><i></i></div>
                  <div><i></i><i></i></div>
                </div>
                <div class="old-foot">Copyright © 2015 · Kõik õigused kaitstud</div>
                <span class="pin p1">1</span>
                <span class="pin p2">2</span>
                <span class="pin p3">3</span>
              </div>
              <div class="player">
                <span class="play"></span>
                <div class="track"><i class="prog"></i><em style="left:18%"></em><em style="left:47%"></em><em style="left:76%"></em></div>
                <span class="time">2:14 / 5:03</span>
              </div>
            </div>
            <div class="note n1"><b>1</b>5 sekundiga pole selge, mida te pakute</div>
            <div class="note n2"><b>2</b>Telefonis ei mahu nupp ekraanile</div>
            <div class="note n3"><b>3</b>Pole ühtegi põhjust kohe helistada</div>
            <p class="review-label">Näidis: nii ülevaade välja näeb</p>
          </div>
        </div>
      </section>

      <!-- PAINS -->
      <section class="pains" aria-labelledby="pains-h">
        <div class="wrap">
          <h2 id="pains-h">Kõlab tuttavalt?</h2>
          <ul class="pain-list">
            {
              pains.map((p) => (
                <li>
                  <a href={`#${p.id}`}>
                    <q>{p.q}</q>
                    <span class="pain-svc">
                      {p.svc}
                      <Icon name="arrow" size={18} />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- SERVICES BENTO -->
      <section class="bento-sec" id="teenused">
        <div class="wrap">
          <div class="sec-head">
            <h2>Mida teeme</h2>
            <p>Üheksa teenust. Võta üks või lase meil kogu veebipool enda kanda võtta.</p>
          </div>

          <div class="bento">
            <!-- 1 Veebilehed -->
            <article class="tile t-web" id="veebilehed">
              <header><span class="tag">Veeb</span><Icon name="web" size={26} class="tile-ic" /><h3>Veebilehed</h3><p>Koduleht, mida julged kõigile saata. Disain sinu brändi järgi, kiire telefonis ja Google’i jaoks korras. Sisu muudad ise.</p></header>
              <div class="vis">
                <div class="tabs" role="tablist" aria-label="Disaini vaated">
                  <button role="tab" aria-selected="true" data-view="desktop">Arvuti</button>
                  <button role="tab" aria-selected="false" data-view="mobile">Mobiil</button>
                  <button role="tab" aria-selected="false" data-view="system">Stiil</button>
                </div>
                <div class="view is-active" data-view="desktop">
                  <div class="browser">
                    <div class="browser-bar"><i></i><i></i><i></i><span>atelier-nord.ee</span></div>
                    <div class="nord">
                      <div class="nord-nav"><b>Atelier Nord</b><span>Menüü</span><span>Broneeri</span></div>
                      <div class="nord-hero">
                        <div><small>Restoran · Kalamaja</small><h4>Põhjamaine köök, aeglaselt tehtud.</h4><span class="pill-dark">Broneeri laud</span></div>
                        <div class="plate"><i></i><i></i><i></i></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="mobile">
                  <div class="phones">
                    <div class="phone sm">
                      <div class="nord-m"><b>Atelier Nord</b><div class="plate sm"><i></i><i></i><i></i></div><h4>Põhjamaine köök, aeglaselt tehtud.</h4><span class="pill-dark">Broneeri laud</span></div>
                    </div>
                    <div class="phone sm">
                      <div class="nord-m"><b>Broneeri</b><div class="field"><small>Kuupäev</small>R, 17. okt</div><div class="field"><small>Kell</small>19:30</div><div class="field"><small>Inimesi</small>4</div><span class="pill-dark full">Kinnita</span></div>
                    </div>
                  </div>
                </div>
                <div class="view" data-view="system">
                  <div class="system">
                    <p class="sys-aa">Aa</p>
                    <div class="sys-sw"><span style="background:#1c1a16"></span><span style="background:#3f4a32"></span><span style="background:#a85f35"></span><span style="background:#e7dccb"></span></div>
                    <div class="sys-btns"><span class="pill-dark">Esmane</span><span class="pill-line">Teisene</span></div>
                  </div>
                </div>
              </div>
            </article>

            <!-- 2 Platvormid -->
            <article class="tile t-plat dark" id="platvormid">
              <header><span class="tag">Veeb</span><Icon name="plan" size={26} class="tile-ic" /><h3>Platvormid</h3><p>Kui tavalisest kodulehest jääb väheks: korterivalik arendusele, broneerimine või kliendiportaal.</p></header>
              <div class="vis">
                <div class="re">
                  <svg class="plan" viewBox="0 0 320 200" role="img" aria-label="Korruseplaan">
                    <rect x="6" y="6" width="308" height="188" rx="2" class="plan-outline" />
                    <g class="units">
                      <rect data-unit="A1" x="10" y="10" width="100" height="96" />
                      <rect data-unit="A2" x="114" y="10" width="120" height="96" />
                      <rect data-unit="A3" x="238" y="10" width="72" height="96" />
                      <rect data-unit="A4" x="10" y="110" width="180" height="80" />
                    </g>
                    <rect x="194" y="110" width="116" height="80" class="core" />
                    <g class="labels"><text x="60" y="62">A1</text><text x="174" y="62">A2</text><text x="274" y="62">A3</text><text x="100" y="154">A4</text></g>
                  </svg>
                  <table class="units-table">
                    <tbody>
                      {
                        units.map((u) => (
                          <tr data-unit={u.id}>
                            <td>{u.id}</td>
                            <td>{u.rooms} tuba</td>
                            <td>{u.m2} m²</td>
                            <td>
                              <span class:list={['badge', u.status === 'Vaba' ? 'free' : u.status === 'Müüdud' ? 'sold' : 'held']}>{u.status}</span>
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            </article>

            <!-- 3 SEO -->
            <article class="tile t-seo" id="seo">
              <header><span class="tag">Turundus</span><Icon name="rank" size={26} class="tile-ic" /><h3>SEO</h3><p>Et Google’is leitaks sind, mitte konkurenti. Otsing ja kaardid korda ning iga kuu näed, mis see tõi.</p></header>
              <div class="vis">
                <div class="serp">
                  <div class="serp-q"><Icon name="search" size={14} />hambaarst kesklinn</div>
                  <div class="serp-r top"><small>kesklinnahambakliinik.ee</small><b>Kesklinna Hambakliinik · Broneeri aeg</b><span class="stars"><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /><Icon name="star" size={11} /> Avatud täna 8–20</span></div>
                  <div class="serp-r"><small>naidis.ee</small><b>Hambaravi Tallinnas</b></div>
                  <div class="serp-r"><small>naidis2.ee</small><b>Hambaarstid kesklinnas</b></div>
                  <svg class="spark-chart" viewBox="0 0 200 60" aria-hidden="true"><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4 V60 H0Z" class="fill" /><path d="M0 52 C30 50 45 46 70 40 S110 30 130 22 S170 10 200 4" /></svg>
                </div>
              </div>
            </article>

            <!-- 4 Meta reklaamid -->
            <article class="tile t-meta" id="meta">
              <header><span class="tag">Turundus</span><Icon name="target" size={26} class="tile-ic" /><h3>Meta reklaamid</h3><p>Facebooki ja Instagrami reklaam, mis toob päringuid, mitte laike. Iga kuu ütleme ausalt, mis töötas.</p></header>
              <div class="vis">
                <div class="meta">
                  <div class="phone xs">
                    <div class="ig">
                      <div class="ig-head"><i class="c2"></i><div><b>savi.stuudio</b><small>Sponsitud</small></div></div>
                      <div class="ig-media ceramic"><span class="vase"></span><span class="vase two"></span></div>
                      <div class="ig-cta">Osta nüüd <Icon name="arrow" size={12} /></div>
                    </div>
                  </div>
                  <div class="report">
                    <small>Kuu kokkuvõte · näidis</small>
                    <div class="rep-row"><span>Reklaam A</span><i style="--w:84%"></i><b>21</b></div>
                    <div class="rep-row"><span>Reklaam B</span><i style="--w:56%"></i><b>14</b></div>
                    <div class="rep-row off"><span>Reklaam C</span><i style="--w:12%"></i><b>3</b></div>
                    <p>päringut · C peatatud, raha A-le</p>
                  </div>
                </div>
              </div>
            </article>

            <!-- 5 Reklaampildid -->
            <article class="tile t-ads" id="reklaampildid">
              <header><span class="tag">Turundus</span><Icon name="frame" size={26} class="tile-ic" /><h3>Reklaampildid</h3><p>Postitused ja reklaamid kõigis formaatides, ühes stiilis. Sina ei pea midagi välja mõtlema.</p></header>
              <div class="vis">
                <div class="creatives">
                  <div class="cr sq"><small>1:1</small><b>Sügisel −20%</b><em>savi.stuudio</em></div>
                  <div class="cr pt"><small>4:5</small><b>Uus kollektsioon</b><em>Atelier Nord</em></div>
                  <div class="cr st"><small>9:16</small><b>Avatud uksed</b><em>Kalaranna</em></div>
                </div>
              </div>
            </article>

            <!-- 6 AI videoreklaamid -->
            <article class="tile t-video dark" id="video">
              <header><span class="tag">AI</span><Icon name="play" size={26} class="tile-ic" /><h3>AI videoreklaamid</h3><p>15-sekundiline videoreklaam ilma võttepäevata. Valmis päevadega.</p></header>
              <div class="vis">
                <div class="video">
                  <div class="frame">
                    <div class="footage"><Building class="v-art" /></div>
                    <span class="rec"><i></i>AI · 0:15</span>
                    <p class="cap"><span>Merevaade.</span><span>Valmib 2027.</span><span>Broneeri nüüd.</span></p>
                    <div class="scrub"><i></i></div>
                  </div>
                  <ul class="scenes"><li class="on">Stseen 1</li><li>Stseen 2</li><li>Stseen 3</li><li>Logo</li></ul>
                </div>
              </div>
            </article>

            <!-- 7 AI automatiseerimine -->
            <article class="tile t-auto" id="automatiseerimine">
              <header><span class="tag">AI</span><Icon name="flow" size={26} class="tile-ic" /><h3>AI automatiseerimine</h3><p>Päringud, pakkumised ja arved liiguvad ise. Sina vaatad üle ja vajutad „saada“.</p></header>
              <div class="vis">
                <div class="flow" data-flow>
                  <div class="flow-step" data-step="0"><span class="ico"><Icon name="mail" size={18} /></span><div><strong>Päring saabub</strong><small>„Soovime pakkumist fassaadile…“</small></div></div>
                  <div class="flow-line"></div>
                  <div class="flow-step" data-step="1"><span class="ico"><Icon name="spark" size={18} /></span><div><strong>AI liigitab</strong><small>Fassaad · ~420 m² · kõrge prioriteet</small></div></div>
                  <div class="flow-line"></div>
                  <div class="flow-split">
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="doc" size={18} /></span><div><strong>Pakkumine</strong><small>Mustand valmis</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="stack" size={18} /></span><div><strong>CRM</strong><small>Kirje lisatud</small></div></div>
                    <div class="flow-step" data-step="2"><span class="ico"><Icon name="bell" size={18} /></span><div><strong>Teavitus</strong><small>Sinu telefoni</small></div></div>
                  </div>
                </div>
              </div>
            </article>

            <!-- 8 AI koolitused -->
            <article class="tile t-course" id="koolitused">
              <header><span class="tag">AI</span><Icon name="learn" size={26} class="tile-ic" /><h3>AI koolitused</h3><p>Töötuba teie oma ülesannetega. Järgmisel päeval kasutab tiim AI-d päriselt.</p></header>
              <div class="vis">
                <div class="course">
                  <div class="course-top"><b>AI igapäevatöös</b><span>3 / 5</span></div>
                  <div class="bar"><i></i></div>
                  <ul>
                    <li class="done">ChatGPT ja Claude: põhitõed</li>
                    <li class="done">Kirjad ja pakkumised 5 minutiga</li>
                    <li class="done">Tabelid ja raportid</li>
                    <li class="now">Oma töövoogude automatiseerimine</li>
                    <li>Turvalisus ja andmed</li>
                  </ul>
                </div>
              </div>
            </article>

            <!-- 9 Sinu ettevõtte AI -->
            <article class="tile t-pai dark" id="ettevotte-ai">
              <header><span class="tag">AI</span><Icon name="chat" size={26} class="tile-ic" /><h3>Sinu ettevõtte AI</h3><p>Assistent, kes teab su hinnakirja, lepinguid ja juhendeid. Andmed jäävad sulle.</p></header>
              <div class="vis">
                <div class="chat">
                  <div class="msg me">Koosta Kalaranna pakkumine eelmise malli põhjal.</div>
                  <div class="msg ai">
                    Valmis. Kasutasin 2026. aasta hinnakirja ja eelmist pakkumist. Kas saadan Martinile üle vaatamiseks?
                    <div class="src"><span>Hinnakiri_2026.xlsx</span><span>Pakkumine_Merivälja.pdf</span></div>
                  </div>
                  <div class="chat-in"><span>Küsi midagi oma ettevõtte kohta…</span><i><Icon name="up" size={16} /></i></div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- WHY -->
      <section class="why" id="miks">
        <div class="wrap why-grid">
          <figure class="why-photo">
            <Image src={whyPhoto} alt="Disainer näitab pagariäri omanikule sülearvutis uut kodulehte" widths={[640, 960, 1260]} sizes="(max-width: 860px) 92vw, 44vw" />
          </figure>
          <div>
            <p class="kicker">Miks drealm</p>
            <h2>Väike stuudio. Otsekontakt. Ei mingit agentuuride ahelat.</h2>
            <dl class="why-list">
              <div><dt>Räägid tegijaga</dt><dd>Sama inimene, kes kuulab sinu muret, teeb ka disaini ja arenduse.</dd></div>
              <div><dt>Hind enne tööd</dt><dd>Fikseeritud hind kirjalikult. Üllatusarveid ei tule.</dd></div>
              <div><dt>Kõik on sinu oma</dt><dd>Domeen, kood ja sisu kuuluvad sulle. Lahkuda saad millal tahes.</dd></div>
            </dl>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot" id="kontakt">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <p class="kicker">Tasuta kodulehe ülevaade</p>
            <h2>Saada aadress. Ülejäänu teeme meie.</h2>
            <p class="foot-sub">Või kirjuta otse: <a href="mailto:info@drealm.ee">info@drealm.ee</a></p>
          </div>
          <AuditForm dark page="/uus#footer" />
        </div>
        <div class="foot-bottom">
          <Logo />
          <span>Veebistuudio · Tallinn</span>
          <span>© 2026 drealm</span>
        </div>
      </div>
    </footer>

    <script>
      // Nav: shadow on scroll + mobile sheet
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav.querySelectorAll('.nav-sheet a').forEach((a) => a.addEventListener('click', () => nav.classList.remove('open')));

      // Free review forms
      document.querySelectorAll<HTMLFormElement>('[data-audit]').forEach((form) => {
        form.querySelector<HTMLInputElement>('[data-ts]')!.value = String(Date.now());
        const status = form.querySelector('.audit-status')!;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const btn = form.querySelector('button')!;
          btn.disabled = true;
          try {
            const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
            if (!res.ok) throw new Error();
            form.reset();
            status.textContent = 'Aitäh! Saadame ülevaate ühe tööpäeva jooksul.';
          } catch {
            status.textContent = 'Saatmine ebaõnnestus. Kirjuta palun info@drealm.ee';
          } finally {
            btn.disabled = false;
          }
        });
      });

      // Design view tabs
      document.querySelectorAll<HTMLButtonElement>('.tabs [data-view]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const root = tab.closest('.vis')!;
          root.querySelectorAll('.tabs [data-view]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          root.querySelectorAll<HTMLElement>('.view').forEach((v) => v.classList.toggle('is-active', v.dataset.view === tab.dataset.view));
        });
      });

      // Floor plan <-> table highlight
      const re = document.querySelector('.re');
      re?.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
        const on = (v: boolean) => re.querySelectorAll(`[data-unit="${el.dataset.unit}"]`).forEach((x) => x.classList.toggle('hl', v));
        el.addEventListener('mouseenter', () => on(true));
        el.addEventListener('mouseleave', () => on(false));
      });

      // AI flow + video scenes step through in sequence
      const flow = document.querySelector('[data-flow]');
      const scenes = document.querySelectorAll('.scenes li');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let step = 0;
        setInterval(() => {
          flow?.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => s.classList.toggle('lit', Number(s.dataset.step) <= step));
          scenes.forEach((s, i) => s.classList.toggle('on', i === step));
          step = (step + 1) % 4;
        }, 1100);
      } else {
        flow?.querySelectorAll('[data-step]').forEach((s) => s.classList.add('lit'));
      }

    </script>
