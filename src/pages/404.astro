---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base lang="et" title="Lehte ei leitud | drealm" description="Seda lehte ei ole olemas." alternates={{ et: '/404', en: '/404' }}>
  <PageHero eyebrow="404" title="Seda lehte siin ei ole." lead="Võib-olla on aadress muutunud. Mine avalehele või vaata meie teenuseid." crumbs={[{ name: "Avaleht", href: "/" }]} />
  <section class="section">
    <div class="container">
      <p><a class="btn" href="/">Avalehele</a> &nbsp; <a href="/en">English</a></p>
    </div>
  </section>
</Base>
