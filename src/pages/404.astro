---
import V2 from '../layouts/V2.astro';
import Icon from '../components/mock/Icon.astro';
---

<V2 lang="et" title="Lehte ei leitud | drealm" description="Seda lehte ei ole olemas." alternates={{ et: '/404', en: '/404' }} noindex>
  <section class="stage">
    <div class="stage-card page-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="page-hero">
        <p class="chip on-dark"><Icon name="search" size={14} />404</p>
        <h1 class="sv-h1">Seda lehte siin ei ole.</h1>
        <p class="sv-lead">Võib-olla on aadress muutunud. This page doesn’t exist, maybe the address changed.</p>
        <div class="sv-ctas">
          <a class="cta-glow" href="/"><span class="box"><Icon name="arrow" size={16} /></span>Avalehele</a>
          <a class="btn-glass" href="/teenused"><span>Teenused</span><Icon name="arrow" size={16} /></a>
          <a class="btn-glass" href="/en"><span>English</span><Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>
  <div class="sv-last"></div>
</V2>
