---
import ServicePage from '../../views/v2/ServicePage.astro';
import { SERVICES, type Service } from '../../data/v2/services';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
---

<ServicePage s={s} lang="et" />
