---
// Uue avalehe kavand (ainult ET). Pole sitemapis ega indekseeritud, kuni disain on kinnitatud.
import V2 from '../../layouts/V2.astro';
import Icon from '../../components/mock/Icon.astro';
import ServiceMock from '../../components/v2/ServiceMock.astro';
import { SERVICES, serviceHref } from '../../data/v2/services';

const tileClass: Record<string, string> = {
  veebilehed: 't-web',
  platvormid: 't-plat dark',
  seo: 't-seo',
  meta: 't-meta',
  reklaampildid: 't-ads',
  video: 't-video dark',
  automatiseerimine: 't-auto',
  koolitused: 't-course',
  'ettevotte-ai': 't-pai dark',
};
---

<V2
  title="drealm — kodulehed, turundus ja AI ettevõtetele"
  description="Digistuudio Tallinnas: kodulehed ja platvormid, SEO ja reklaamid ning AI-lahendused ettevõtetele. Fikseeritud hind, otsekontakt."
  path="/uus"
>
  <!-- HERO -->
  <section class="stage">
    <div class="stage-card">
      <canvas class="stage-gl" data-gl aria-hidden="true"></canvas>
      <div class="stage-shade" aria-hidden="true"></div>
      <div class="stage-content">
        <p class="stage-kicker">drealm · digistuudio Tallinnas</p>
        <span class="stage-mark" aria-hidden="true"><Icon name="spark" size={58} /></span>
        <h1>Kodulehed, mis näevad välja sama head kui sinu teenus.</h1>
        <p class="stage-lead">Veebilehed, turundus ja AI ühest kohast. Disainime, ehitame ja paneme tööle.</p>
        <a class="cta-glow" href="#kontakt"><span class="box"><Icon name="arrow" size={16} /></span>Broneeri tasuta kõne</a>
      </div>
      <ul class="stage-tags" aria-label="Teenused">
        {SERVICES.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" id="teenused">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="stack" size={14} />Teenused</p>
          <h2 class="grad">Mida teeme</h2>
        </div>
        <p>Veeb, turundus ja AI. Võta üks teenus või kõik korraga. Iga ploki juures näed, kuidas see päriselt välja näeb.</p>
      </div>
      <div class="bento">
        {
          SERVICES.map((s) => (
            <article class:list={['tile', tileClass[s.id]]} id={s.id} data-glow>
              <header class="tile-head">
                <span class="ibox">
                  <Icon name={s.icon} size={22} />
                </span>
                <span class="tag">{s.group}</span>
                <h3>{s.name}</h3>
                <p>{s.short}</p>
                <a class="tile-more" href={serviceHref(s)}>
                  Vaata lähemalt <Icon name="arrow" size={15} />
                </a>
              </header>
              <ServiceMock id={s.id} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PAINS (compact) -->
  <section class="pains" id="kliendid" aria-labelledby="pains-h">
    <div class="dark-card">
      <div class="pains-compact">
        <div class="pains-top">
          <div>
            <p class="chip on-dark"><Icon name="chat" size={14} />Kliendid ütlevad meile</p>
            <h2 id="pains-h" class="grad-dark">Kõlab tuttavalt?</h2>
          </div>
          <a class="btn-glass" href="#kontakt"><span>Räägime sellest</span><Icon name="arrow" size={16} /></a>
        </div>
        <ul class="pain-grid">
          {
            SERVICES.map((s) => (
              <li>
                <a href={serviceHref(s)} data-glow>
                  <q>{s.pain}</q>
                  <span class="pain-svc">
                    {s.name}
                    <Icon name="arrow" size={14} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</V2>
