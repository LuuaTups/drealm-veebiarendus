---
import V2 from '../../../layouts/V2.astro';
import Icon from '../../../components/mock/Icon.astro';
import ServiceMock from '../../../components/v2/ServiceMock.astro';
import { SERVICES, getService, serviceHref, type Service } from '../../../data/v2/services';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const related = s.related.map(getService).filter((x): x is Service => Boolean(x));
const url = `https://drealm.ee${serviceHref(s)}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.name,
    description: s.metaDescription,
    url,
    areaServed: { '@type': 'Country', name: 'Estonia' },
    provider: { '@type': 'ProfessionalService', name: 'drealm', url: 'https://drealm.ee', email: 'info@drealm.ee' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Avaleht', item: 'https://drealm.ee/uus' },
      { '@type': 'ListItem', position: 2, name: 'Teenused', item: 'https://drealm.ee/uus/teenused' },
      { '@type': 'ListItem', position: 3, name: s.name, item: url },
    ],
  },
];
---

<V2 title={s.metaTitle} description={s.metaDescription} path={serviceHref(s)} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="stage">
    <div class="stage-card sv-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="sv-grid">
        <div class="sv-copy">
          <nav class="crumbs" aria-label="Asukoht">
            <a href="/uus">Avaleht</a><span>/</span><a href="/uus/teenused">Teenused</a><span>/</span><span aria-current="page">{s.name}</span>
          </nav>
          <p class="chip on-dark"><Icon name={s.icon} size={14} />{s.group} · {s.name}</p>
          <h1 class="sv-h1">{s.h1}</h1>
          <p class="sv-lead">{s.lead}</p>
          <div class="sv-ctas">
            <a class="cta-glow" href="#kontakt"><span class="box"><Icon name="arrow" size={16} /></span>Küsi pakkumist</a>
            <a class="btn-glass" href="#sisu"><span>Mida saad</span><Icon name="arrow" size={16} /></a>
          </div>
          <dl class="sv-facts">
            <div><dt>Hind</dt><dd>{s.priceFrom ? `alates ${s.priceFrom}` : 'Pakkumise järgi'}</dd></div>
            <div><dt>Ajakava</dt><dd>{s.timeline}</dd></div>
          </dl>
        </div>
        <div class="sv-visual">
          <ServiceMock id={s.id} />
        </div>
      </div>
    </div>
  </section>

  <!-- FOR WHO -->
  <section class="sv-sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="check" size={14} />Sulle, kui…</p>
          <h2 class="grad">Kõlab tuttavalt?</h2>
        </div>
        <p class="sv-quote">„{s.pain}“</p>
      </div>
      <div class="for-grid">
        {
          s.forWho.map((f, i) => (
            <div class="for-card" data-glow>
              <span class="for-n">0{i + 1}</span>
              <p>{f}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="sv-sec" id="sisu">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="stack" size={14} />Mida saad</p>
          <h2 class="grad">Kõik, mis kuulub asja juurde.</h2>
        </div>
        <p>Selge sisu, fikseeritud hind ja üks kontakt kogu projekti vältel.</p>
      </div>
      <div class="del-grid">
        {
          s.deliverables.map((d) => (
            <div class="del-card" data-glow>
              <span class="ibox">
                <Icon name={d.icon} size={20} />
              </span>
              <h3>{d.t}</h3>
              <p>{d.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STEPS -->
  <section class="sv-sec">
    <div class="wrap">
      <div class="steps-card">
        <div class="steps-head">
          <p class="chip"><Icon name="flow" size={14} />Kuidas see käib</p>
          <p class="steps-time"><Icon name="bell" size={16} />{s.timeline}</p>
        </div>
        <ol class="steps-row">
          {
            s.steps.map((st, i) => (
              <li>
                <span class="step-dot">{i + 1}</span>
                <h3>{st.t}</h3>
                <p>{st.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- PRICE + FAQ -->
  <section class="sv-sec">
    <div class="wrap pf-grid">
      <div class="price-card dark-card" data-glow>
        <p class="chip on-dark"><Icon name="doc" size={14} />Hind</p>
        {s.priceFrom ? (
          <p class="price-big">
            <small>alates</small>
            {s.priceFrom}
          </p>
        ) : (
          <p class="price-big sm">Pakkumise järgi</p>
        )}
        <p class="price-note">{s.priceNote}</p>
        <ul class="price-incl">
          <li><Icon name="check" size={16} />Fikseeritud hind kirjalikult</li>
          <li><Icon name="check" size={16} />Tasuta esimene kõne</li>
          <li><Icon name="check" size={16} />Kõik jääb sinu omaks</li>
        </ul>
        <a class="btn btn-light" href="#kontakt"><span>Küsi pakkumist</span><Icon name="arrow" size={18} /></a>
      </div>
      <div class="faq">
        <p class="chip"><Icon name="chat" size={14} />Korduma kippuvad küsimused</p>
        {
          s.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <span class="faq-ic">
                  <Icon name="plus" size={16} />
                </span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="sv-sec sv-last">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="plus" size={14} />Sobib kokku</p>
          <h2 class="grad">Teenused, mis käivad koos.</h2>
        </div>
        <a class="link-arrow" href="/uus/teenused">Kõik teenused <Icon name="arrow" size={16} /></a>
      </div>
      <div class="rel-grid">
        {
          related.map((r) => (
            <a class="rel-card" href={serviceHref(r)} data-glow>
              <span class="ibox">
                <Icon name={r.icon} size={20} />
              </span>
              <span class="tag">{r.group}</span>
              <h3>{r.name}</h3>
              <p>{r.short}</p>
              <span class="tile-more">
                Vaata <Icon name="arrow" size={15} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</V2>
