---
import V2 from '../../../layouts/V2.astro';
import Icon from '../../../components/mock/Icon.astro';
import { SERVICES, serviceHref } from '../../../data/v2/services';

const groups = [
  { name: 'Veeb', icon: 'web', text: 'Koduleht või tööriist, mis näeb hea välja ja teeb tööd.' },
  { name: 'Turundus', icon: 'target', text: 'Kliendid leiavad sind Google’ist ja sotsiaalmeediast.' },
  { name: 'AI', icon: 'spark', text: 'Rutiin liigub ise, tiim keskendub päris tööle.' },
] as const;
---

<V2
  title="Teenused: kodulehed, SEO, reklaamid ja AI | drealm"
  description="Kõik drealmi teenused: veebilehed ja platvormid, SEO, Meta reklaamid, reklaampildid, AI videoreklaamid, AI automatiseerimine, koolitused ja ettevõtte AI-assistent."
  path="/uus/teenused"
>
  <section class="stage">
    <div class="stage-card page-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="page-hero">
        <nav class="crumbs" aria-label="Asukoht"><a href="/uus">Avaleht</a><span>/</span><span aria-current="page">Teenused</span></nav>
        <p class="chip on-dark"><Icon name="stack" size={14} />Teenused</p>
        <h1 class="sv-h1">Veeb, turundus ja AI ühest kohast.</h1>
        <p class="sv-lead">Üheksa teenust kolmes suunas. Vali see, mis praegu kõige rohkem kripeldab, või lase meil kogu veebipool enda kanda võtta.</p>
        <ul class="stage-tags left">
          {groups.map((g) => <li><a href={`#${g.name.toLowerCase()}`}>{g.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="sv-sec" id={g.name.toLowerCase()}>
        <div class="wrap">
          <div class="sec-head">
            <div>
              <p class="chip">
                <Icon name={g.icon} size={14} />
                {g.name}
              </p>
              <h2 class="grad h-md">{g.text}</h2>
            </div>
          </div>
          <div class="rel-grid">
            {SERVICES.filter((s) => s.group === g.name).map((s) => (
              <a class="rel-card" href={serviceHref(s)} data-glow>
                <span class="ibox">
                  <Icon name={s.icon} size={20} />
                </span>
                <span class="tag">{s.priceFrom ? `alates ${s.priceFrom}` : s.timeline}</span>
                <h3>{s.name}</h3>
                <p>{s.short}</p>
                <span class="tile-more">
                  Vaata lähemalt <Icon name="arrow" size={15} />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))
  }
  <div class="sv-last"></div>
</V2>
