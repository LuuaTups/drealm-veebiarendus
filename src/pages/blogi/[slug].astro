---
import BlogPost from '../../views/v2/BlogPost.astro';
import { getPosts, postSlug, type Post } from '../../data/v2/blog';

export async function getStaticPaths() {
  return (await getPosts('et')).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---

<BlogPost post={post} lang="et" />
