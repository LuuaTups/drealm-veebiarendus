---
import BlogPost from '../../views/BlogPost.astro';
import { getPosts, postSlug } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getPosts('et');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props;
---

<BlogPost post={post} lang="et" />
