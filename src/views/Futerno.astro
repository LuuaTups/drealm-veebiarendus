---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import { ROUTES, UI, r } from '../data/site';
import type { Lang } from '../data/types';
import desktop from '../assets/work/futerno-desktop.png';
import desktop2 from '../assets/work/futerno-desktop-2.png';
import mobile from '../assets/work/futerno-mobile.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const copy = {
  et: {
    title: 'Marmi Futerno: looduskivi tootja koduleht | drealm',
    description: 'Juhtumiuuring: kahekeelne (korea/inglise) portfoolioleht Tallinna looduskivi tootjale Marmi Futerno — täisekraani visuaalid ja projektigaleriid.',
    h1: 'Marmi Futerno: <em>kivi</em>, mis räägib iseenda eest',
    lead: 'Tallinna looduskivi tootja vajas portfoolio­lehte, mis näitaks nende käsitööd rahvusvahelistele klientidele — eelkõige Korea turule.',
    facts: [
      { k: 'Klient', v: 'Marmi Futerno' },
      { k: 'Valdkond', v: 'Looduskivi tootmine' },
      { k: 'Keeled', v: 'Korea, inglise' },
      { k: 'Teenus', v: 'Disain ja arendus' },
    ],
    sections: [
      { h: 'Ülesanne', p: 'Kivitööstuses müüb pilt. Klient soovis lehte, mis näitaks tehtud töid — restoranid, kommertspinnad, eluruumid, kruiisilaevad — suurte, kvaliteetsete fotodena ning kõnetaks korea keelt kõnelevaid kliente nende emakeeles.' },
      { h: 'Lahendus', p: 'Ehitasime täisekraani visuaalidega avaosa, mis vahetab märksõnu („Täpsustootmine“, „Käsitöö“, „Globaalsed projektid“), ning projektigaleriid kategooriate kaupa. Keelevahetus käib ühe klikiga ja kogu sisu on olemas mõlemas keeles. Pildid on optimeeritud nii, et suured fotod laeksid kiiresti ka mobiilis.' },
      { h: 'Tulemus', p: 'Ettevõttel on nüüd esinduslik digitaalne portfoolio, mida saab saata potentsiaalsetele klientidele ja partneritele ning mis näitab nende tööde kvaliteeti paremini kui ükski PDF-kataloog.' },
    ],
  },
  en: {
    title: 'Marmi Futerno: Natural Stone Website Case Study | drealm',
    description: 'Case study: a bilingual (Korean/English) portfolio website for Tallinn natural stone fabricator Marmi Futerno — full-screen visuals and project galleries.',
    h1: 'Marmi Futerno: <em>stone</em> that speaks for itself',
    lead: 'A Tallinn natural stone fabricator needed a portfolio site that would show their craftsmanship to international clients — especially in the Korean market.',
    facts: [
      { k: 'Client', v: 'Marmi Futerno' },
      { k: 'Industry', v: 'Natural stone fabrication' },
      { k: 'Languages', v: 'Korean, English' },
      { k: 'Service', v: 'Design & development' },
    ],
    sections: [
      { h: 'The brief', p: 'In the stone business, images sell. The client wanted a site that showcased completed work — restaurants, commercial spaces, residences, cruise ships — in large, high-quality photography, and spoke to Korean-speaking clients in their own language.' },
      { h: 'The solution', p: 'We built a full-screen visual opening that cycles through key themes (“Precision fabrication”, “Craftsmanship”, “Global projects”) and project galleries by category. Switching language takes one click and all content exists in both languages. Images are optimised so large photographs load quickly on mobile too.' },
      { h: 'The result', p: 'The company now has a representative digital portfolio it can send to prospective clients and partners — one that shows the quality of its work better than any PDF catalogue.' },
    ],
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={{ et: ROUTES.futerno.et, en: ROUTES.futerno.en }} ogType="article">
  <PageHero
    eyebrow={t.nav.work}
    title={copy.h1}
    lead={copy.lead}
    crumbs={[
      { name: t.breadcrumbHome, href: r('home', lang) },
      { name: t.nav.work, href: r('work', lang) },
      { name: 'Marmi Futerno', href: r('futerno', lang) },
    ]}
  >
    <dl class="facts">
      {
        copy.facts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </PageHero>

  <section class="hero-img">
    <div class="container">
      <Image src={desktop} alt="Marmi Futerno — avaleht" widths={[640, 960, 1440]} sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container story">
      {
        copy.sections.map((s) => (
          <div class="row reveal">
            <h2>{s.h}</h2>
            <p class="lead">{s.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container duo">
      <Image class="reveal" src={desktop2} alt="Marmi Futerno — projektid" widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 70vw" />
      <Image class="reveal phone" src={mobile} alt="Marmi Futerno — mobiil" widths={[300, 600]} sizes="(max-width: 900px) 60vw, 25vw" />
    </div>
  </section>

  <CtaSection lang={lang} />
</Base>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 3rem 0 0;
    border-top: 1px solid var(--ink);
  }
  .facts div {
    padding: 1rem 1rem 0 0;
  }
  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .hero-img :global(img) {
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 80px -40px rgba(40, 30, 20, 0.5);
  }
  .story {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }
  .row {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: 2rem;
  }
  .duo {
    display: grid;
    grid-template-columns: 2.6fr 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  .duo :global(img) {
    border-radius: var(--radius);
  }
  .duo :global(.phone) {
    border-radius: 22px;
    border: 6px solid var(--dark);
  }
  @media (max-width: 900px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .row,
    .duo {
      grid-template-columns: 1fr;
    }
    .duo :global(.phone) {
      max-width: 60%;
      margin-inline: auto;
    }
  }
</style>
