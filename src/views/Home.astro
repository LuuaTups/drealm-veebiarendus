---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CtaSection from '../components/CtaSection.astro';
import { GROUPS, ROUTES, UI, r } from '../data/site';
import { GROUP_ORDER, servicesByGroup } from '../data/services';
import type { Lang } from '../data/types';
import futernoDesktop from '../assets/work/futerno-desktop.png';
import futernoMobile from '../assets/work/futerno-mobile.png';
import { GROUP_PHOTO, PHOTOS } from '../data/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];

const copy = {
  et: {
    title: 'Kodulehe tegemine, kinnisvara veebilehed ja AI | drealm',
    description:
      'drealm teeb kiireid ja ilusaid kodulehti, arendusprojektide ja kinnisvara veebilehti ning AI-automatiseerimist. Selge hind, ehitatud päringute toomiseks.',
    eyebrow: 'Veebistuudio · Tallinn',
    h1: 'Veebilehed, mis <em>toovad</em> päringuid.',
    lead: 'Teeme kodulehti, kinnisvaraplatvorme ja AI-lahendusi ettevõtetele, kes tahavad, et nende veebileht teeks päriselt tööd — oleks kiire, leitav Google’is ja muudaks külastajad klientideks.',
    pillars: [
      { k: 'Kiirus', v: 'Lehed laevad alla sekundi' },
      { k: 'SEO', v: 'Tehniline SEO on sisse ehitatud' },
      { k: 'Selgus', v: 'Fikseeritud hind enne algust' },
    ],
    servicesTitle: 'Mida me <em>teeme</em>',
    servicesLead: 'Kolm suunda, üks eesmärk: sinu äri kasvab veebis.',
    workEyebrow: 'Valitud töö',
    workTitle: 'Marmi Futerno',
    workText:
      'Kahekeelne (korea/inglise) portfoolioleht Tallinna looduskivi tootjale: täisekraani visuaalid, projektide galeriid kategooriate kaupa ja kiire laadimine ka suurte fotodega.',
    workCta: 'Vaata juhtumiuuringut',
    whyTitle: 'Miks <em>drealm</em>',
    why: [
      { t: 'Üks kontakt, kogu tervik', d: 'Räägid otse inimesega, kes sinu lehte disainib ja ehitab. Ei mingit info kadumist projektijuhtide ahelas.' },
      { t: 'Ehitatud leitavaks', d: 'Iga leht saab korrektse struktuuri, metaandmed, schema-märgendid ja kiiruse, mida Google hindab.' },
      { t: 'Sinu oma, päriselt', d: 'Domeen, kood ja sisu kuuluvad sulle. Ei mingit lukustust platvormi või meie külge.' },
      { t: 'AI seal, kus see aitab', d: 'Vestlusrobotid ja automatiseerimine ainult siis, kui need säästavad päriselt aega või toovad kliente.' },
    ],
    faqs: [
      { q: 'Kui palju maksab koduleht?', a: 'Lihtne ettevõtte koduleht algab 900 eurost, maandumisleht 500 eurost ja arendusprojekti leht 2500 eurost. Täpse hinna saad pärast lühikest vestlust — fikseeritud ja kirjalikult, enne kui töö algab.' },
      { q: 'Kui kiiresti saab lehe valmis?', a: 'Lihtsa kodulehe teeme valmis 2–4 nädalaga, suurema projekti 4–8 nädalaga. Ajakava sõltub suuresti sellest, kui kiiresti tekstid ja pildid olemas on — vajadusel aitame ka nendega.' },
      { q: 'Kas saan ise sisu muuta?', a: 'Jah. Seadistame lehe nii, et tekste, pilte, pakkumisi või kinnisvaraobjekte saab muuta ilma programmeerimiseta. Näitame ka ette, kuidas see käib.' },
      { q: 'Kas teete ka ingliskeelseid ja mitmekeelseid lehti?', a: 'Jah, mitmekeelsus on meil tavapärane. Teeme lehti eesti, inglise, vene, soome ja vajadusel teistes keeltes — koos õigete hreflang-märgenditega, et iga keel oleks Google’is eraldi leitav.' },
      { q: 'Kas pakute ka hooldust pärast valmimist?', a: 'Jah. Pakume kuupõhist hooldust (uuendused, varukoopiad, väiksemad muudatused) ning soovi korral jätkuvat SEO- ja sisutööd. Aga hooldus ei ole kohustuslik — leht töötab ka ilma.' },
    ],
  },
  en: {
    title: 'Web Design, Real Estate Websites & AI Automation | drealm',
    description:
      'drealm builds fast, beautiful websites, real estate and property development sites, and AI automation for businesses in Estonia and beyond. Clear, fixed pricing.',
    eyebrow: 'Web studio · Tallinn, Estonia',
    h1: 'Websites that <em>bring in</em> business.',
    lead: 'We build websites, real estate platforms and AI solutions for companies that want their website to actually work — fast, easy to find on Google, and good at turning visitors into clients.',
    pillars: [
      { k: 'Speed', v: 'Pages load in under a second' },
      { k: 'SEO', v: 'Technical SEO built in' },
      { k: 'Clarity', v: 'Fixed price before we start' },
    ],
    servicesTitle: 'What we <em>do</em>',
    servicesLead: 'Three directions, one goal: growing your business online.',
    workEyebrow: 'Selected work',
    workTitle: 'Marmi Futerno',
    workText:
      'A bilingual (Korean/English) portfolio site for a Tallinn natural stone fabricator: full-screen visuals, project galleries by category and fast loading even with large photography.',
    workCta: 'Read the case study',
    whyTitle: 'Why <em>drealm</em>',
    why: [
      { t: 'One point of contact', d: 'You talk directly to the person who designs and builds your site. Nothing gets lost in a chain of project managers.' },
      { t: 'Built to be found', d: 'Every page gets proper structure, metadata, schema markup and the speed Google rewards.' },
      { t: 'Truly yours', d: 'The domain, code and content belong to you. No lock-in to a platform — or to us.' },
      { t: 'AI where it helps', d: 'Chatbots and automation only where they genuinely save time or bring in clients.' },
    ],
    faqs: [
      { q: 'How much does a website cost?', a: 'A simple business website starts from €900, a landing page from €500 and a property development website from €2,500. You get an exact, fixed price in writing after a short call — before any work starts.' },
      { q: 'How quickly can my website be ready?', a: 'A simple website takes 2–4 weeks, a larger project 4–8 weeks. The timeline depends a lot on how quickly copy and images are ready — and we can help with those too.' },
      { q: 'Can I edit the content myself?', a: 'Yes. We set things up so texts, images, offers or property listings can be updated without any coding, and we show you how it works.' },
      { q: 'Do you build multilingual websites?', a: 'Yes, multilingual sites are routine for us — Estonian, English, Russian, Finnish and more, with correct hreflang tags so each language can rank on its own.' },
      { q: 'Do you offer maintenance after launch?', a: 'Yes. We offer monthly care plans (updates, backups, small changes) and ongoing SEO and content work if you want it. It is optional — your site keeps working without it.' },
    ],
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={{ et: ROUTES.home.et, en: ROUTES.home.en }}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 set:html={copy.h1} />
      <div class="hero-bottom">
        <p class="lead">{copy.lead}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={r('contact', lang)}>{t.cta} <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={r('work', lang)}>{t.seeWork}</a>
        </div>
      </div>
      <Image class="hero-photo" src={PHOTOS.desk.src} alt={PHOTOS.desk.alt[lang]} widths={[640, 960, 1200]} sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" fetchpriority="high" />
      <ul class="pillars">
        {
          copy.pillars.map((p) => (
            <li>
              <span>{p.k}</span>
              {p.v}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="teenused">
    <div class="container">
      <div class="section-head reveal">
        <h2 set:html={copy.servicesTitle} />
        <p class="lead">{copy.servicesLead}</p>
      </div>
      <div class="groups">
        {
          GROUP_ORDER.map((g) => (
            <div class="group">
              <div class="group-head reveal">
                <h3>{GROUPS[g][lang].title}</h3>
                <p>{GROUPS[g][lang].text}</p>
              </div>
              {g !== 'industry' && (
                <Image class="group-photo" src={GROUP_PHOTO[g].src} alt={GROUP_PHOTO[g].alt[lang]} widths={[640, 960, 1200]} sizes="(max-width: 1200px) 100vw, 1200px" />
              )}
              <ServiceGrid lang={lang} items={servicesByGroup(g)} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section work">
    <div class="container work-grid">
      <div class="work-copy reveal">
        <p class="eyebrow">{copy.workEyebrow}</p>
        <h2>{copy.workTitle}</h2>
        <p class="lead">{copy.workText}</p>
        <a class="btn btn--ghost" href={r('futerno', lang)}>{copy.workCta} <span class="arrow">→</span></a>
      </div>
      <a class="shots reveal" href={r('futerno', lang)} aria-label={copy.workCta}>
        <Image class="shot-desktop" src={futernoDesktop} alt="Marmi Futerno — desktop" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 60vw" />
        <Image class="shot-mobile" src={futernoMobile} alt="Marmi Futerno — mobile" widths={[200, 400]} sizes="180px" />
      </a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal">
        <h2 set:html={copy.whyTitle} />
      </div>
      <ul class="why">
        {
          copy.why.map((w, i) => (
            <li class="reveal" style={`transition-delay:${i * 70}ms`}>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Process lang={lang} />
  <Faq title={t.faq} items={copy.faqs} />
  <CtaSection lang={lang} />
</Base>

<style>
  .hero {
    padding: clamp(48px, 9vw, 120px) 0 clamp(56px, 7vw, 96px);
  }
  .hero h1 {
    font-size: clamp(3rem, 9.5vw, 8.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 11em;
    animation: rise 1.1s var(--ease) both;
  }
  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(32px, 5vw, 64px);
    animation: rise 1.1s 0.15s var(--ease) both;
  }
  .hero-bottom .lead {
    margin: 0;
    max-width: 34rem;
  }
  .hero :global(.hero-photo),
  .group :global(.group-photo) {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: 3px;
  }
  .hero :global(.hero-photo) {
    margin-top: clamp(40px, 6vw, 72px);
    aspect-ratio: 16 / 7;
  }
  .group :global(.group-photo) {
    margin-bottom: 1.6rem;
  }
  .pillars {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 7vw, 96px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    animation: rise 1.1s 0.3s var(--ease) both;
  }
  .pillars li {
    padding: 1.2rem 1.2rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .pillars span {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .groups {
    display: grid;
    gap: clamp(56px, 7vw, 96px);
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-bottom: 1.6rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .group-head h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .group-head p {
    margin: 0;
    color: var(--muted);
    max-width: 28rem;
  }
  .work-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .work-copy .lead {
    margin: 1.2rem 0 2rem;
  }
  .shots {
    position: relative;
    display: block;
    padding-bottom: 8%;
  }
  .shots :global(.shot-desktop) {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: 0 40px 80px -40px rgba(40, 30, 20, 0.5);
    transition: transform 0.6s var(--ease);
  }
  .shots :global(.shot-mobile) {
    position: absolute;
    right: -2%;
    bottom: 0;
    width: 24%;
    border-radius: 16px;
    border: 5px solid var(--dark);
    box-shadow: 0 30px 60px -20px rgba(40, 30, 20, 0.5);
    transition: transform 0.6s var(--ease);
  }
  .shots:hover :global(.shot-desktop) {
    transform: translateY(-6px);
  }
  .shots:hover :global(.shot-mobile) {
    transform: translateY(-14px);
  }
  .why {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .why li {
    border-top: 1px solid var(--ink);
    padding-top: 1.4rem;
  }
  .why h3 {
    margin-bottom: 0.8rem;
  }
  .why p {
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 900px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
    .why {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero :global(.hero-photo),
    .group :global(.group-photo) {
      aspect-ratio: 4 / 3;
    }
    .pillars {
      grid-template-columns: 1fr;
    }
    .pillars li {
      padding: 1rem 0;
      border-bottom: 1px solid var(--line);
    }
    .why {
      grid-template-columns: 1fr;
    }
    .hero-bottom .btn-row {
      width: 100%;
    }
    .hero-bottom .btn {
      flex: 1;
    }
  }
</style>
