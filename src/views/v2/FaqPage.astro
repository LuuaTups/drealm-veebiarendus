---
import V2 from '../../layouts/V2.astro';
import Icon from '../../components/mock/Icon.astro';
import { FAQ } from '../../data/v2/faq';
import type { Lang } from '../../data/v2/services';
import { ROUTES, SITE_URL, UI, r } from '../../data/v2/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const groups = FAQ[lang];
const c = {
  et: {
    title: 'KKK: kodulehe hind, ajakava, SEO ja AI küsimused | drealm',
    description: 'Korduma kippuvad küsimused: kui palju koduleht maksab, kui kaua tegemine võtab, kellele leht kuulub, millal SEO tulemusi näha ja mida AI ettevõttes teha saab.',
    h1: 'Korduma kippuvad küsimused.',
    lead: 'Lühikesed vastused sellele, mida küsitakse enne koostöö algust kõige sagedamini. Kui oma küsimust ei leia, kirjuta meile.',
    more: 'Ei leidnud vastust?',
    moreP: 'Kirjelda, mida vajad, ja vastame ühe tööpäeva jooksul.',
  },
  en: {
    title: 'FAQ: website cost, timeline, SEO and AI questions | drealm',
    description: 'Frequently asked questions: how much a website costs, how long it takes, who owns it, when SEO results show and what AI can do in a business.',
    h1: 'Frequently asked questions.',
    lead: 'Short answers to what people ask most before we start working together. If you can’t find your question, write to us.',
    more: 'Didn’t find an answer?',
    moreP: 'Describe what you need and we’ll reply within one working day.',
  },
}[lang];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: groups.flatMap((g) => g.items).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(r('home', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: t.faq, item: new URL(r('faq', lang), SITE_URL).href },
    ],
  },
];
---

<V2 lang={lang} title={c.title} description={c.description} alternates={{ et: ROUTES.faq.et, en: ROUTES.faq.en }} jsonLd={jsonLd}>
  <section class="stage">
    <div class="stage-card page-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="page-hero">
        <nav class="crumbs" aria-label="Breadcrumb"><a href={r('home', lang)}>{t.home}</a><span>/</span><span aria-current="page">{t.faqShort}</span></nav>
        <p class="chip on-dark">{t.faqShort}</p>
        <h1 class="sv-h1">{c.h1}</h1>
        <p class="sv-lead">{c.lead}</p>
        <ul class="stage-tags left">
          {groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  {
    groups.map((g, gi) => (
      <section class:list={['sv-sec', { 'sv-last': gi === groups.length - 1 }]} id={g.id}>
        <div class="wrap">
          <div class="faq faq-wide">
            <h2 class="h-md faq-group-h">{g.title}</h2>
            {g.items.map((f) => (
              <details>
                <summary>
                  {f.q}
                  <span class="faq-ic">
                    <Icon name="plus" size={16} />
                  </span>
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
          {gi === groups.length - 1 && (
            <div class="faq-more">
              <div>
                <h2 class="h-md">{c.more}</h2>
                <p>{c.moreP}</p>
              </div>
              <a class="btn btn-dark" href={r('contact', lang)}>
                <span>{t.askPrice}</span>
                <Icon name="arrow" size={18} />
              </a>
            </div>
          )}
        </div>
      </section>
    ))
  }
</V2>
