---
import V2 from '../../layouts/V2.astro';
import Icon from '../../components/mock/Icon.astro';
import ServiceMock from '../../components/v2/ServiceMock.astro';
import { GROUP_LABEL, byId, serviceHref, type Lang } from '../../data/v2/services';
import { subHref, subsOf, type SubService } from '../../data/v2/subservices';
import { SITE_URL, UI, r } from '../../data/v2/ui';

interface Props {
  sub: SubService;
  lang: Lang;
}
const { sub, lang } = Astro.props;
const t = UI[lang];
const c = sub[lang];
const parent = byId(sub.parent, lang)!;
const siblings = subsOf(sub.parent).filter((x) => x.id !== sub.id);
const alternates = { et: subHref(sub, 'et'), en: subHref(sub, 'en') };
const url = new URL(subHref(sub, lang), SITE_URL).href;
const quoteHref = `${r('contact', lang)}?t=${parent.id}`;
const L = {
  et: { incl: 'Mis sisaldub', more: 'Veel teenuses', all: 'Vaata kogu teenust' },
  en: { incl: 'What’s included', more: 'More in', all: 'See the full service' },
}[lang];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: c.name,
    serviceType: parent.name,
    description: c.metaDescription,
    url,
    inLanguage: lang,
    areaServed: { '@type': 'Country', name: 'Estonia' },
    provider: { '@id': `${SITE_URL}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(r('home', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: t.services, item: new URL(r('services', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: parent.name, item: new URL(serviceHref(parent, lang), SITE_URL).href },
      { '@type': 'ListItem', position: 4, name: c.name, item: url },
    ],
  },
];
---

<V2 lang={lang} title={c.metaTitle} description={c.metaDescription} alternates={alternates} jsonLd={jsonLd}>
  <section class="stage">
    <div class="stage-card sv-card sub-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="sv-grid">
        <div class="sv-copy">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={r('home', lang)}>{t.home}</a><span>/</span><a href={r('services', lang)}>{t.services}</a><span>/</span><a href={serviceHref(parent, lang)}>{parent.name}</a><span>/</span><span aria-current="page">{c.name}</span>
          </nav>
          <p class="chip on-dark">{GROUP_LABEL[lang][parent.group]} · {parent.name}</p>
          <h1 class="sv-h1">{c.h1}</h1>
          <p class="sv-lead">{c.lead}</p>
          <div class="sv-ctas">
            <a class="cta-glow" href={quoteHref}><span class="box"><Icon name="arrow" size={16} /></span>{t.askPrice}</a>
            <a class="btn-glass" href={serviceHref(parent, lang)}><span>{parent.name}</span><Icon name="arrow" size={16} /></a>
          </div>
          <dl class="sv-facts">
            <div><dt>{t.price}</dt><dd>{parent.priceFrom ? `${t.from} ${parent.priceFrom}` : t.onRequest}</dd></div>
            <div><dt>{t.timeline}</dt><dd>{parent.timeline}</dd></div>
          </dl>
        </div>
        <div class="sv-visual">
          <ServiceMock id={parent.id} lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap sub-layout">
      <div class="prose sub-prose">
        {c.body.map((p) => <p>{p}</p>)}
      </div>
      <aside class="incl-card" data-glow>
        <p class="chip">{L.incl}</p>
        <ul>
          {
            c.includes.map((i) => (
              <li>
                <span class="tick">
                  <Icon name="check" size={14} />
                </span>
                {i}
              </li>
            ))
          }
        </ul>
        <a class="btn btn-dark" href={quoteHref}><span>{t.askPrice}</span><Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap">
      <div class="faq faq-wide">
        <p class="chip">{t.faq}</p>
        {
          c.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <span class="faq-ic">
                  <Icon name="plus" size={16} />
                </span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sv-sec sv-last">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip">{L.more}: {parent.name}</p>
          <h2 class="grad h-md">{parent.h1}</h2>
        </div>
        <a class="link-arrow" href={serviceHref(parent, lang)}>{L.all} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="rel-grid">
        {
          siblings.map((x) => (
            <a class="rel-card" href={subHref(x, lang)} data-glow>
              <span class="ibox">
                <Icon name={x.icon} size={20} />
              </span>
              <h3>{x[lang].name}</h3>
              <p>{x[lang].lead}</p>
              <span class="tile-more">
                {t.see} <Icon name="arrow" size={15} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</V2>
