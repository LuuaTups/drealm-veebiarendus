---
import V2 from '../../layouts/V2.astro';
import { getImage } from 'astro:assets';
import Icon from '../../components/mock/Icon.astro';
import ProjectShot from '../../components/v2/ProjectShot.astro';
import ProjectCard from '../../components/v2/ProjectCard.astro';
import { byId, serviceHref, type Lang, type Service } from '../../data/v2/services';
import { PROJECTS, pName, projHref, type Project } from '../../data/v2/projects';
import { SOLUTIONS, solHref } from '../../data/v2/solutions';
import { SITE_URL, UI, r } from '../../data/v2/ui';

interface Props {
  p: Project;
  lang: Lang;
}
const { p, lang } = Astro.props;
const t = UI[lang];
const c = p[lang];
const services = p.services.map((id) => byId(id, lang)).filter((x): x is Service => Boolean(x));
const sols = SOLUTIONS.filter((s) => p.solutions.includes(s.id));
const shared = (x: Project) => x.services.filter((id) => p.services.includes(id)).length;
const others = PROJECTS.filter((x) => x.id !== p.id && !x.hideOnServices)
  .sort((a, b) => shared(b) - shared(a))
  .slice(0, 3);
const alternates = { et: projHref(p, 'et'), en: projHref(p, 'en') };
const url = new URL(projHref(p, lang), SITE_URL).href;
// Share image: the project's own screenshot cropped to 1200×630, else the default og.png.
const shotFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.{jpg,png,webp}', { eager: true });
const shotName = p.shots.desktop ?? p.shots.photo;
const shot = shotName ? shotFiles[`../../assets/projects/${shotName}`]?.default : undefined;
const ogImage = shot
  ? { src: new URL((await getImage({ src: shot, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' })).src, SITE_URL).href, alt: pName(p, lang) }
  : undefined;
const quoteHref = `${r('contact', lang)}?t=${services[0].id}`;
const L = {
  et: { done: 'Mis sisaldub', doneH: 'Peamine, mis valmis sai.', svc: 'Teenused', tech: 'Tehnoloogia', year: 'Aasta', type: 'Tüüp', more: 'Veel töid', moreH: 'Vaata ka teisi.', cta: 'Tahad midagi sarnast?', ctaP: 'Kirjelda, mida vajad, ja saad ühe tööpäeva jooksul hinnapakkumise.' },
  en: { done: 'What’s included', doneH: 'The main things we delivered.', svc: 'Services', tech: 'Technology', year: 'Year', type: 'Type', more: 'More work', moreH: 'See the others too.', cta: 'Want something similar?', ctaP: 'Describe what you need and get a quote within one working day.' },
}[lang];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `${pName(p, lang)}: ${c.type}`,
    headline: c.h1,
    description: c.metaDescription,
    url,
    inLanguage: lang,
    dateCreated: p.year,
    creator: { '@id': `${SITE_URL}/#org` },
    ...(p.url ? { sameAs: p.url } : {}),
    keywords: [c.type, ...p.tech].join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(r('home', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: t.work, item: new URL(r('work', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: pName(p, lang), item: url },
    ],
  },
];
---

<V2 lang={lang} title={c.metaTitle} description={c.metaDescription} alternates={alternates} jsonLd={jsonLd} ogType="article" ogImage={ogImage}>
  <section class="stage">
    <div class="stage-card sv-card sub-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="sv-grid">
        <div class="sv-copy">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={r('home', lang)}>{t.home}</a><span>/</span><a href={r('work', lang)}>{t.work}</a><span>/</span><span aria-current="page">{pName(p, lang)}</span>
          </nav>
          <p class="chip on-dark">{c.type}{p.own && ` · ${t.ownProject}`}</p>
          <h1 class="sv-h1">{c.h1}</h1>
          <p class="sv-lead">{c.lead}</p>
          <div class="sv-ctas">
            {
              p.url ? (
                <a class="cta-glow" href={p.url} target="_blank" rel="noopener">
                  <span class="box">
                    <Icon name="arrow" size={16} />
                  </span>
                  {t.visit}
                </a>
              ) : (
                <a class="cta-glow" href={quoteHref}>
                  <span class="box">
                    <Icon name="arrow" size={16} />
                  </span>
                  {t.askPrice}
                </a>
              )
            }
            <a class="btn-glass" href={r('work', lang)}><span>{t.allWork}</span><Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <div class="sv-visual proj-visual">
          <ProjectShot p={p} lang={lang} eager />
        </div>
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap sub-layout">
      <div class="prose sub-prose proj-prose">
        <h2>{c.challengeH}</h2>
        {c.challenge.map((x) => <p>{x}</p>)}
        <h2>{c.solutionH}</h2>
        {c.solution.map((x) => <p>{x}</p>)}
      </div>
      <aside class="incl-card proj-facts" data-glow>
        <dl>
          <div><dt>{L.type}</dt><dd>{c.type}</dd></div>
          <div><dt>{L.year}</dt><dd>{p.year}</dd></div>
          {p.url && <div><dt>Web</dt><dd><a href={p.url} target="_blank" rel="noopener">{new URL(p.url).host}</a></dd></div>}
          <div><dt>{L.tech}</dt><dd>{p.tech.join(', ')}</dd></div>
        </dl>
        <p class="chip">{L.svc}</p>
        <ul class="sol-svc">
          {
            services.map((s) => (
              <li>
                <a href={serviceHref(s, lang)}>
                  <span class="ibox sm">
                    <Icon name={s.icon} size={15} />
                  </span>
                  {s.name}
                  <Icon name="arrow" size={14} />
                </a>
              </li>
            ))
          }
          {
            sols.map((s) => (
              <li>
                <a href={solHref(s, lang)}>
                  <span class="ibox sm">
                    <Icon name={s.icon} size={15} />
                  </span>
                  {s[lang].name}
                  <Icon name="arrow" size={14} />
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn-dark" href={quoteHref}><span>{t.askPrice}</span><Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip">{L.done}</p>
          <h2 class="h-md">{L.doneH}</h2>
        </div>
      </div>
      <div class="del-grid">
        {
          c.features.map((f) => (
            <div class="del-card" data-glow>
              <span class="ibox">
                <Icon name="check" size={18} />
              </span>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sv-sec sv-last">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip">{L.more}</p>
          <h2 class="h-md">{L.moreH}</h2>
        </div>
        <a class="link-arrow" href={r('work', lang)}>{t.allWork} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="proj-grid">
        {others.map((x) => <ProjectCard p={x} lang={lang} />)}
      </div>
    </div>
  </section>
</V2>
