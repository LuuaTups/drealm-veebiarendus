---
import V2 from '../../layouts/V2.astro';
import Icon from '../../components/mock/Icon.astro';
import InquiryForm from '../../components/v2/InquiryForm.astro';
import { type Lang } from '../../data/v2/services';
import { EMAIL, PHONES, ROUTES, UI, r } from '../../data/v2/ui';
import { quoteTopics } from '../../data/v2/quote';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const topics = quoteTopics(lang);
const c = {
  et: {
    title: 'Küsi hinda | drealm',
    description: 'Küsi hinda: kirjelda, mida vajad, ja saad ühe tööpäeva jooksul hinnapakkumise. Kodulehed, platvormid, SEO, reklaamid ja AI. info@drealm.ee',
    chip: 'Hinnapäring',
    h1: 'Küsi hinda.',
    lead: 'Kirjelda paari lausega, mida vajad. Vastame ühe tööpäeva jooksul konkreetse pakkumise või paari täpsustava küsimusega. Kohustusi pole.',
    email: 'E-post',
    phone: 'Telefon',
    reply: 'Vastame',
    replyV: 'ühe tööpäeva jooksul',
    formChip: 'Kolm lühikest sammu',
  },
  en: {
    title: 'Get a quote | drealm',
    description: 'Get a quote: describe what you need and receive a price within one working day. Websites, platforms, SEO, ads and AI. info@drealm.ee',
    chip: 'Quote request',
    h1: 'Get a quote.',
    lead: 'Describe in a couple of sentences what you need. We reply within one working day with a concrete quote or a few clarifying questions. No obligation.',
    email: 'Email',
    phone: 'Phone',
    reply: 'We reply',
    replyV: 'within one working day',
    formChip: 'Three short steps',
  },
}[lang];
---

<V2 lang={lang} title={c.title} description={c.description} alternates={{ et: ROUTES.contact.et, en: ROUTES.contact.en }}>
  <section class="stage">
    <div class="stage-card page-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="page-hero contact-hero">
        <div>
          <nav class="crumbs" aria-label="Breadcrumb"><a href={r('home', lang)}>{t.home}</a><span>/</span><span aria-current="page">{t.contact}</span></nav>
          <p class="chip on-dark">{c.chip}</p>
          <h1 class="sv-h1" data-q-h1>{c.h1}</h1>
          <p class="sv-lead" data-q-lead>{c.lead}</p>
          <ul class="q-facts" data-q-facts hidden></ul>
          <script is:inline type="application/json" id="q-topics" set:html={JSON.stringify(topics)} />
          <script is:inline>
            // Ads land on /kontakt?t=<topic>: swap in the service-specific heading, lead and facts before paint.
            (function () {
              var key = new URLSearchParams(location.search).get('t');
              var q = key && JSON.parse(document.getElementById('q-topics').textContent)[key];
              if (!q) return;
              document.querySelector('[data-q-h1]').textContent = q.h1;
              if (q.lead) document.querySelector('[data-q-lead]').textContent = q.lead;
              var ul = document.querySelector('[data-q-facts]');
              q.facts.forEach(function (f) { var li = document.createElement('li'); li.textContent = f; ul.appendChild(li); });
              ul.hidden = !q.facts.length;
            })();
          </script>
        </div>
        <div class="contact-list">
          <a href={`mailto:${EMAIL}`} class="contact-item"><span class="ibox"><Icon name="mail" size={18} /></span><span><small>{c.email}</small>{EMAIL}</span></a>
          <div class="contact-item"><span class="ibox"><Icon name="chat" size={18} /></span><span><small>{c.phone}</small>{PHONES.map((p, i) => <>{i > 0 && <br />}<a href={`tel:${p.tel}`}>{p.label}</a></>)}</span></div>
          <div class="contact-item"><span class="ibox"><Icon name="bell" size={18} /></span><span><small>{c.reply}</small>{c.replyV}</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sv-sec sv-last" id="vorm">
    <div class="wrap">
      <div class="inq-card dark-card">
        <InquiryForm lang={lang} page={r('contact', lang)} />
      </div>
    </div>
  </section>
</V2>
