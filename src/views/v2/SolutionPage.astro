---
import V2 from '../../layouts/V2.astro';
import Icon from '../../components/mock/Icon.astro';
import ServiceMock from '../../components/v2/ServiceMock.astro';
import { priceOffer, byId, serviceHref, type Lang, type Service } from '../../data/v2/services';
import { SOLUTIONS, solHref, type Solution } from '../../data/v2/solutions';
import { SITE_URL, UI, r } from '../../data/v2/ui';
import { projectsForSolution, projectsForService } from '../../data/v2/projects';
import { demoFor } from '../../data/v2/demos';
import { SOL_DEEP } from '../../data/v2/solutions-deep';
import ProjectCard from '../../components/v2/ProjectCard.astro';

interface Props {
  sol: Solution;
  lang: Lang;
}
const { sol, lang } = Astro.props;
const t = UI[lang];
const c = sol[lang];
const services = sol.services.map((id) => byId(id, lang)).filter((x): x is Service => Boolean(x));
const main = services[0];
const alternates = { et: solHref(sol, 'et'), en: solHref(sol, 'en') };
const url = new URL(solHref(sol, lang), SITE_URL).href;
// Always show at least one related piece of work: the solution's own projects, else the primary service's.
const ownProjs = projectsForSolution(sol.id);
// Priority pages carry extra industry-specific depth; the rest stay noindex until written (see noindex.json).
const deep = SOL_DEEP[sol.id]?.[lang];
const faqs = deep ? [...c.faqs, ...deep.faqs] : c.faqs;
const projs = ownProjs.length ? ownProjs : (sol.services.map((id) => projectsForService(id)).find((x) => x.length) ?? []).slice(0, 2);
const quoteHref = `${r('contact', lang)}?t=${main.id}`;
// Related: same primary service first, then solutions sharing any service.
const score = (x: Solution) => (x.services[0] === sol.services[0] ? 2 : 0) + (x.services.some((id) => sol.services.includes(id)) ? 1 : 0);
const related = SOLUTIONS.filter((x) => x.id !== sol.id && score(x) > 0)
  .sort((a, b) => score(b) - score(a))
  .slice(0, 6);
const L = {
  et: { svc: 'Seotud teenused', feat: 'Mida lahendus sisaldab', featH: 'Kõik vajalik, et see päriselt töötaks.', more: 'Sarnased lahendused', moreH: 'Vaata ka neid.' },
  en: { svc: 'Related services', feat: 'What’s included', featH: 'Everything it takes to actually work.', more: 'Similar solutions', moreH: 'Take a look at these too.' },
}[lang];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: c.name,
    serviceType: main.name,
    description: c.metaDescription,
    url,
    inLanguage: lang,
    areaServed: { '@type': 'Country', name: 'Estonia' },
    provider: { '@id': `${SITE_URL}/#org` },
    offers: priceOffer(main),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: c.name,
      itemListElement: c.features.map((f) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: f.t, description: f.d } })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(r('home', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: t.solutions, item: new URL(r('solutions', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: c.name, item: url },
    ],
  },
];
---

<V2 lang={lang} title={c.metaTitle} description={c.metaDescription} alternates={alternates} jsonLd={jsonLd} noindex={!deep}>
  <section class="stage">
    <div class="stage-card sv-card sub-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="sv-grid">
        <div class="sv-copy">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={r('home', lang)}>{t.home}</a><span>/</span><a href={r('solutions', lang)}>{t.solutions}</a><span>/</span><span aria-current="page">{c.name}</span>
          </nav>
          <p class="chip on-dark">{t.solutions} · {main.name}</p>
          <h1 class="sv-h1">{c.h1}</h1>
          <p class="sv-lead">{c.lead}</p>
          <div class="sv-ctas">
            <a class="cta-glow" href={quoteHref}><span class="box"><Icon name="arrow" size={16} /></span>{t.askPrice}</a>
            <a class="btn-glass" href={serviceHref(main, lang)}><span>{main.name}</span><Icon name="arrow" size={16} /></a>
          </div>
          <dl class="sv-facts">
            <div><dt>{t.price}</dt><dd>{main.priceFrom ? `${t.from} ${main.priceFrom}` : t.onRequest}</dd></div>
            <div><dt>{t.timeline}</dt><dd>{main.timeline}</dd></div>
          </dl>
        </div>
        <div class="sv-visual">
          <ServiceMock id={main.id} lang={lang} demo={demoFor(sol.id, lang)} />
        </div>
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap sub-layout">
      <div class="prose sub-prose">
        {c.intro.map((p) => <p>{p}</p>)}
        {deep?.body.map((p) => <p>{p}</p>)}
      </div>
      <aside class="incl-card" data-glow>
        <p class="chip">{L.svc}</p>
        <ul class="sol-svc">
          {
            services.map((s) => (
              <li>
                <a href={serviceHref(s, lang)}>
                  <span class="ibox sm">
                    <Icon name={s.icon} size={15} />
                  </span>
                  {s.name}
                  <Icon name="arrow" size={14} />
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn-dark" href={quoteHref}><span>{t.askPrice}</span><Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip">{L.feat}</p>
          <h2 class="h-md">{L.featH}</h2>
        </div>
      </div>
      <div class="del-grid">
        {
          c.features.map((f) => (
            <div class="del-card" data-glow>
              <span class="ibox">
                <Icon name="check" size={18} />
              </span>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    deep && (
      <section class="sv-sec">
        <div class="wrap sub-layout">
          <div class="prose sub-prose">
            <p class="chip">{lang === 'et' ? 'Näide' : 'Example'}</p>
            <h2 class="h-md">{deep.example.title}</h2>
            <p>{deep.example.text}</p>
            <ul class="deep-scope">
              {deep.example.scope.map((x) => <li>{x}</li>)}
            </ul>
            <h2 class="h-md deep-h">{lang === 'et' ? 'Millest hind sõltub' : 'What drives the price'}</h2>
            {deep.pricing.map((p) => <p>{p}</p>)}
          </div>
          <aside class="incl-card" data-glow>
            <p class="chip">{lang === 'et' ? 'Kuidas töö käib' : 'How it works'}</p>
            <ol class="deep-steps">
              {deep.process.map((x) => (
                <li>
                  <b>{x.t}</b>
                  <span>{x.d}</span>
                </li>
              ))}
            </ol>
            <a class="btn btn-dark" href={quoteHref}><span>{t.askPrice}</span><Icon name="arrow" size={18} /></a>
          </aside>
        </div>
      </section>
    )
  }

  <section class="sv-sec">
    <div class="wrap">
      <div class="faq faq-wide">
        <p class="chip">{t.faq}</p>
        {
          faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <span class="faq-ic">
                  <Icon name="plus" size={16} />
                </span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {
    projs.length > 0 && (
      <section class="sv-sec">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <p class="chip">{t.work}</p>
              <h2 class="h-md">{ownProjs.length ? (lang === 'et' ? 'Päris näide sellest lahendusest.' : 'A real example of this solution.') : lang === 'et' ? 'Sarnased tehtud tööd.' : 'Related work we’ve done.'}</h2>
            </div>
            <a class="link-arrow" href={r('work', lang)}>{t.allWork} <Icon name="arrow" size={16} /></a>
          </div>
          <div class:list={['proj-grid', { n2: projs.length === 2, one: projs.length === 1 }]}>
            {projs.map((x) => <ProjectCard p={x} lang={lang} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="sv-sec sv-last">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip">{L.more}</p>
          <h2 class="h-md">{L.moreH}</h2>
        </div>
        <a class="link-arrow" href={r('solutions', lang)}>{t.allSolutions} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="rel-grid">
        {
          related.map((x) => (
            <a class="rel-card" href={solHref(x, lang)} data-glow>
              <span class="ibox">
                <Icon name={x.icon} size={20} />
              </span>
              <h3>{x[lang].name}</h3>
              <p>{x[lang].lead}</p>
              <span class="tile-more">
                {t.see} <Icon name="arrow" size={15} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</V2>
