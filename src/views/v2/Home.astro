---
import V2 from '../../layouts/V2.astro';
import Icon from '../../components/mock/Icon.astro';
import ServiceMock from '../../components/v2/ServiceMock.astro';
import { GROUP_LABEL, servicesFor, serviceHref, type Lang } from '../../data/v2/services';
import { ROUTES, UI, r } from '../../data/v2/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const services = servicesFor(lang);
const tileClass: Record<string, string> = {
  veebilehed: 't-web',
  platvormid: 't-plat dark',
  seo: 't-seo',
  meta: 't-meta',
  reklaampildid: 't-ads',
  video: 't-video dark',
  automatiseerimine: 't-auto',
  koolitused: 't-course',
  'ettevotte-ai': 't-pai dark',
};
const c = {
  et: {
    title: 'drealm — kodulehed, turundus ja AI ettevõtetele',
    description: 'Digistuudio Tallinnas: kodulehed ja platvormid, SEO ja reklaamid ning AI-lahendused ettevõtetele. Fikseeritud hind, otsekontakt.',
    kicker: 'drealm · digistuudio Tallinnas',
    h1: 'Kodulehed, mis näevad välja sama head kui sinu teenus.',
    lead: 'Veebilehed, turundus ja AI ühest kohast. Disainime, ehitame ja paneme tööle.',
    cta: 'Küsi hinda',
    servicesH: 'Mida teeme',
    servicesP: 'Veeb, turundus ja AI. Võta üks teenus või kõik korraga. Iga ploki juures näed, kuidas see päriselt välja näeb.',
    painsChip: 'Kliendid ütlevad meile',
    talk: 'Räägime sellest',
  },
  en: {
    title: 'drealm — websites, marketing and AI for businesses',
    description: 'A digital studio in Tallinn: websites and platforms, SEO and ads, and AI solutions for businesses. Fixed prices, direct contact.',
    kicker: 'drealm · digital studio in Tallinn',
    h1: 'Websites that look as good as your service.',
    lead: 'Websites, marketing and AI in one place. We design, build and make it work.',
    cta: 'Get a quote',
    servicesH: 'What we do',
    servicesP: 'Web, marketing and AI. Take one service or all of them. Each block shows what it actually looks like.',
    painsChip: 'What clients tell us',
    talk: 'Let’s talk about it',
  },
}[lang];
---

<V2 lang={lang} title={c.title} description={c.description} alternates={{ et: ROUTES.home.et, en: ROUTES.home.en }}>
  <section class="stage">
    <div class="stage-card">
      <canvas class="stage-gl" data-gl aria-hidden="true"></canvas>
      <div class="stage-shade" aria-hidden="true"></div>
      <div class="stage-content">
        <p class="stage-kicker">{c.kicker}</p>
        <span class="stage-mark" aria-hidden="true"><Icon name="spark" size={58} /></span>
        <h1>{c.h1}</h1>
        <p class="stage-lead">{c.lead}</p>
        <a class="cta-glow" href={r('contact', lang)}><span class="box"><Icon name="arrow" size={16} /></span>{c.cta}</a>
      </div>
      <ul class="stage-tags" aria-label={t.services}>
        {services.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="services" id="teenused">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="stack" size={14} />{t.services}</p>
          <h2 class="grad">{c.servicesH}</h2>
        </div>
        <p>{c.servicesP}</p>
      </div>
      <div class="bento">
        {
          services.map((s) => (
            <article class:list={['tile', tileClass[s.id]]} id={s.id} data-glow>
              <header class="tile-head">
                <span class="ibox">
                  <Icon name={s.icon} size={22} />
                </span>
                <span class="tag">{GROUP_LABEL[lang][s.group]}</span>
                <h3>{s.name}</h3>
                <p>{s.short}</p>
                <a class="tile-more" href={serviceHref(s, lang)}>
                  {t.seeMore} <Icon name="arrow" size={15} />
                </a>
              </header>
              <ServiceMock id={s.id} lang={lang} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pains" aria-labelledby="pains-h">
    <div class="dark-card">
      <div class="pains-compact">
        <div class="pains-top">
          <div>
            <p class="chip on-dark"><Icon name="chat" size={14} />{c.painsChip}</p>
            <h2 id="pains-h" class="grad-dark">{t.soundsFamiliar}</h2>
          </div>
          <a class="btn-glass" href={r('contact', lang)}><span>{c.talk}</span><Icon name="arrow" size={16} /></a>
        </div>
        <ul class="pain-grid">
          {
            services.map((s) => (
              <li>
                <a href={serviceHref(s, lang)} data-glow>
                  <q>{s.pain}</q>
                  <span class="pain-svc">
                    {s.name}
                    <Icon name="arrow" size={14} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</V2>
