---
import V2 from '../../layouts/V2.astro';
import Icon from '../../components/mock/Icon.astro';
import ServiceMock from '../../components/v2/ServiceMock.astro';
import { GROUP_LABEL, byId, relatedOf, serviceHref, type Lang, type Service } from '../../data/v2/services';
import { SITE_URL, UI, r } from '../../data/v2/ui';

interface Props {
  s: Service;
  lang: Lang;
}
const { s, lang } = Astro.props;
const t = UI[lang];
const other = byId(s.id, lang === 'et' ? 'en' : 'et')!;
const alternates = lang === 'et' ? { et: serviceHref(s, 'et'), en: serviceHref(other, 'en') } : { et: serviceHref(other, 'et'), en: serviceHref(s, 'en') };
const related = relatedOf(s, lang);
const url = new URL(serviceHref(s, lang), SITE_URL).href;
const quoteHref = `${r('contact', lang)}?t=${s.id}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.name,
    description: s.metaDescription,
    url,
    inLanguage: lang,
    areaServed: { '@type': 'Country', name: 'Estonia' },
    provider: { '@id': `${SITE_URL}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(r('home', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: t.services, item: new URL(r('services', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: s.name, item: url },
    ],
  },
];
---

<V2 lang={lang} title={s.metaTitle} description={s.metaDescription} alternates={alternates} jsonLd={jsonLd}>
  <section class="stage">
    <div class="stage-card sv-card">
      <canvas class="stage-gl sv-gl" data-gl aria-hidden="true"></canvas>
      <div class="sv-shade" aria-hidden="true"></div>
      <div class="sv-grid">
        <div class="sv-copy">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={r('home', lang)}>{t.home}</a><span>/</span><a href={r('services', lang)}>{t.services}</a><span>/</span><span aria-current="page">{s.name}</span>
          </nav>
          <p class="chip on-dark"><Icon name={s.icon} size={14} />{GROUP_LABEL[lang][s.group]} · {s.name}</p>
          <h1 class="sv-h1">{s.h1}</h1>
          <p class="sv-lead">{s.lead}</p>
          <div class="sv-ctas">
            <a class="cta-glow" href={quoteHref}><span class="box"><Icon name="arrow" size={16} /></span>{t.askPrice}</a>
            <a class="btn-glass" href="#sisu"><span>{t.whatYouGet}</span><Icon name="arrow" size={16} /></a>
          </div>
          <dl class="sv-facts">
            <div><dt>{t.price}</dt><dd>{s.priceFrom ? `${t.from} ${s.priceFrom}` : t.onRequest}</dd></div>
            <div><dt>{t.timeline}</dt><dd>{s.timeline}</dd></div>
          </dl>
        </div>
        <div class="sv-visual">
          <ServiceMock id={s.id} lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="check" size={14} />{t.forYouIf}</p>
          <h2 class="grad">{t.soundsFamiliar}</h2>
        </div>
        <p class="sv-quote">„{s.pain}“</p>
      </div>
      <div class="for-grid">
        {
          s.forWho.map((f, i) => (
            <div class="for-card" data-glow>
              <span class="for-n">0{i + 1}</span>
              <p>{f}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sv-sec" id="sisu">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="stack" size={14} />{t.whatYouGet}</p>
          <h2 class="grad">{t.getEverything}</h2>
        </div>
        <p>{t.getEverythingSub}</p>
      </div>
      <div class="del-grid">
        {
          s.deliverables.map((d) => (
            <div class="del-card" data-glow>
              <span class="ibox">
                <Icon name={d.icon} size={20} />
              </span>
              <h3>{d.t}</h3>
              <p>{d.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap">
      <div class="steps-card">
        <div class="steps-head">
          <p class="chip"><Icon name="flow" size={14} />{t.howItWorks}</p>
          <p class="steps-time"><Icon name="bell" size={16} />{s.timeline}</p>
        </div>
        <ol class="steps-row">
          {
            s.steps.map((st, i) => (
              <li>
                <span class="step-dot">{i + 1}</span>
                <h3>{st.t}</h3>
                <p>{st.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="wrap pf-grid">
      <div class="price-card dark-card" data-glow>
        <p class="chip on-dark"><Icon name="doc" size={14} />{t.price}</p>
        {
          s.priceFrom ? (
            <p class="price-big">
              <small>{t.from}</small>
              {s.priceFrom}
            </p>
          ) : (
            <p class="price-big sm">{t.onRequest}</p>
          )
        }
        <p class="price-note">{s.priceNote}</p>
        <ul class="price-incl">
          {
            t.incl.map((i) => (
              <li>
                <Icon name="check" size={16} />
                {i}
              </li>
            ))
          }
        </ul>
        <a class="btn btn-light" href={quoteHref}><span>{t.askPrice}</span><Icon name="arrow" size={18} /></a>
      </div>
      <div class="faq">
        <p class="chip"><Icon name="chat" size={14} />{t.faq}</p>
        {
          s.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <span class="faq-ic">
                  <Icon name="plus" size={16} />
                </span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sv-sec sv-last">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="chip"><Icon name="plus" size={14} />{t.goesWith}</p>
          <h2 class="grad">{t.goesWithH}</h2>
        </div>
        <a class="link-arrow" href={r('services', lang)}>{t.allServices} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="rel-grid">
        {
          related.map((x) => (
            <a class="rel-card" href={serviceHref(x, lang)} data-glow>
              <span class="ibox">
                <Icon name={x.icon} size={20} />
              </span>
              <span class="tag">{GROUP_LABEL[lang][x.group]}</span>
              <h3>{x.name}</h3>
              <p>{x.short}</p>
              <span class="tile-more">
                {t.see} <Icon name="arrow" size={15} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</V2>
