---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE, UI, r } from '../data/site';
import { getService } from '../data/services';
import { getTranslation, postUrl, type Post } from '../data/blog';
import type { Lang } from '../data/types';

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = UI[lang];
const { Content } = await render(post);
const other = await getTranslation(post, lang === 'et' ? 'en' : 'et');
const alternates = {
  et: lang === 'et' ? postUrl(post) : other ? postUrl(other) : r('blog', 'et'),
  en: lang === 'en' ? postUrl(post) : other ? postUrl(other) : r('blog', 'en'),
};
const service = getService(post.data.service);
const fmt = new Intl.DateTimeFormat(lang === 'et' ? 'et-EE' : 'en-GB', { dateStyle: 'long' });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: lang,
  mainEntityOfPage: new URL(postUrl(post), SITE.url).href,
  author: { '@id': `${SITE.url}/#org` },
  publisher: { '@id': `${SITE.url}/#org` },
};
---

<Base lang={lang} title={`${post.data.title} | drealm`} description={post.data.description} alternates={alternates} jsonLd={[ld]} ogType="article">
  <article>
    <header class="container head">
      <Breadcrumbs
        items={[
          { name: t.breadcrumbHome, href: r('home', lang) },
          { name: t.nav.blog, href: r('blog', lang) },
          { name: post.data.title, href: postUrl(post) },
        ]}
      />
      <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </header>
    <div class="container body">
      <div class="prose"><Content /></div>
    </div>
  </article>
  {
    service && (
      <section class="section section--alt">
        <div class="container">
          <div class="section-head">
            <h2>{t.related}</h2>
          </div>
          <ServiceGrid lang={lang} items={[service]} />
        </div>
      </section>
    )
  }
  <CtaSection lang={lang} preselect={post.data.service} />
</Base>

<style>
  .head {
    padding-top: clamp(32px, 5vw, 56px);
    max-width: 900px;
  }
  time {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .lead {
    margin: 1.6rem 0 0;
  }
  .body {
    max-width: 900px;
    padding-top: clamp(40px, 5vw, 64px);
    padding-bottom: var(--section);
  }
</style>
