---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import { ROUTES, UI, r } from '../data/site';
import { getPosts, postUrl } from '../data/blog';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const posts = await getPosts(lang);
const copy = {
  et: {
    title: 'Blogi: kodulehed, SEO ja AI ettevõttele | drealm',
    description: 'Praktilised juhendid kodulehe hinna, arendusprojekti veebilehtede, SEO ja AI-automatiseerimise kohta. Kirjutatud ettevõtjatele, mitte arendajatele.',
    h1: 'Juhendid ja <em>mõtted</em>',
    lead: 'Praktilised artiklid ettevõtjatele: mida veebilehelt oodata, mis see maksab ja kuidas AI päriselt aitab.',
  },
  en: {
    title: 'Blog: Websites, SEO & AI for Business | drealm',
    description: 'Practical guides on website costs, property development websites, SEO and AI automation. Written for business owners, not developers.',
    h1: 'Guides and <em>insights</em>',
    lead: 'Practical articles for business owners: what to expect from a website, what it costs and how AI can really help.',
  },
}[lang];
const fmt = new Intl.DateTimeFormat(lang === 'et' ? 'et-EE' : 'en-GB', { dateStyle: 'long' });
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={{ et: ROUTES.blog.et, en: ROUTES.blog.en }}>
  <PageHero
    eyebrow={t.nav.blog}
    title={copy.h1}
    lead={copy.lead}
    crumbs={[
      { name: t.breadcrumbHome, href: r('home', lang) },
      { name: t.nav.blog, href: r('blog', lang) },
    ]}
  />
  <section class="section section--alt">
    <div class="container">
      <ul class="posts">
        {
          posts.map((p) => (
            <li class="reveal">
              <a href={postUrl(p)}>
                <time datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
                <span class="go">{t.readMore} →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaSection lang={lang} />
</Base>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts a {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    grid-template-areas: 'date title go' 'date desc go';
    gap: 0.5rem 2rem;
    padding: 2.2rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  time {
    grid-area: date;
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 0.4rem;
  }
  h2 {
    grid-area: title;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    transition: color 0.3s;
  }
  p {
    grid-area: desc;
    color: var(--muted);
    max-width: 40rem;
    margin: 0;
  }
  .go {
    grid-area: go;
    align-self: center;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  a:hover h2 {
    color: var(--clay);
  }
  @media (max-width: 760px) {
    .posts a {
      grid-template-columns: 1fr;
      grid-template-areas: 'date' 'title' 'desc' 'go';
    }
    .go {
      justify-self: start;
      margin-top: 0.6rem;
    }
  }
</style>
