---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import CtaSection from '../components/CtaSection.astro';
import { ROUTES, UI, r } from '../data/site';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const copy = {
  et: {
    title: 'Meist: Tallinna veebi- ja AI-stuudio | drealm',
    description: 'drealm on Tallinnas tegutsev veebistuudio, mis teeb kiireid kodulehti, kinnisvaraplatvorme ja AI-lahendusi. Tutvu meie põhimõtete ja töökorraldusega.',
    h1: 'Väike stuudio, <em>suur hoolivus</em>',
    lead: 'drealm on Tallinnas tegutsev veebistuudio. Teeme vähem projekte korraga, et igaüks saaks täie tähelepanu — alates esimesest kõnest kuni lehe avaldamise ja kasvuni.',
    valuesTitle: 'Mida me usume',
    values: [
      { t: 'Veebileht on tööriist, mitte visiitkaart', d: 'Ilus leht, mis ei too päringuid, ei ole hea leht. Iga disainiotsus teenib üht eesmärki: et külastaja saaks kliendiks.' },
      { t: 'Kiirus on austus', d: 'Iga sekund laadimisaega maksab külastajaid. Ehitame kaasaegse tehnoloogiaga (Astro, Vercel), mis teeb lehed välkkiireks.' },
      { t: 'Ausus enne müüki', d: 'Kui sul pole meie teenust vaja või lihtsam lahendus sobib paremini, ütleme seda otse. Pikaajaline usaldus on väärtuslikum kui üks projekt.' },
      { t: 'Tehnoloogia, mis kuulub sulle', d: 'Kood, domeen ja sisu on sinu omad. Ei mingit lukustust ega peidetud tasusid.' },
    ],
  },
  en: {
    title: 'About: Web & AI Studio in Tallinn | drealm',
    description: 'drealm is a Tallinn-based web studio building fast websites, real estate platforms and AI solutions. Learn about our principles and how we work.',
    h1: 'A small studio <em>that cares</em>',
    lead: 'drealm is a web studio based in Tallinn, Estonia. We take on fewer projects at a time so each one gets full attention — from the first call to launch and beyond.',
    valuesTitle: 'What we believe',
    values: [
      { t: 'A website is a tool, not a business card', d: 'A beautiful site that brings in no enquiries is not a good site. Every design decision serves one goal: turning visitors into clients.' },
      { t: 'Speed is respect', d: 'Every second of load time costs visitors. We build with modern technology (Astro, Vercel) that makes sites lightning fast.' },
      { t: 'Honesty before sales', d: 'If you do not need our service, or a simpler solution would fit better, we will tell you. Long-term trust is worth more than one project.' },
      { t: 'Technology you own', d: 'The code, domain and content are yours. No lock-in and no hidden fees.' },
    ],
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={{ et: ROUTES.about.et, en: ROUTES.about.en }}>
  <PageHero
    eyebrow={t.nav.about}
    title={copy.h1}
    lead={copy.lead}
    crumbs={[
      { name: t.breadcrumbHome, href: r('home', lang) },
      { name: t.nav.about, href: r('about', lang) },
    ]}
  />
  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal"><h2>{copy.valuesTitle}</h2></div>
      <ul class="values">
        {
          copy.values.map((v, i) => (
            <li class="reveal">
              <span class="n">0{i + 1}</span>
              <div>
                <h3>{v.t}</h3>
                <p>{v.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <Process lang={lang} />
  <CtaSection lang={lang} />
</Base>

<style>
  .values {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .values li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .n {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--clay);
    font-size: 1.3rem;
  }
  .values h3 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    margin-bottom: 0.6rem;
  }
  .values p {
    color: var(--muted);
    max-width: 40rem;
    margin: 0;
  }
</style>
