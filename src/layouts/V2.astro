---
// drealm v2 layout: rust/3D design system, floating nav, 3D footer CTA. Estonian + English.
import '../styles/v2.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/mock/Icon.astro';
import AuditForm from '../components/AuditForm.astro';
import { GROUP_LABEL, servicesFor, serviceHref, type Lang } from '../data/v2/services';
import { BRAND, COMPANY, EMAIL, GA_ID, PHONES, SITE_URL, UI, r } from '../data/v2/ui';
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** this page's path in each language */
  alternates: { et: string; en: string };
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** page-specific share image (absolute URL, 1200×630); defaults to /og.png */
  ogImage?: { src: string; alt: string };
  noindex?: boolean;
}
const { lang, title, description, alternates, jsonLd = [], ogType = 'website', noindex = false, ogImage } = Astro.props;
const og = ogImage ?? { src: `${SITE_URL}/og.png`, alt: 'drealm' };
const t = UI[lang];
const path = alternates[lang];
const canonical = new URL(path, SITE_URL).href;
const services = servicesFor(lang);
const groups = ['Veeb', 'Turundus', 'AI'] as const;
const other: Lang = lang === 'et' ? 'en' : 'et';

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#org`,
  name: BRAND,
  alternateName: ['drealm', COMPANY.legalName],
  ...(COMPANY.legalName ? { legalName: COMPANY.legalName } : {}),
  ...(COMPANY.regCode ? { identifier: { '@type': 'PropertyValue', propertyID: 'Äriregistri kood', value: COMPANY.regCode } } : {}),
  ...(COMPANY.vatNumber ? { vatID: COMPANY.vatNumber } : {}),
  ...(COMPANY.sameAs.length ? { sameAs: COMPANY.sameAs } : {}),
  url: SITE_URL,
  email: EMAIL,
  telephone: PHONES[0].label,
  contactPoint: PHONES.map((p) => ({ '@type': 'ContactPoint', contactType: 'sales', telephone: p.label, email: EMAIL, availableLanguage: ['et', 'en'] })),
  logo: `${SITE_URL}/logo.png`,
  image: `${SITE_URL}/og.png`,
  areaServed: { '@type': 'Country', name: 'Estonia' },
  knowsLanguage: ['et', 'en'],
  priceRange: '€€',
  founder: [
    { '@type': 'Person', '@id': `${SITE_URL}/meist#robin`, name: 'Robin Rattasep', url: new URL(r('about', lang), SITE_URL).href, jobTitle: lang === 'et' ? 'Asutaja, arendaja ja disainer' : 'Founder, developer and designer' },
    { '@type': 'Person', name: 'Karlos Rattasep', jobTitle: lang === 'et' ? 'Turundus ja äriarendus' : 'Marketing and business development' },
  ],
  knowsAbout: services.map((s) => s.name),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t.services,
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, url: new URL(serviceHref(s, lang), SITE_URL).href },
    })),
  },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: BRAND,
  url: SITE_URL,
  inLanguage: ['et', 'en'],
  publisher: { '@id': `${SITE_URL}/#org` },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#1b0200" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="et" href={new URL(alternates.et, SITE_URL).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, SITE_URL).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.et, SITE_URL).href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="drealm" />
    <meta property="og:locale" content={lang === 'et' ? 'et_EE' : 'en_GB'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale:alternate" content={lang === 'et' ? 'en_GB' : 'et_EE'} />
    <meta property="og:image" content={og.src} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline define:vars={{ GA_ID }}>
      // Google Analytics 4, loaded only after consent (GDPR). Choice kept in localStorage.
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      window.__gaLoad = function () {
        if (window.__ga) return;
        window.__ga = true;
        gtag('consent', 'update', { analytics_storage: 'granted' });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', GA_ID);
      };
      window.dtrack = function (name, params) { if (window.__ga) gtag('event', name, params || {}); };
      var consent = null;
      try { consent = localStorage.getItem('drealm-consent'); } catch (e) {}
      window.__consent = consent;
      if (consent === 'yes') window.__gaLoad();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body id="top">
    <a class="skip" href="#sisu-algus">{lang === 'et' ? 'Liigu sisu juurde' : 'Skip to content'}</a>
    <header class="nav" data-nav>
      <div class="nav-in">
        <a href={r('home', lang)} class="brand" aria-label={`drealm – ${t.home}`}><Logo /></a>
        <nav class="nav-pill" aria-label={t.mainNav}>
          <div class="nav-dd" data-dd>
            <button class="nav-dd-btn" aria-expanded="false" aria-controls="dd-panel" data-dd-btn>{t.services} <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" /></svg></button>
            <div class="dd-panel" id="dd-panel">
              {
                groups.map((g) => (
                  <div class="dd-col">
                    <p>{GROUP_LABEL[lang][g]}</p>
                    {services
                      .filter((s) => s.group === g)
                      .map((s) => (
                        <a href={serviceHref(s, lang)} class:list={{ on: path === serviceHref(s, lang) }}>
                          <span class="ibox sm">
                            <Icon name={s.icon} size={16} />
                          </span>
                          {s.name}
                        </a>
                      ))}
                  </div>
                ))
              }
              <div class="dd-foot">
                <a class="dd-all" href={r('services', lang)}>{t.allServices} <Icon name="arrow" size={14} /></a>
                <a class="dd-all" href={r('solutions', lang)}>{t.allSolutions} <Icon name="arrow" size={14} /></a>
              </div>
            </div>
          </div>
          <a href={r('solutions', lang)} class:list={{ on: path.startsWith(r('solutions', lang)) }}>{t.solutions}</a>
          <a href={r('work', lang)} class:list={{ on: path.startsWith(r('work', lang)) }}>{t.work}</a>
          <a href="#ulevaade">{t.review}</a>
          <a href={r('about', lang)} class:list={{ on: path === r('about', lang) }}>{t.about}</a>
          <a href={r('blog', lang)} class:list={{ on: path.startsWith(r('blog', lang)) }}>{t.blog}</a>
          <a href={r('contact', lang)} class:list={{ on: path === r('contact', lang) }}>{t.contact}</a>
        </nav>
        <div class="nav-right">
          <span class="lang" aria-label={t.lang}>
            {lang === 'et' ? <b>ET</b> : <a href={alternates.et} hreflang="et" lang="et">ET</a>}
            {lang === 'en' ? <b>EN</b> : <a href={alternates.en} hreflang="en" lang="en">EN</a>}
          </span>
          <a class="nav-cta" href={r('contact', lang)}>{t.askPrice} <span class="box"><Icon name="arrow" size={14} /></span></a>
          <button class="nav-toggle" aria-label={t.menu} aria-expanded="false" data-nav-toggle><span></span><span></span></button>
        </div>
      </div>
      <nav class="nav-sheet" aria-label={t.mainNav}>
        <a href={r('services', lang)}>{t.services}</a>
        {services.map((s) => <a href={serviceHref(s, lang)} class="sub">{s.name}</a>)}
        <a href={r('solutions', lang)}>{t.solutions}</a>
        <a href={r('work', lang)}>{t.work}</a>
        <a href="#ulevaade">{t.review}</a>
        <a href={r('about', lang)}>{t.about}</a>
        <a href={r('blog', lang)}>{t.blog}</a>
        <a href={r('faq', lang)}>{t.faqShort}</a>
        <a href={r('contact', lang)}>{t.contact}</a>
        <a href={alternates[other]} hreflang={other}>{other === 'en' ? 'English' : 'Eesti keeles'}</a>
        <a href={r('contact', lang)} class="sheet-cta">{t.askPrice} <Icon name="arrow" size={16} /></a>
      </nav>
    </header>

    <main id="sisu-algus">
      <slot />
    </main>

    <footer class="foot" id="ulevaade">
      <div class="dark-card foot-card">
        <canvas class="stage-gl" data-gl aria-hidden="true"></canvas>
        <div class="foot-shade" aria-hidden="true"></div>
        <div class="foot-grid">
          <div>
            <p class="chip on-dark">{t.footReviewChip}</p>
            <h2>{t.footH}</h2>
            <p class="foot-sub">{t.footSub}</p>
            <p class="foot-mail">{t.footMail} <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <p class="foot-mail foot-tel">{PHONES.map((p, i) => <>{i > 0 && ' · '}<a href={`tel:${p.tel}`}>{p.label}</a></>)}</p>
          </div>
          <div class="glass-form">
            <AuditForm dark lang={lang} page={`${path}#footer`} />
          </div>
        </div>
        <div class="foot-bottom">
          <Logo />
          <nav aria-label={t.footNav}>
            <a href={r('services', lang)}>{t.services}</a>
            <a href={r('solutions', lang)}>{t.solutions}</a>
            <a href={r('work', lang)}>{t.work}</a>
            <a href={r('about', lang)}>{t.about}</a>
            <a href={r('blog', lang)}>{t.blog}</a>
            <a href={r('faq', lang)}>{t.faqShort}</a>
            <a href={r('contact', lang)}>{t.contact}</a>
            <a href={r('privacy', lang)}>{t.privacy}</a>
            <button type="button" class="foot-link" data-consent-open>{t.cookies}</button>
          </nav>
          <span>{t.rights}{COMPANY.legalName && ` · ${COMPANY.legalName}`}{COMPANY.regCode && ` · ${t.regCode} ${COMPANY.regCode}`}</span>
          <a class="to-top" href="#top">{lang === 'et' ? 'Üles' : 'Top'} <Icon name="up" size={14} /></a>
        </div>
      </div>
    </footer>

    <div class="consent" role="dialog" aria-live="polite" aria-label={t.cookies} hidden data-consent>
      <p>{t.consentText} <a href={r('privacy', lang)}>{t.consentMore}</a></p>
      <div class="consent-btns">
        <button type="button" class="consent-no" data-consent-no>{t.consentNo}</button>
        <button type="button" class="consent-yes" data-consent-yes>{t.consentYes}</button>
      </div>
    </div>

    <script>
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Consent banner + conversion clicks
      {
        const w = window as any;
        const box = document.querySelector<HTMLElement>('[data-consent]')!;
        const set = (v: 'yes' | 'no') => {
          try {
            localStorage.setItem('drealm-consent', v);
          } catch {}
          box.hidden = true;
          if (v === 'yes') w.__gaLoad();
          else if (w.__ga) location.reload();
        };
        if (!w.__consent) box.hidden = false;
        box.querySelector('[data-consent-yes]')!.addEventListener('click', () => set('yes'));
        box.querySelector('[data-consent-no]')!.addEventListener('click', () => set('no'));
        document.querySelectorAll('[data-consent-open]').forEach((b) => b.addEventListener('click', () => (box.hidden = false)));
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement).closest('a');
          if (!a) return;
          const href = a.getAttribute('href') || '';
          if (href.startsWith('mailto:')) w.dtrack?.('contact_email', { page_path: location.pathname });
          else if (/^\/(en\/contact|kontakt)/.test(href)) w.dtrack?.('quote_click', { page_path: location.pathname, link_text: a.textContent?.trim().slice(0, 60) });
        });
      }

      // Nav: sits inside the hero card, turns into a solid bar after it
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const onScroll = () => nav.classList.toggle('solid', scrollY > Math.min(innerHeight * 0.55, 420));
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav.querySelectorAll('.nav-sheet a').forEach((a) => a.addEventListener('click', () => nav.classList.remove('open')));

      // Services dropdown
      const dd = nav.querySelector<HTMLElement>('[data-dd]')!;
      const ddBtn = dd.querySelector<HTMLButtonElement>('[data-dd-btn]')!;
      let ddTimer: number | undefined;
      const setDd = (open: boolean) => {
        dd.classList.toggle('open', open);
        ddBtn.setAttribute('aria-expanded', String(open));
      };
      ddBtn.addEventListener('click', () => setDd(!dd.classList.contains('open')));
      if (matchMedia('(hover: hover)').matches) {
        dd.addEventListener('mouseenter', () => (clearTimeout(ddTimer), setDd(true)));
        dd.addEventListener('mouseleave', () => (ddTimer = window.setTimeout(() => setDd(false), 160)));
      }
      addEventListener('keydown', (e) => e.key === 'Escape' && (setDd(false), nav.classList.remove('open')));

      // 3D scenes
      const canvases = document.querySelectorAll<HTMLCanvasElement>('[data-gl]');
      if (canvases.length) {
        const load = () => import('../scripts/hero-scene').then((m) => canvases.forEach((c) => m.mountHeroScene(c)));
        'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 1500 }) : setTimeout(load, 300);
      }

      // Cursor-following glow on cards
      document.querySelectorAll<HTMLElement>('[data-glow]').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      // Free review forms
      document.querySelectorAll<HTMLFormElement>('[data-audit]').forEach((form) => {
        form.querySelector<HTMLInputElement>('[data-ts]')!.value = String(Date.now());
        const status = form.querySelector('.audit-status')!;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const btn = form.querySelector('button')!;
          btn.disabled = true;
          try {
            const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
            if (!res.ok) throw new Error();
            form.reset();
            status.textContent = form.dataset.ok!;
            (window as any).dtrack?.('generate_lead', { form_type: 'audit', page_path: location.pathname });
          } catch {
            status.textContent = form.dataset.fail!;
          } finally {
            btn.disabled = false;
          }
        });
      });

      // Design view tabs
      document.querySelectorAll<HTMLButtonElement>('.seg [data-view]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const root = tab.closest('.vis')!;
          root.querySelectorAll('.seg [data-view]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          root.querySelectorAll<HTMLElement>('.view').forEach((v) => v.classList.toggle('is-active', v.dataset.view === tab.dataset.view));
        });
      });

      // Floor plan <-> table highlight
      document.querySelectorAll('.re').forEach((re) => {
        re.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
          const on = (v: boolean) => re.querySelectorAll(`[data-unit="${el.dataset.unit}"]`).forEach((x) => x.classList.toggle('hl', v));
          el.addEventListener('mouseenter', () => on(true));
          el.addEventListener('mouseleave', () => on(false));
        });
      });

      // FAQ accordions: only one open at a time
      document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((d, _, all) => {
        d.addEventListener('toggle', () => d.open && all.forEach((o) => o !== d && (o.open = false)));
      });

      // AI flow + video scenes step through in sequence
      const flows = document.querySelectorAll('[data-flow]');
      const scenes = document.querySelectorAll('.scenes');
      if (!reduceMotion) {
        let step = 0;
        setInterval(() => {
          flows.forEach((f) => f.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => s.classList.toggle('lit', Number(s.dataset.step) <= step)));
          scenes.forEach((list) => list.querySelectorAll('li').forEach((s, i) => s.classList.toggle('on', i === step)));
          step = (step + 1) % 4;
        }, 1100);
      } else {
        flows.forEach((f) => f.querySelectorAll('[data-step]').forEach((s) => s.classList.add('lit')));
      }
    </script>
  </body>
</html>
