# drealm.ee – Zone (Apache)
Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On

# https + ilma www-ta
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://drealm.ee%{REQUEST_URI} [R=301,L]

# --- 2026-10 uus sait: vanad aadressid → uued (301) ---
RewriteRule ^uus/?$ / [R=301,L]
RewriteRule ^uus/(.+)$ /$1 [R=301,L]
RewriteRule ^kodulehe-tegemine/?$ /teenused/veebilehed/kodulehe-tegemine [R=301,L]
RewriteRule ^e-poe-tegemine/?$ /teenused/veebilehed/e-poe-tegemine [R=301,L]
RewriteRule ^maandumisleht/?$ /teenused/veebilehed/maandumisleht [R=301,L]
RewriteRule ^kodulehe-uuendamine/?$ /teenused/veebilehed/kodulehe-uuendamine [R=301,L]
RewriteRule ^(restorani-koduleht|ehitusettevotte-koduleht|ilusalongi-koduleht)/?$ /lahendused/$1 [R=301,L]
RewriteRule ^arendusprojekti-koduleht/?$ /teenused/platvormid/kinnisvaraarenduse-koduleht [R=301,L]
RewriteRule ^kinnisvara-koduleht/?$ /teenused/platvormid/kinnisvara-maakleri-koduleht [R=301,L]
RewriteRule ^veebirakenduse-arendus/?$ /teenused/platvormid/veebirakendus [R=301,L]
RewriteRule ^ai-automatiseerimine/?$ /teenused/ai-automatiseerimine [R=301,L]
RewriteRule ^ai-kinnisvarale/?$ /lahendused/ai-kinnisvarale [R=301,L]
RewriteRule ^ai-chatbot/?$ /teenused/ettevotte-ai/ai-klienditeenindaja [R=301,L]
RewriteRule ^hinnad/?$ /teenused [R=301,L]
RewriteRule ^(tood|tood/marmi-futerno)/?$ / [R=301,L]
RewriteRule ^en/website-development/?$ /en/services/website-development/business-websites [R=301,L]
RewriteRule ^en/ecommerce-development/?$ /en/services/website-development/online-stores [R=301,L]
RewriteRule ^en/landing-page/?$ /en/services/website-development/landing-pages [R=301,L]
RewriteRule ^en/website-redesign/?$ /en/services/website-development/website-redesign [R=301,L]
RewriteRule ^en/(restaurant-website|construction-company-website|beauty-salon-website)/?$ /en/solutions/$1 [R=301,L]
RewriteRule ^en/property-development-website/?$ /en/services/platforms/property-development-websites [R=301,L]
RewriteRule ^en/real-estate-website/?$ /en/services/platforms/real-estate-agent-websites [R=301,L]
RewriteRule ^en/web-app-development/?$ /en/services/platforms/web-applications [R=301,L]
RewriteRule ^en/ai-automation/?$ /en/services/ai-automation [R=301,L]
RewriteRule ^en/ai-for-real-estate/?$ /en/solutions/ai-for-real-estate [R=301,L]
RewriteRule ^en/ai-chatbot/?$ /en/services/company-ai/ai-customer-assistant [R=301,L]
RewriteRule ^en/pricing/?$ /en/services [R=301,L]
RewriteRule ^en/(work|work/marmi-futerno)/?$ /en [R=301,L]

# /leht.html ja /leht/ → /leht
RewriteCond %{THE_REQUEST} \s/([^?\s]*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /leht → leht.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# seadistusfail pole veebist loetav
<Files "config.php">
  Require all denied
</Files>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^_astro/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# turvapäised
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>
